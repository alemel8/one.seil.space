# one.seil.space configuration
# Zkopíruj jako .env a vyplň. .env nikdy necommituj do gitu.

# ── Server ────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Nastav na true jen pokud běžíš za HTTPS (Coolify/produkce)
COOKIE_SECURE=false

# Session secret — musí mít alespoň 32 znaků
SESSION_SECRET=change-this-to-a-random-32char-secret-in-production

# ── Databáze (PostgreSQL) ─────────────────────────────────────
# Produkce (VPS databáze seil):
DATABASE_URL=postgresql://seil:HESLO@89.221.219.220:5432/seil
# SSL pro vzdálené spojení (nastav true pokud PG vyžaduje SSL):
DATABASE_SSL=false

# ── Monitoring (VPS stats collector) ─────────────────────────
STATS_DIR=/var/lib/vps-stats
TZ=Europe/Prague
LOG_LEVEL=info

# ── Toneráček e-shop ──────────────────────────────────────────
# API klíč pro příjem objednávek přes /api/toneracek/* (Bearer token)
TONERACEK_API_KEY=XXXXXXXXXXXXXXXX

# ── E-mail (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXX

# DOČASNÉ, jen na dobu ladění: skrytá kopie každého e-mailu, který jde
# zákazníkovi e-shopu (faktura, zálohovka, storno, upomínka). Prázdná hodnota
# = vypnuto. Firemní pošty SEILu se to netýká.
# Táž proměnná musí být i u e-shopu. Po odladění smazat — chodí do ní osobní
# údaje zákazníků včetně faktur.
EMAIL_BCC=

# Odesílatel firemní pošty (faktury mimo e-shop, upomínky B2B). Doména musí být
# ověřená v Resendu, jinak e-maily neprojdou.
#
# Zákaznické e-maily e-shopů se odsud NEBEROU — ty mají odesílatele v tabulce
# `shops` (Nastavení → Eshopy → Identita e-mailů). Zákazník e-shopu nesmí
# dostat zprávu od SEIL s.r.o.; hlídá to CHECK v migraci 030 i kontrola
# v src/email.js.
MAIL_FROM=SEIL s.r.o. <noreply@seil.cz>

# Kam mají chodit odpovědi klientů — z noreply schránky se neodpovídá.
# Když se nevyplní, použije se e-mail z nastavení firmy.
MAIL_REPLY_TO=obchod@seil.cz

# Přechodový přepínač pro nasazení. Dokud není 1, posílá Seil při přijetí
# objednávky placené převodem zálohovou fakturu e-mailem tak jako dřív.
# Po nasazení e-shopu, který platební údaje umí vykreslit sám (jeden e-mail
# místo tří), se zapne a tahle větev se pak z kódu smaže.
SHOP_SENDS_PAYMENT_EMAIL=0

# ── Push notifikace (Web Push / VAPID) ───────────────────────
# Vygeneruj: node -e "import('web-push').then(wp => { const k = wp.default.generateVAPIDKeys(); console.log(k); })"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:info@seil.cz

# ── Migrace z Airtable (jednorázově, viz scripts/migrate-airtable-hr.js) ──
# Personal Access Token z https://airtable.com/create/tokens
# Potřebuje právo data.records:read a přístup k oběma základnám.
AIRTABLE_API_KEY=
AIRTABLE_BASE_TROJEK=appnJF71iCU3ymc5N
# Katalog Toneráčku — potřebuje jen jednorázový skript, který doplňuje kódy
# dodavatele k objednávkám přijatým před nasazením expedice do skladu
# (scripts/doplnit-kody-dodavatele.js).
AIRTABLE_BASE_TONERACEK=appCbWGm1qExXCRqQ
AIRTABLE_BASE_SEIL=appBpZ7LP2SvW7tHe
# E-mail uživatele, kterému patří základna „Lukáš Trojek"
AIRTABLE_TROJEK_EMAIL=

# ── Zásilkovna / Packeta ─────────────────────────────────────
# Heslo k API Packety (tatáž hodnota jako ZASILKOVNA_API_PASSWORD v e-shopu).
# Bez něj vrací stahování štítku 502 „PACKETA_API_PASSWORD není nastaveno"
# a ranní expedice do skladu objednávky jen zadrží — štítek nemá kde vzít.
PACKETA_API_PASSWORD=

# ── Volání zpět do e-shopu ───────────────────────────────────
# Tajemství pro strojová volání na e-shop Toneráčku, musí se shodovat
# s WEBHOOK_SECRET u jeho e-shopu. Používá se k podání balíku, až je zálohovka
# zaplacená; bez něj se balík u převodu nepodá a jen se to zaloguje.
# Další e-shopy mají vlastní tajemství (Nastavení → Eshopy → Napojení
# e-shopu) a tohle nikdy nedostanou.
# Totéž platí pro ranní expedici do skladu: bez tajemství zůstane zaplacená
# objednávka bez zásilky a expedice ji zadrží do příštího rána.
SHOP_WEBHOOK_SECRET=
