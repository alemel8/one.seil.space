<%
  const fmtD = d => d ? new Date(d).toLocaleDateString('cs-CZ') : '–';
  const fmtDT = d => d ? new Date(d).toLocaleString('cs-CZ') : '–';
  const statusColor = s => ({
    'Aktivní':      ['var(--success-bg)', '#166534'],
    'Pozastaveno':  ['var(--warning-bg)', '#92400e'],
    'Dokončeno':    ['var(--info-bg)',    '#1e40af'],
    'V přípravě':   ['var(--gray-100)',   'var(--gray-600)'],
  }[s] || ['var(--gray-100)', 'var(--gray-600)']);
  const sc = statusColor(item.status);
  const meta = PROJECT_TYPES[item.type] || { label: item.type, icon: 'web.svg', color: 'var(--text-muted)' };
  // Režim úprav (src/upravy.js): jeden formulář záznamu, bez JS otevře úpravy ?upravit=1.
  const formular = 'formPodprojekt';
  const rezim = rezimUprav ? 'upravy' : 'zobrazeni';
  const urlZpet = `/projekty/podprojekty/${item.id}`;
%>

<div class="detail" data-rezim="<%= rezim %>">
<div class="page-header">
  <div class="page-header-left">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
      <a href="/projekty/<%= item.project_id %>?tab=podprojekty" class="btn btn-ghost btn-sm">← <%= item.project_name %></a>
      <span class="project-type-swatch" style="background:<%= meta.color %>22;">
        <span class="project-type-icon" style="--icon-url:url(/static/img/project-types/<%= meta.icon %>);--icon-color:<%= meta.color %>;"></span>
      </span>
      <h1 style="margin:0;"><%= item.name %></h1>
      <span class="badge" style="background:<%= sc[0] %>;color:<%= sc[1] %>;"><%= item.status %></span>
    </div>
    <p><%= meta.label %> · Klient: <a href="/crm/firmy/<%= item.company_id %>" style="color:var(--primary);"><%= item.company_name %></a></p>
  </div>
  <div class="page-header-akce">
    <form method="post" action="/projekty/podprojekty/<%= item.id %>/smazat" onsubmit="return confirm('Smazat tento podprojekt?');" style="display:inline;">
      <button type="submit" class="btn btn-outline" style="color:var(--danger);">Smazat</button>
    </form>
    <%- include('../../includes/upravit', { formular, urlUpravit: '?upravit=1', urlZpet }) %>
  </div>
</div>

<% if (saved) { %>
<div class="jen-zobrazeni" style="background:var(--success-bg);color:#166534;border:1px solid #bbf7d0;padding:10px 16px;border-radius:8px;margin-bottom:16px;">✓ Uloženo</div>
<% } %>

<form method="post" action="/projekty/podprojekty/<%= item.id %>" id="formPodprojekt" class="upravitelne">
<div style="display:grid;grid-template-columns:2fr 1fr;gap:24px;align-items:start;">
  <div style="display:flex;flex-direction:column;gap:16px;">

    <div class="card">
      <div class="card-header"><strong>Popis</strong></div>
      <div class="card-body">
        <%- include('../../includes/pole', { pole: { label: 'Popis', name: 'description', typ: 'textarea', rows: 3, value: item.description, skrytyPopisek: true, placeholder: 'Co tento podprojekt zahrnuje…' } }) %>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><strong>Provoz</strong></div>
      <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <%# Název a stav jsou v zobrazení v hlavičce stránky, napojení ukazují karty vpravo – v kartě jen při úpravách. %>
        <%- include('../../includes/pole', { pole: { label: 'Název', name: 'name', value: item.name, required: true, trida: 'jen-upravy' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Stav', name: 'status', typ: 'select', value: item.status, moznosti: ITEM_STATUSES, trida: 'jen-upravy' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Kde to běží', name: 'hosting_provider', value: item.hosting_provider, placeholder: 'např. Coolify – VPS #1', styl: 'grid-column:1/-1' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Produkce', name: 'production_url', typ: 'url', value: item.production_url, placeholder: 'https://…' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Staging', name: 'staging_url', typ: 'url', value: item.staging_url, placeholder: 'https://staging…' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Repozitář', name: 'repo_url', typ: 'url', value: item.repo_url, placeholder: 'https://github.com/…' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Tech stack', name: 'tech_stack', value: item.tech_stack, placeholder: 'Node.js, PostgreSQL…' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Datum spuštění', name: 'go_live_date', typ: 'date', value: item.go_live_date } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Napojený eshop', name: 'shop_id', typ: 'select', value: item.shop_id,
          moznosti: shops.map(s => [s.id, s.name]), prazdna: '– žádný –', trida: 'jen-upravy' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Napojený healthcheck', name: 'healthcheck_id', typ: 'select', value: item.healthcheck_id,
          moznosti: healthchecks.map(h => [h.id, h.name]), prazdna: '– žádný –', trida: 'jen-upravy' } }) %>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><strong>Poznámky</strong></div>
      <div class="card-body">
        <%- include('../../includes/pole', { pole: { label: 'Poznámky', name: 'notes', typ: 'textarea', rows: 4, value: item.notes, skrytyPopisek: true } }) %>
      </div>
    </div>

    <%- include('../../includes/upravit', { paticka: true, formular, urlZpet }) %>
  </div>

  <div style="display:flex;flex-direction:column;gap:16px;">
    <!-- Monitoring panel -->
    <div class="card">
      <div class="card-header"><strong>Monitoring</strong></div>
      <div class="card-body">
        <% if (health) { %>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
            <% if (health.ok === true) { %>
              <span style="width:9px;height:9px;border-radius:50%;background:var(--success);display:inline-block;flex-shrink:0;"></span>
              <span style="font-weight:600;color:#166534;">Běží</span>
            <% } else if (health.ok === false) { %>
              <span style="width:9px;height:9px;border-radius:50%;background:var(--danger);display:inline-block;flex-shrink:0;"></span>
              <span style="font-weight:600;color:var(--danger);">Nedostupné</span>
            <% } else { %>
              <span style="width:9px;height:9px;border-radius:50%;background:var(--gray-400);display:inline-block;flex-shrink:0;"></span>
              <span style="font-weight:600;color:var(--text-muted);">Zatím bez dat</span>
            <% } %>
          </div>
          <div style="font-size:13px;color:var(--text-muted);display:flex;flex-direction:column;gap:4px;">
            <div><%= health.name %></div>
            <% if (health.latency_ms) { %><div>Odezva: <%= health.latency_ms %> ms</div><% } %>
            <% if (health.checked_at) { %><div>Poslední kontrola: <%= fmtDT(health.checked_at) %></div><% } %>
            <% if (health.error) { %><div style="color:var(--danger);"><%= health.error %></div><% } %>
          </div>
          <a href="/monitoring" style="display:inline-block;margin-top:10px;font-size:12px;color:var(--primary);">Zobrazit monitoring →</a>
        <% } else { %>
          <div style="color:var(--text-muted);font-size:13px;">Bez napojeného healthchecku. Přidejte ho tužkou nahoře.</div>
        <% } %>
      </div>
    </div>

    <% if (shop) { %>
    <div class="card">
      <div class="card-header"><strong>Napojený eshop</strong></div>
      <div class="card-body" style="font-size:13px;">
        <div style="font-weight:600;margin-bottom:4px;"><%= shop.name %></div>
        <% if (shop.url) { %><a href="<%= shop.url %>" target="_blank" style="color:var(--primary);"><%= shop.url %></a><% } %>
      </div>
    </div>
    <% } %>

    <div class="card">
      <div class="card-header"><strong>Záznam</strong></div>
      <div class="card-body" style="font-size:13px;display:flex;flex-direction:column;gap:12px;">
        <div>
          <div style="color:var(--text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Vytvořeno</div>
          <div><%= fmtD(item.created_at) %></div>
        </div>
        <div>
          <div style="color:var(--text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Naposledy upraveno</div>
          <div><%= fmtD(item.modified_at) %></div>
        </div>
      </div>
    </div>
  </div>
</div>
</form>
</div>
