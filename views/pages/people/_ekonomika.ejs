<%
  // Datové záložky osobního účtu. Oddělený soubor, aby member-detail.ejs
  // nenarostl do nečitelna – obsah je řízený stejným ?tab= jako zbytek.
  const kc  = n => Number(n || 0).toLocaleString('cs-CZ', { maximumFractionDigits: 0 });
  const kc2 = n => Number(n || 0).toLocaleString('cs-CZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const den = d => ceskeDatum(d) || '–';
  // Sloupce DATE chodí jako půlnoc UTC, měsíc se čte v UTC nezávisle na pásmu procesu.
  const mesic = d => d ? new Date(d).toLocaleDateString('cs-CZ', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : '–';
%>

<% if (currentTab === 'ekonomika') { %>
  <%
    // Zůstatek má smysl jen tam, kde je proti výplatám i příjmová strana.
    // U dohodáře žádné fakturační podklady nejsou a rozdíl by byl jen
    // záporným součtem výplat – číslo, které nic neříká. Místo něj se
    // ukazuje odpracovaný čas a odměna, ze které mzda vznikla.
    const maPodklady = ucet.prijmyPocet > 0;
  %>
  <div class="kpi-grid" style="margin-bottom:24px;">
    <% if (maPodklady) { %>
    <div class="kpi-card">
      <div class="kpi-label">Příjmy</div>
      <div class="kpi-value positive" style="font-size:20px;"><%= kc2(ucet.prijmy) %></div>
      <div class="kpi-formula"><%= ucet.prijmyPocet %> fakturačních podkladů</div>
    </div>
    <% } else { %>
    <div class="kpi-card">
      <div class="kpi-label">Odpracováno</div>
      <div class="kpi-value" style="font-size:20px;"><%= kc2(ucet.hodiny) %> h</div>
      <div class="kpi-formula">odměna <%= kc(ucet.odmena) %> Kč</div>
    </div>
    <% } %>
    <div class="kpi-card">
      <div class="kpi-label">Výdaje</div>
      <div class="kpi-value negative" style="font-size:20px;"><%= kc2(ucet.vydaje) %></div>
      <div class="kpi-formula"><%= ucet.vydajePocet %> mezd · co odešlo z účtu</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Platby mimo mzdu</div>
      <div class="kpi-value negative" style="font-size:20px;"><%= kc2(ucet.ostatni) %></div>
      <div class="kpi-formula"><%= ucet.ostatniPocet %> plateb · zálohy a nákupy</div>
    </div>
    <% if (maPodklady) { %>
    <div class="kpi-card">
      <div class="kpi-label">Zůstatek</div>
      <div class="kpi-value <%= ucet.zustatek >= 0 ? 'positive' : 'negative' %>" style="font-size:20px;"><%= kc2(ucet.zustatek) %></div>
      <div class="kpi-formula">příjmy − výdaje − platby</div>
    </div>
    <% } else { %>
    <div class="kpi-card">
      <div class="kpi-label">Náklad firmy</div>
      <div class="kpi-value negative" style="font-size:20px;"><%= kc2(ucet.nakladFirmy + ucet.ostatni) %></div>
      <div class="kpi-formula">mzdy + platby mimo mzdu</div>
    </div>
    <% } %>
  </div>

  <% if (ucet.nakladFirmy && Math.abs(ucet.nakladFirmy - ucet.vydaje) > 0.5) { %>
  <div style="background:var(--info-bg);color:var(--info);border-radius:8px;padding:10px 16px;margin-bottom:24px;font-size:13px;">
    Do nákladů firmy a hrubého zisku vstupuje jiné číslo – <strong><%= kc2(ucet.nakladFirmy) %> Kč</strong>
    (hrubá mzda plus odvody zaměstnavatele). Zůstatek nahoře počítá s tím, co reálně odešlo z účtu.
  </div>
  <% } %>

  <div class="card">
    <div class="card-header"><h2 style="font-size:15px;font-weight:600;margin:0;">Poslední pohyby</h2></div>
    <div class="table-wrapper" style="border:none;border-radius:0;">
      <table class="data-table" style="min-width:0;">
        <thead><tr><th>Datum</th><th class="hide-mobile">Typ</th><th>Popis</th><th class="num">Částka</th></tr></thead>
        <tbody>
          <% if (!pohyby.length) { %>
            <tr><td colspan="4"><div class="prazdno"><strong>Zatím žádné pohyby</strong></div></td></tr>
          <% } %>
          <% pohyby.forEach(function (p) {
               const odkaz = p.typ === 'podklad' ? '?tab=podklady'
                           : p.typ === 'mzda'    ? '?tab=mzdy' : '?tab=vydaje';
          %>
          <tr data-href="<%= odkaz %>">
            <td class="mono"><a href="<%= odkaz %>" class="radek-odkaz"><%= den(p.datum) %></a></td>
            <td class="hide-mobile">
              <span class="badge <%= p.typ === 'podklad' ? 'badge-ok' : 'badge-neutral' %>">
                <%= p.typ === 'podklad' ? 'Podklad' : p.typ === 'mzda' ? 'Mzda' : 'Platba' %>
              </span>
            </td>
            <td><span class="radek-text" title="<%= p.popis %>"><%= p.popis %></span></td>
            <td class="num" style="color:<%= p.castka >= 0 ? 'var(--ton-ok-text)' : 'var(--ton-chyba-text)' %>;">
              <%= p.castka >= 0 ? '+' : '' %><%= kc2(p.castka) %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<% if (currentTab === 'podklady') { %>
  <div class="card">
    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;">
      <h2 style="font-size:15px;font-weight:600;margin:0;">Fakturační podklady</h2>
      <span style="font-size:13px;color:var(--text-secondary);font-weight:400;">celkem <%= kc2(ucet.prijmy) %> Kč bez storna</span>
    </div>
    <div class="table-wrapper" style="border:none;border-radius:0;">
      <table class="data-table" style="min-width:0;">
        <thead><tr><th>Datum</th><th>Zakázka</th><th class="hide-mobile">Lokalita</th><th class="hide-mobile">Přílohy</th><th>Faktura</th><th class="mobil">Stav</th><th class="num mobil">Částka</th></tr></thead>
        <tbody>
          <% if (!podklady.length) { %>
            <tr><td colspan="7"><div class="prazdno"><strong>Zatím žádné podklady</strong></div></td></tr>
          <% } %>
          <% podklady.forEach(function (w) { const lokality = (w.lokality || []).join(', '); %>
          <tr data-href="/lide/podklady/<%= w.id %>">
            <td class="mono"><a href="/lide/podklady/<%= w.id %>" class="radek-odkaz"><%= den(w.report_date) %></a></td>
            <td class="mono" style="white-space:normal;"><% (w.kody || []).forEach((k, i) => { %><span style="white-space:nowrap;"><%= k %><%= i < w.kody.length - 1 ? ',' : '' %></span> <% }) %><% if (!(w.kody || []).length) { %>–<% } %></td>
            <td class="sekundarni hide-mobile"><span class="radek-text" title="<%= lokality %>"><%= lokality || '–' %></span></td>
            <td class="sekundarni hide-mobile" style="white-space:nowrap;">
              <% if (w.priloh_rozpis) { %>📄 <%= w.priloh_rozpis %><% } %>
              <% if (w.priloh_doklady) { %> &nbsp;🧾 <%= w.priloh_doklady %><% } %>
              <% if (!w.priloh_rozpis && !w.priloh_doklady) { %>–<% } %>
            </td>
            <td class="sekundarni" style="white-space:nowrap;">
              <% if (w.invoice_id) { %>
                <a href="/ucetnictvi/vydane-faktury/<%= w.invoice_id %>" style="color:var(--link);text-decoration:none;"><%= w.faktura_cislo %></a>
                · <%= w.faktura_stav %>
              <% } else if (w.invoice_number) { %>
                <span class="pole-varovani" title="Faktura tohoto čísla není v systému"><%= w.invoice_number %> ⚠</span>
              <% } else { %>–<% } %>
            </td>
            <td class="mobil"><span class="badge badge-<%= tonStavu(w.status) %>"><%= (PODKLAD_STAVY.find(s => s[0] === w.status) || [,w.status])[1] %></span></td>
            <td class="num mobil"><%= kc2(w.total_amount) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (locals.strany) { %><%- include('../../includes/strankovani', { strany: locals.strany }) %><% } %>
  </div>
<% } %>

<% if (currentTab === 'mzdy') { %>
  <div class="card">
    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;">
      <h2 style="font-size:15px;font-weight:600;margin:0;">Mzdové listy</h2>
      <span style="font-size:13px;color:var(--text-secondary);font-weight:400;">
        uhrazeno <%= kc2(ucet.vydaje) %> Kč · náklad firmy <%= kc2(ucet.nakladFirmy) %> Kč
      </span>
    </div>
    <div class="table-wrapper" style="border:none;border-radius:0;">
      <table class="data-table" style="min-width:0;">
        <thead><tr><th>Měsíc</th><th class="num hide-mobile">Hodiny</th><th class="num hide-mobile">Hrubá</th><th class="num hide-mobile">Čistá</th><th class="num mobil">Uhrazeno</th><th class="num hide-mobile">Náklad firmy</th><th class="hide-mobile">Přílohy</th><th class="mobil">Stav</th></tr></thead>
        <tbody>
          <% if (!mzdy.length) { %>
            <tr><td colspan="8"><div class="prazdno"><strong>Zatím žádné mzdy</strong></div></td></tr>
          <% } %>
          <% mzdy.forEach(function (r) { %>
          <tr data-href="/lide/mzdy/<%= r.id %>">
            <td style="white-space:nowrap;">
              <a href="/lide/mzdy/<%= r.id %>" class="radek-odkaz"><%= mesic(r.period) %></a>
              <% if (r.mesic_ma_vic_listu) { %>
                <span class="badge badge-varovani" style="margin-left:6px;" title="Za tento měsíc je evidováno víc listů – přeneseno z Airtable, zkontrolujte">2×</span>
              <% } %>
            </td>
            <td class="num hide-mobile"><%= r.hours ? Number(r.hours).toLocaleString('cs-CZ') + ' h' : '–' %></td>
            <td class="num hide-mobile"><%= kc(r.gross) %></td>
            <td class="num hide-mobile"><%= kc(r.net) %></td>
            <td class="num mobil" style="font-weight:600;"><%= kc(r.paid_total) %></td>
            <td class="num sekundarni hide-mobile"><%= kc(r.company_cost) %></td>
            <td class="sekundarni hide-mobile"><%= r.priloh ? '📎 ' + r.priloh : '–' %></td>
            <td class="mobil">
              <% if (r.paid) { %><span class="badge badge-ok">Vyplaceno</span>
              <% } else { %><span class="badge badge-varovani">Nevyplaceno</span><% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (locals.strany) { %><%- include('../../includes/strankovani', { strany: locals.strany }) %><% } %>
  </div>
<% } %>

<% if (currentTab === 'vydaje') { %>
  <div class="card">
    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;">
      <h2 style="font-size:15px;font-weight:600;margin:0;">Platby mimo mzdu</h2>
      <button class="btn btn-primary btn-sm" data-modal-open="modalPlatba">+ Přidat platbu</button>
    </div>
    <div class="table-wrapper" style="border:none;border-radius:0;">
      <table class="data-table" style="min-width:0;">
        <thead><tr><th>Datum</th><th class="hide-mobile">Druh</th><th>Popis</th><th class="hide-mobile">Doklad</th><th class="num mobil">Částka</th><th style="width:40px;" aria-label="Akce"></th></tr></thead>
        <tbody>
          <% if (!platby.length) { %>
            <tr><td colspan="6"><div class="prazdno"><strong>Zatím žádné platby mimo mzdu</strong></div></td></tr>
          <% } %>
          <% platby.forEach(function (pl) { %>
          <tr>
            <td class="mono sekundarni"><%= den(pl.paid_on) %></td>
            <td class="hide-mobile">
              <span class="badge <%= pl.kind === 'zaloha' ? 'badge-info' : 'badge-neutral' %>">
                <%= (PLATBA_DRUHY.find(d => d[0] === pl.kind) || [,pl.kind])[1] %>
              </span>
            </td>
            <td><span class="radek-text" title="<%= pl.description || '' %>"><%= pl.description || '–' %></span></td>
            <td class="sekundarni hide-mobile"><%= pl.priloh ? '📎 ' + pl.priloh : '–' %></td>
            <td class="num mobil"><%= kc2(pl.amount) %></td>
            <td>
              <form method="post" action="/lide/tym/<%= member.public_id %>/platby/<%= pl.id %>/smazat" onsubmit="return confirm('Opravdu smazat tuto platbu?');">
                <input type="hidden" name="redirect_to" value="<%= locals.strany?.aktualni %>">
                <button type="submit" class="btn btn-ghost btn-sm" title="Smazat" aria-label="Smazat platbu">🗑</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (locals.strany) { %><%- include('../../includes/strankovani', { strany: locals.strany }) %><% } %>
    <div class="card-body" style="border-top:1px solid var(--border);font-size:12.5px;color:var(--text-secondary);">
      Záloha není náklad firmy – je to pohledávka za zaměstnancem. Do nákladů a hrubého zisku
      vstupují jen proplacené náklady, proto na druhu záleží.
    </div>
  </div>

  <div class="modal-backdrop" id="modalPlatba">
    <div class="modal modal-sm">
      <div class="modal-header">
        <h2 class="modal-title">Platba mimo mzdu</h2>
        <button class="modal-close" data-modal-close="modalPlatba">✕</button>
      </div>
      <form method="post" action="/lide/tym/<%= member.public_id %>/platby/vytvorit" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="form-grid" style="grid-template-columns:1fr 1fr;gap:14px;">
            <div class="form-group">
              <label class="form-label required">Datum</label>
              <input type="date" name="paid_on" class="form-control" required value="<%= new Date().toISOString().slice(0,10) %>">
            </div>
            <div class="form-group">
              <label class="form-label required">Částka</label>
              <input type="number" step="0.01" min="0" name="amount" class="form-control" required placeholder="0,00">
            </div>
            <div class="form-group col-span-2">
              <label class="form-label">Druh</label>
              <select name="kind" class="form-select">
                <% PLATBA_DRUHY.forEach(function (d) { %><option value="<%= d[0] %>"><%= d[1] %></option><% }) %>
              </select>
            </div>
            <div class="form-group col-span-2">
              <label class="form-label">Popis</label>
              <input type="text" name="description" class="form-control" placeholder="Např. záloha, O2 tarif, tablet">
            </div>
            <div class="form-group col-span-2">
              <label class="form-label">Doklad (nepovinné)</label>
              <input type="file" name="doklad" class="form-control" accept="application/pdf,image/*">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline" data-modal-close="modalPlatba">Zrušit</button>
          <button type="submit" class="btn btn-primary">Uložit platbu</button>
        </div>
      </form>
    </div>
  </div>
<% } %>

<% if (currentTab === 'dokumenty') { %>
  <div class="card">
    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;">
      <h2 style="font-size:15px;font-weight:600;margin:0;">Osobní a smluvní dokumenty</h2>
      <button class="btn btn-primary btn-sm" data-modal-open="modalDokument">+ Přidat dokument</button>
    </div>
    <div class="table-wrapper" style="border:none;border-radius:0;">
      <table class="data-table">
        <thead><tr><th>Datum</th><th>Název</th><th>Kategorie</th><th>Soubory</th><th>Stav</th></tr></thead>
        <tbody>
          <% if (!dokumenty.length) { %>
            <tr><td colspan="5"><div class="prazdno"><strong>Zatím žádné dokumenty</strong></div></td></tr>
          <% } %>
          <% dokumenty.forEach(function (d) { %>
          <tr>
            <td style="color:var(--text-muted);font-size:13px;white-space:nowrap;"><%= den(d.document_date) %></td>
            <td><%= d.title %></td>
            <td style="font-size:13px;color:var(--text-muted);"><%= d.category || '–' %></td>
            <td style="font-size:12.5px;color:var(--text-muted);"><%= d.priloh ? '📎 ' + d.priloh : '–' %></td>
            <td>
              <% if (d.signed) { %><span class="badge badge-ok">Vyřízeno</span>
              <% } else { %><span class="badge badge-neutral">Nevyřízeno</span><% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="modal-backdrop" id="modalDokument">
    <div class="modal modal-sm">
      <div class="modal-header">
        <h2 class="modal-title">Přidat dokument</h2>
        <button class="modal-close" data-modal-close="modalDokument">✕</button>
      </div>
      <form method="post" action="/lide/tym/<%= member.public_id %>/dokumenty/vytvorit" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="form-grid" style="grid-template-columns:1fr 1fr;gap:14px;">
            <div class="form-group col-span-2">
              <label class="form-label required">Název</label>
              <input type="text" name="title" class="form-control" required placeholder="Pracovní smlouva">
            </div>
            <div class="form-group">
              <label class="form-label">Kategorie</label>
              <input type="text" name="category" class="form-control" placeholder="Mzdový výměr">
            </div>
            <div class="form-group">
              <label class="form-label">Datum</label>
              <input type="date" name="document_date" class="form-control">
            </div>
            <div class="form-group col-span-2">
              <label class="form-label">Soubor</label>
              <input type="file" name="soubor" class="form-control">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline" data-modal-close="modalDokument">Zrušit</button>
          <button type="submit" class="btn btn-primary">Uložit dokument</button>
        </div>
      </form>
    </div>
  </div>
<% } %>

<% if (currentTab === 'hodiny') { %>
  <%
    const celkem  = mesice.reduce((a, m) => a + Number(m.namereno || 0), 0);
    const veMzde  = mesice.reduce((a, m) => a + Number(m.ve_mzde  || 0), 0);
    const bezi    = mesice.reduce((a, m) => a + Number(m.bezi     || 0), 0);
    const hod = n => Number(n || 0).toLocaleString('cs-CZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  %>
  <div class="kpi-grid" style="margin-bottom:24px;">
    <div class="kpi-card">
      <div class="kpi-label">Naměřeno</div>
      <div class="kpi-value" style="font-size:20px;"><%= hod(celkem) %> h</div>
      <div class="kpi-formula"><%= mesice.reduce((a,m)=>a+Number(m.zaznamu||0),0) %> záznamů</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Ve mzdách</div>
      <div class="kpi-value" style="font-size:20px;"><%= hod(veMzde) %> h</div>
      <div class="kpi-formula">z mzdových listů</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Rozdíl</div>
      <div class="kpi-value <%= Math.abs(celkem - veMzde) < 0.01 ? '' : 'negative' %>" style="font-size:20px;"><%= hod(celkem - veMzde) %> h</div>
      <div class="kpi-formula">naměřeno − vykázáno</div>
    </div>
    <% if (bezi) { %>
    <div class="kpi-card">
      <div class="kpi-label">Běžící měření</div>
      <div class="kpi-value negative" style="font-size:20px;"><%= bezi %></div>
      <div class="kpi-formula">je potřeba dokončit</div>
    </div>
    <% } %>
  </div>

  <div class="card">
    <div class="card-header"><h2 style="font-size:15px;font-weight:600;margin:0;">Po měsících</h2></div>
    <div class="table-wrapper" style="border:none;border-radius:0;">
      <table class="data-table">
        <thead><tr>
          <th>Měsíc</th><th style="text-align:right;">Záznamů</th>
          <th style="text-align:right;">Naměřeno</th><th style="text-align:right;">Ve mzdě</th>
          <th style="text-align:right;">Rozdíl</th>
        </tr></thead>
        <tbody>
          <% if (!mesice.length) { %>
            <tr><td colspan="5"><div class="prazdno"><strong>Zatím žádná měření</strong></div></td></tr>
          <% } %>
          <% mesice.forEach(function (m) {
               const má = m.ve_mzde != null;
               const r  = má ? Number(m.namereno) - Number(m.ve_mzde) : null;
          %>
          <tr>
            <td><%= mesic(m.obdobi) %><% if (m.bezi) { %> <span class="badge" style="background:var(--danger-bg);color:var(--danger);">běží <%= m.bezi %></span><% } %></td>
            <td style="text-align:right;color:var(--text-muted);"><%= m.zaznamu %></td>
            <td style="text-align:right;font-variant-numeric:tabular-nums;"><%= hod(m.namereno) %></td>
            <td style="text-align:right;font-variant-numeric:tabular-nums;color:var(--text-muted);"><%= má ? hod(m.ve_mzde) : '–' %></td>
            <td style="text-align:right;font-variant-numeric:tabular-nums;color:<%= r == null ? 'var(--text-muted)' : Math.abs(r) < 0.01 ? 'var(--success)' : 'var(--danger)' %>;">
              <%= r == null ? '–' : (r > 0 ? '+' : '') + hod(r) %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
