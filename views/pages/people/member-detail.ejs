<%
  // Režim úprav (src/upravy.js): tužka v hlavičce jen u záložek s formulářem
  // záznamu (Detail, Bankovní účet); bez JS otevře úpravy ?upravit=1.
  const FORMULARE = { detail: 'formDetail', banka: 'formBanka' };
  const formular = FORMULARE[currentTab] || null;
  const rezim = formular && rezimUprav ? 'upravy' : 'zobrazeni';
  const urlZalozky = `?tab=${currentTab}`;
%>
<div class="detail" data-rezim="<%= rezim %>">
<div class="page-header">
  <div class="page-header-left">
    <h1><%= ((member.first_name + ' ' + member.last_name).trim() || member.email) %></h1>
    <p><%= member.position || (member.is_admin ? 'Správce' : 'Uživatel') %> · <%= member.email %></p>
  </div>
  <div class="page-header-akce">
    <a href="/lide/tym" class="btn btn-outline">← Zpět na tým</a>
    <% if (formular) { %>
    <%- include('../../includes/upravit', { formular, urlUpravit: `${urlZalozky}&upravit=1`, urlZpet: urlZalozky }) %>
    <% } %>
  </div>
</div>

<% if (saved) { %>
<div data-hlaska class="jen-zobrazeni" style="background:var(--success-bg);color:#15803D;border:1px solid #bbf7d0;border-radius:8px;padding:10px 16px;margin-bottom:20px;font-size:14px;">
  Změny byly uloženy.
</div>
<% } %>

<% if (locals.error) { %>
<div data-hlaska style="background:var(--danger-bg);color:var(--danger);padding:10px 16px;border-radius:8px;margin-bottom:20px;font-size:14px;">⚠ <%= error %></div>
<% } %>

<!-- Záhlaví profilu -->
<div class="card" style="margin-bottom:24px;">
  <div class="card-body" style="display:flex;gap:24px;align-items:flex-start;flex-wrap:wrap;padding:24px;">

    <!-- Velká fotka -->
    <div style="position:relative;flex-shrink:0;">
      <div style="width:120px;height:120px;border-radius:50%;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:36px;font-weight:700;overflow:hidden;">
        <% if (member.photo) { %>
          <img src="/media/<%= member.photo %>" alt=""
               style="width:100%;height:100%;object-fit:cover;"
               onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
          <span style="display:none;width:100%;height:100%;align-items:center;justify-content:center;"><%=
            (member.first_name || '').charAt(0).toUpperCase()
          %><%=
            (member.last_name || '').charAt(0).toUpperCase()
          %></span>
        <% } else { %>
          <%= (member.first_name || '').charAt(0).toUpperCase() %><%= (member.last_name || '').charAt(0).toUpperCase() %>
        <% } %>
      </div>

      <!-- Tlačítko Změnit fotku (admin) -->
      <% if (user && user.is_admin) { %>
      <form method="post" action="/lide/tym/<%= member.public_id %>/foto" enctype="multipart/form-data"
            style="position:absolute;bottom:0;right:0;">
        <label style="display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:var(--primary);color:#fff;cursor:pointer;border:2px solid #fff;font-size:14px;" title="Změnit fotku">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
            <circle cx="12" cy="13" r="4"/>
          </svg>
          <input type="file" name="photo" accept="image/*" style="display:none;" onchange="this.form.submit()">
        </label>
      </form>
      <% } %>
    </div>

    <!-- Info -->
    <div style="flex:1;min-width:200px;">
      <div style="font-size:22px;font-weight:700;color:var(--text-primary);margin-bottom:4px;">
        <%= ((member.first_name + ' ' + member.last_name).trim() || member.email) %>
      </div>
      <% if (member.position) { %>
      <div style="font-size:14px;color:var(--text-muted);margin-bottom:6px;"><%= member.position %></div>
      <% } %>
      <div style="font-size:13px;color:var(--text-muted);margin-bottom:12px;">
        <a href="mailto:<%= member.email %>" style="color:var(--primary)"><%= member.email %></a>
        <% if (member.phone) { %> · <%= member.phone %><% } %>
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;">
        <% if (member.is_admin) { %>
          <span class="badge" style="background:#fef9c3;color:#854d0e;">Správce</span>
        <% } else { %>
          <span class="badge" style="background:var(--info-bg);color:var(--info);">Uživatel</span>
        <% } %>
        <% if (!member.is_active) { %>
          <span class="badge" style="background:var(--danger-bg);color:#991b1b;">Neaktivní</span>
        <% } else { %>
          <span class="badge" style="background:var(--success-bg);color:#15803D;">Aktivní</span>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%
  // Serverové záložky (?tab=) místo klientského přepínání. Každá si nese
  // vlastní dotaz, takže načítat všechny naráz při otevření profilu by bylo
  // plýtvání – a jen tady jde do popisku doplnit počet.
  const zalozky = [
    ['detail',    'Detail',               true],
    ['banka',     'Bankovní účet',        true],
    ['ekonomika', 'Ekonomika',            Boolean(maData)],
    ['podklady',  `Fakturační podklady (${pocty.podklady})`, pocty.podklady > 0],
    ['mzdy',      `Mzdy (${pocty.mzdy})`, pocty.mzdy > 0],
    ['hodiny',    `Hodiny (${pocty.mereni})`, pocty.mereni > 0],
    ['vydaje',    `Platby mimo mzdu (${pocty.platby})`, true],
    ['dokumenty', `Dokumenty (${pocty.dokumenty})`, true],
    ['pristupy',  'Přístupy',             true],
  ].filter(z => z[2]);
%>
<nav class="tabs" aria-label="Sekce člena týmu">
  <% zalozky.forEach(function (z) { const key = z[0], label = z[1]; %>
  <a href="?tab=<%= key %>" class="tab<%= currentTab===key ? ' active' : '' %>"<%- currentTab===key ? ' aria-current="page"' : '' %>><%= label %></a>
  <% }) %>
</nav>

<% if (currentTab === 'detail') { %>
  <div class="card">
    <div class="card-header">
      <h2 style="font-size:15px;font-weight:600;margin:0;">Osobní údaje</h2>
    </div>
    <div class="card-body">
      <form method="post" action="/lide/tym/<%= member.public_id %>" id="formDetail" class="upravitelne" autocomplete="off">
        <input type="hidden" name="tab" value="<%= currentTab %>">
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;">
          <%- include('../../includes/pole', { pole: { label: 'Titul', name: 'title', value: member.title, placeholder: 'Ing., Mgr., …' } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Jméno', name: 'first_name', value: member.first_name, required: true } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Příjmení', name: 'last_name', value: member.last_name } }) %>
          <%- include('../../includes/pole', { pole: { label: 'E-mail', name: 'email', typ: 'email', value: member.email, required: true } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Pozice ve firmě', name: 'position', value: member.position, placeholder: 'Frontend Developer' } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Telefon', name: 'phone', typ: 'tel', value: member.phone, placeholder: '+420 …' } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Bio / Popis', name: 'bio', typ: 'textarea', value: member.bio, placeholder: 'Krátký popis…', styl: 'grid-column:1/-1' } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Adresa', name: 'address', value: member.address, placeholder: 'Ulice a číslo popisné' } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Město', name: 'city', value: member.city } }) %>
          <%- include('../../includes/pole', { pole: { label: 'PSČ', name: 'zip', value: member.zip } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Stát', name: 'country', value: member.country, vychozi: 'Česká republika' } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Role', name: 'is_admin', typ: 'toggle', value: member.is_admin, popisek: 'Správce',
            zobraz: member.is_admin ? 'Správce' : 'Uživatel' } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Stav účtu', name: 'is_active', typ: 'toggle', value: member.is_active, popisek: 'Aktivní účet',
            zobraz: member.is_active ? 'Aktivní' : 'Neaktivní' } }) %>
        </div>

        <%- include('../../includes/upravit', { paticka: true, formular: 'formDetail', urlZpet: urlZalozky }) %>
      </form>
    </div>
  </div>
<% } %>

<% if (currentTab === 'banka') { %>
  <div class="card">
    <div class="card-header">
      <h2 style="font-size:15px;font-weight:600;margin:0;">Bankovní účet</h2>
    </div>
    <div class="card-body">
      <form method="post" action="/lide/tym/<%= member.public_id %>" id="formBanka" class="upravitelne" autocomplete="off">
        <input type="hidden" name="tab" value="<%= currentTab %>">
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;">
          <%- include('../../includes/pole', { pole: { label: 'Číslo účtu', name: 'bank_account', value: member.bank_account, placeholder: '123456789/0100' } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Název banky', name: 'bank_name', value: member.bank_name, placeholder: 'Komerční banka' } }) %>
          <%- include('../../includes/pole', { pole: { label: 'IBAN', name: 'iban', value: member.iban, placeholder: 'CZ65 …' } }) %>
        </div>
      </form>
    </div>
  </div>
<% } %>
<%- include('_ekonomika') %>

<% if (currentTab === 'pristupy') { %>

  <!-- Přehled sekcí a záložek, které uživatel vidí -->
  <div class="card" style="margin-bottom:24px;">
    <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
      <h2 style="font-size:15px;font-weight:600;margin:0;">Co uživatel vidí</h2>
      <a href="/lide/pristupy" class="btn btn-outline btn-sm">Upravit v matici →</a>
    </div>
    <div class="card-body">
      <%
        // Stejné vyhodnocení jako v menu a ve strážci rout (src/access.js).
        const vidi = (section, item) => isAllowed(member, { ...item, section });
        const celkem = sections.reduce((n, sec) => n + sec.items.length, 0);
        const povoleno = sections.reduce(
          (n, sec) => n + sec.items.filter(it => vidi(sec, it)).length, 0);
      %>
      <div style="font-size:13px;color:var(--text-muted);margin-bottom:18px;">
        Přístup k <strong style="color:var(--text-primary);"><%= povoleno %></strong>
        z <%= celkem %> sekcí systému.
        <% if (!member.is_admin) { %>
          Sekce označené zámkem vyžadují roli Správce.
        <% } %>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px;">
        <% sections.forEach(section => { %>
        <div>
          <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--text-muted);margin-bottom:8px;">
            <%= section.label %>
          </div>
          <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px;">
            <% section.items.forEach(item => {
                 const ok = vidi(section, item);
                 const rolí = (item.adminOnly || section.adminOnly) && !member.is_admin;
            %>
            <li style="display:flex;align-items:center;gap:8px;font-size:13.5px;color:<%= ok ? 'var(--text-primary)' : 'var(--text-muted)' %>;">
              <% if (ok) { %>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#15803D" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"/></svg>
              <% } else if (rolí) { %>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.6;"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <% } else { %>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              <% } %>
              <span style="<%= ok ? '' : 'text-decoration:line-through;text-decoration-color:var(--border-strong);' %>"><%= item.label %></span>
            </li>
            <% }); %>
          </ul>
        </div>
        <% }); %>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2 style="font-size:15px;font-weight:600;margin:0;">Informace o účtu</h2>
    </div>
    <div class="card-body">
      <dl style="display:grid;grid-template-columns:auto 1fr;gap:10px 24px;font-size:14px;">
        <dt style="color:var(--text-muted);font-weight:500;">ID uživatele</dt>
        <dd><code style="font-family:var(--font-mono);font-size:13px;"><%= member.public_id %></code></dd>
        <dt style="color:var(--text-muted);font-weight:500;">E-mail</dt>
        <dd><%= member.email %></dd>
        <dt style="color:var(--text-muted);font-weight:500;">Datum vytvoření</dt>
        <dd><%= new Date(member.created_at).toLocaleDateString('cs-CZ', { day:'numeric', month:'long', year:'numeric' }) %></dd>
        <dt style="color:var(--text-muted);font-weight:500;">Stav účtu</dt>
        <dd>
          <% if (member.is_active) { %>
            <span class="badge" style="background:var(--success-bg);color:#15803D;">Aktivní</span>
          <% } else { %>
            <span class="badge" style="background:var(--danger-bg);color:#991b1b;">Neaktivní</span>
          <% } %>
        </dd>
        <dt style="color:var(--text-muted);font-weight:500;">Role</dt>
        <dd>
          <% if (member.is_admin) { %>
            <span class="badge" style="background:#fef9c3;color:#854d0e;">Správce</span>
          <% } else { %>
            <span class="badge" style="background:var(--info-bg);color:var(--info);">Uživatel</span>
          <% } %>
        </dd>
        <% if (member.updated_at) { %>
        <dt style="color:var(--text-muted);font-weight:500;">Poslední změna</dt>
        <dd><%= new Date(member.updated_at).toLocaleDateString('cs-CZ', { day:'numeric', month:'long', year:'numeric' }) %></dd>
        <% } %>
      </dl>
    </div>
  </div>
<% } %>
</div>
