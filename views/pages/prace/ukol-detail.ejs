<%
  const cas = d => new Date(d).toLocaleString('cs-CZ', { day:'numeric', month:'numeric', year:'numeric', hour:'2-digit', minute:'2-digit', timeZone:'Europe/Prague' });
  const stavLabel = s => (TASK_STAVY.find(x => x[0] === s) || [, s])[1];
  const jeMoje = bezi && bezi.task_id === ukol.id;
%>

<div class="page-header">
  <div class="page-header-left">
    <h1><%= ukol.summary %></h1>
    <p>
      <% if (ukol.code) { %><span style="font-family:var(--font-mono);"><%= ukol.code %></span> · <% } %>
      <% if (ukol.klient) { %><%= ukol.klient %> · <% } %>
      celkem <strong><%= hodinyMinuty(celkem) %></strong>
    </p>
  </div>
  <div class="page-header-akce">
    <% if (jeMoje) { %>
      <form method="post" action="/prace/stopky/stop">
        <input type="hidden" name="back" value="<%= strany.aktualni %>">
        <button type="submit" class="btn btn-danger">■ Zastavit</button>
      </form>
    <% } else { %>
      <form method="post" action="/prace/stopky/start">
        <input type="hidden" name="ukol_id" value="<%= ukol.id %>">
        <input type="hidden" name="back" value="<%= strany.aktualni %>">
        <button type="submit" class="btn btn-primary">▶ <%= bezi ? 'Přepnout sem' : 'Spustit stopky' %></button>
      </form>
    <% } %>
    <a href="/prace/ukoly" class="btn btn-outline" data-zpet>← Na úkoly</a>
  </div>
</div>

<% if (bezi && !jeMoje) { %>
<div class="hlaska hlaska-varovani">
  Právě běží měření na <strong><%= bezi.ukol_kod || 'jiném úkolu' %></strong>. Spuštění stopek tady ho zastaví.
</div>
<% } %>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:24px;align-items:start;">
  <div style="min-width:0;">
    <% if (ukol.description) { %>
    <div class="card" style="margin-bottom:20px;">
      <div class="card-header"><h2 style="font-size:15px;font-weight:600;margin:0;">Popis</h2></div>
      <div class="card-body"><div style="font-size:13.5px;white-space:pre-wrap;line-height:1.6;"><%= ukol.description %></div></div>
    </div>
    <% } %>

    <% if (podukoly.length) { %>
    <div class="card" style="margin-bottom:20px;">
      <div class="card-header"><h2 style="font-size:15px;font-weight:600;margin:0;">Podúkoly (<%= podukoly.length %>)</h2></div>
      <div class="card-body" style="display:flex;flex-direction:column;gap:6px;">
        <% podukoly.forEach(function (p) { %>
        <a href="/prace/ukoly/<%= p.id %>" style="display:flex;gap:10px;align-items:center;text-decoration:none;color:inherit;font-size:13.5px;">
          <span style="font-family:var(--font-mono);font-size:12.5px;color:var(--link);"><%= p.code %></span>
          <span style="flex:1;"><%= p.summary %></span>
          <span class="badge badge-<%= tonStavu(p.status) %>"><%= stavLabel(p.status) %></span>
        </a>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if (prilohy.length) { %>
    <div class="card" style="margin-bottom:20px;">
      <div class="card-header"><h2 style="font-size:15px;font-weight:600;margin:0;">Přílohy</h2></div>
      <div class="card-body"><%- include('../../includes/prilohy', { soubory: prilohy, KATEGORIE_PRILOH }) %></div>
    </div>
    <% } %>

    <div class="card">
      <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;">
        <h2 style="font-size:15px;font-weight:600;margin:0;">Naměřený čas</h2>
        <span style="font-size:13px;color:var(--text-secondary);font-weight:400;"><%= strany.celkem.toLocaleString('cs-CZ') %> měření · celkem <%= hodinyMinuty(celkem) %></span>
      </div>
      <div class="table-wrapper" style="border:none;border-radius:0;">
        <table class="data-table">
          <thead><tr><th>Kdy</th><th>Kdo</th><th class="hide-mobile">Poznámka</th><th class="num">Délka</th></tr></thead>
          <tbody>
            <% if (!mereni.length) { %>
              <tr><td colspan="4"><div class="prazdno"><strong>Zatím nic naměřeno</strong>Stopky spustíte tlačítkem nahoře.</div></td></tr>
            <% } %>
            <% mereni.forEach(function (m) { %>
            <tr>
              <td class="mono sekundarni"><%= cas(m.started_at) %></td>
              <td><%= [m.first_name, m.last_name].filter(Boolean).join(' ') %></td>
              <td class="sekundarni hide-mobile"><%= m.note || '' %></td>
              <td class="num"><%= m.ended_at ? hodinyMinuty(m.sekund) : 'běží' %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <%- include('../../includes/strankovani', { strany }) %>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h2 style="font-size:15px;font-weight:600;margin:0;">Stav</h2></div>
    <div class="card-body">
      <form method="post" action="/prace/ukoly/<%= ukol.id %>/stav" style="margin-bottom:16px;">
        <input type="hidden" name="back" value="<%= strany.aktualni %>">
        <select name="status" class="form-select" onchange="this.form.submit()">
          <% TASK_STAVY.forEach(function (s) { %>
            <option value="<%= s[0] %>" <%= ukol.status === s[0] ? 'selected' : '' %>><%= s[1] %></option>
          <% }) %>
        </select>
      </form>
      <dl style="display:grid;grid-template-columns:auto 1fr;gap:8px 16px;font-size:13.5px;margin:0;">
        <dt style="color:var(--text-muted);">Řešitel</dt>
        <dd><%= [ukol.first_name, ukol.last_name].filter(Boolean).join(' ') || '–' %></dd>
        <dt style="color:var(--text-muted);">Klient</dt>
        <dd><%= ukol.klient || '–' %></dd>
        <dt style="color:var(--text-muted);">Termín</dt>
        <dd><%= ukol.due_date ? new Date(ukol.due_date).toLocaleDateString('cs-CZ') : '–' %></dd>
        <% if (ukol.priority_label) { %>
        <dt style="color:var(--text-muted);">Priorita</dt>
        <dd><%= ukol.priority_label %></dd>
        <% } %>
        <dt style="color:var(--text-muted);">Naměřeno</dt>
        <dd style="font-family:var(--font-mono);"><%= hodinyMinuty(celkem) %></dd>
      </dl>
    </div>
  </div>
</div>
