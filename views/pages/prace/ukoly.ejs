<%
  const stavLabel = s => (TASK_STAVY.find(x => x[0] === s) || [, s])[1];
  const dnes = prazskeDatum(new Date());
  const poTerminu = u => u.due_date && u.status !== 'done' && jenDatum(u.due_date) < dnes;
  const maFiltr = filtry.q || filtry.stav || filtry.klient;
  const malo = total >= 2 && total <= 4;
  const nazev = total === 1 ? 'úkol' : malo ? 'úkoly' : 'úkolů';
  const nehotove = total === 1 ? 'nehotový ' : malo ? 'nehotové ' : 'nehotových ';
%>

<div class="page-header">
  <div class="page-header-left">
    <h1>Úkoly</h1>
    <p><%= total.toLocaleString('cs-CZ') %> <%= filtry.jenNehotove ? nehotove : '' %><%= nazev %><%= maFiltr ? (malo ? ' odpovídají filtru' : ' odpovídá filtru') : filtry.jenNehotove ? '' : ' celkem' %></p>
  </div>
  <div class="page-header-akce">
    <button class="btn btn-primary" data-modal-open="modalUkol">+ Nový úkol</button>
  </div>
</div>

<form method="get" class="filtr-lista">
  <% if (strany.vlastniVelikost) { %><input type="hidden" name="velikost" value="<%= strany.naStranku %>"><% } %>
  <input type="text" name="q" value="<%= filtry.q %>" placeholder="Hledat úkol nebo GUK-…" class="form-control" aria-label="Hledat úkol nebo jeho kód">
  <select name="klient" class="form-select" style="max-width:200px;" aria-label="Klient">
    <option value="">Všichni klienti</option>
    <% klienti.forEach(function (k) { %>
      <option value="<%= k.id %>" <%= filtry.klient === k.id ? 'selected' : '' %>><%= k.name %></option>
    <% }) %>
  </select>
  <select name="stav" class="form-select" aria-label="Stav">
    <option value="">Všechny stavy</option>
    <% TASK_STAVY.forEach(function (s) { %>
      <option value="<%= s[0] %>" <%= filtry.stav === s[0] ? 'selected' : '' %>><%= s[1] %></option>
    <% }) %>
  </select>
  <label class="toggle-label" style="font-size:13px;">
    <input type="checkbox" name="vse" value="1" class="toggle-input" <%= filtry.vse ? 'checked' : '' %>>
    <span class="toggle-switch"></span>
    <span class="toggle-text">i hotové</span>
  </label>
  <button type="submit" class="btn btn-outline">Filtrovat</button>
  <% if (maFiltr || filtry.vse) { %><a href="/prace/ukoly" class="btn btn-ghost">Zrušit filtr</a><% } %>
</form>

<div class="table-wrapper">
  <table class="data-table" style="min-width:0;">
    <thead>
      <tr>
        <th class="hide-mobile">ID</th><th>Souhrn</th><th class="hide-mobile">Klient</th><th class="hide-mobile">Řešitel</th>
        <th>Termín</th><th class="num">Čas</th><th class="mobil">Stav</th><th aria-label="Stopky"></th>
      </tr>
    </thead>
    <tbody>
      <% if (!ukoly.length) { %>
        <tr><td colspan="8">
          <div class="prazdno">
            <% if (maFiltr) { %>
              <strong>Filtru neodpovídá žádný úkol</strong>
              <a href="/prace/ukoly" class="btn btn-outline btn-sm">Zrušit filtr</a>
            <% } else if (filtry.jenNehotove) { %>
              <strong>Žádné nehotové úkoly</strong>
              <a href="/prace/ukoly?vse=1" class="btn btn-outline btn-sm">Zobrazit i hotové</a>
            <% } else { %>
              <strong>Zatím žádné úkoly</strong>
              První založte tlačítkem Nový úkol.
            <% } %>
          </div>
        </td></tr>
      <% } %>
      <% ukoly.forEach(function (u) { %>
      <tr data-href="/prace/ukoly/<%= u.id %>">
        <td class="mono hide-mobile">
          <% if (u.bezi) { %><span class="stopky-tecka" style="margin-right:5px;" title="Měření běží"></span><% } %>
          <a href="/prace/ukoly/<%= u.id %>" class="radek-odkaz"><%= u.code || '–' %></a>
        </td>
        <td><a href="/prace/ukoly/<%= u.id %>" class="radek-odkaz radek-text" style="font-weight:500;" title="<%= u.summary %>"><%= u.summary || 'Bez souhrnu' %></a></td>
        <td class="sekundarni hide-mobile"><span class="radek-text" title="<%= u.klient || '' %>"><%= u.klient || '–' %></span></td>
        <td class="sekundarni hide-mobile" style="white-space:nowrap;"><%= [u.resitel_jmeno, u.resitel_prijmeni].filter(Boolean).join(' ') || '–' %></td>
        <td class="mono sekundarni">
          <% if (poTerminu(u)) { %><span class="pole-varovani" title="Po termínu"><%= ceskeDatum(u.due_date) %> ⚠</span><% } else { %><%= u.due_date ? ceskeDatum(u.due_date) : '–' %><% } %>
        </td>
        <td class="num"><%= hodinyMinuty(u.sekund) %></td>
        <td class="mobil" data-bez-prokliku>
          <form method="post" action="/prace/ukoly/<%= u.id %>/stav" style="display:inline;">
            <input type="hidden" name="back" value="<%= strany.aktualni %>">
            <select name="status" class="stav-vyber badge-<%= tonStavu(u.status) %>" aria-label="Stav úkolu <%= u.code || u.summary %>" onchange="this.form.submit()">
              <% TASK_STAVY.forEach(function (s) { %><option value="<%= s[0] %>" <%= u.status === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }) %>
            </select>
          </form>
        </td>
        <td data-bez-prokliku>
          <% if (bezi && bezi.task_id === u.id) { %>
            <form method="post" action="/prace/stopky/stop">
              <input type="hidden" name="back" value="<%= strany.aktualni %>">
              <button type="submit" class="btn btn-danger btn-sm" title="Zastavit" aria-label="Zastavit stopky">■</button>
            </form>
          <% } else { %>
            <form method="post" action="/prace/stopky/start">
              <input type="hidden" name="ukol_id" value="<%= u.id %>">
              <input type="hidden" name="back" value="<%= strany.aktualni %>">
              <button type="submit" class="btn btn-ghost btn-sm" title="<%= bezi ? 'Zastaví běžící a spustí tenhle' : 'Spustit stopky' %>" aria-label="Spustit stopky na úkolu <%= u.code || u.summary %>">▶</button>
            </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../../includes/strankovani', { strany }) %>

<div class="modal-backdrop" id="modalUkol">
  <div class="modal modal-sm">
    <div class="modal-header">
      <h2 class="modal-title">Nový úkol</h2>
      <button class="modal-close" data-modal-close="modalUkol">✕</button>
    </div>
    <form method="post" action="/prace/ukoly/vytvorit">
      <div class="modal-body">
        <div class="form-grid" style="grid-template-columns:1fr 1fr;gap:14px;">
          <div class="form-group col-span-2">
            <label class="form-label required">Souhrn</label>
            <input type="text" name="summary" class="form-control" required placeholder="Co je potřeba udělat">
          </div>
          <div class="form-group col-span-2">
            <label class="form-label">Popis</label>
            <textarea name="description" class="form-control" rows="3"></textarea>
          </div>
          <div class="form-group">
            <label class="form-label">Klient</label>
            <select name="company_id" class="form-select">
              <option value="">–</option>
              <% klienti.forEach(function (k) { %><option value="<%= k.id %>"><%= k.name %></option><% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Termín</label>
            <input type="date" name="due_date" class="form-control">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" data-modal-close="modalUkol">Zrušit</button>
        <button type="submit" class="btn btn-primary">Vytvořit</button>
      </div>
    </form>
  </div>
</div>
