<%
  const castka = n => Number(n).toLocaleString('cs-CZ', { minimumFractionDigits: 2 });
  const dny = n => n === 1 ? 'den' : n >= 2 && n <= 4 ? 'dny' : 'dní';
%>
<div class="page-header">
  <div class="page-header-left">
    <h1>Upomínky</h1>
    <p>Upomínky připravuje systém automaticky, odesílají se ale vždy ručně.</p>
  </div>
</div>

<%- include('../../includes/zalozky', { nazev: 'Stav upomínek', zalozky, tab, adresa: adresaZalozky }) %>

<% if (sent) { %>
<div class="hlaska hlaska-ok">Upomínka byla odeslána.</div>
<% } %>
<% if (error) { %>
<div class="hlaska hlaska-chyba">Upomínku se nepodařilo odeslat – zkontrolujte e-mail klienta a historii odeslání na faktuře.</div>
<% } %>

<div class="table-wrapper">
  <table class="data-table">
    <thead>
      <tr>
        <th>Faktura</th>
        <th class="hide-mobile">Stupeň</th>
        <th>Klient</th>
        <th class="num">Částka</th>
        <th class="num">Po splatnosti</th>
        <th>E-mail</th>
        <th class="mobil" style="text-align:right;">Akce</th>
      </tr>
    </thead>
    <tbody>
      <% if (reminders.length > 0) { %>
        <% reminders.forEach(r => {
             const email = r.status === 'odeslana' && r.sent_to ? r.sent_to : r.email;
        %>
        <tr data-href="/ucetnictvi/vydane-faktury/<%= r.invoice_id %>">
          <td class="mono"><a href="/ucetnictvi/vydane-faktury/<%= r.invoice_id %>" class="radek-odkaz"><%= r.number %></a></td>
          <td class="hide-mobile">
            <span class="badge badge-<%= r.level >= 3 ? 'chyba' : r.level === 2 ? 'varovani' : 'info' %>">
              <%= r.level %>. <%= r.level >= 3 ? 'předžalobní' : r.level === 2 ? 'upomínka' : 'upozornění' %>
            </span>
          </td>
          <td><span class="radek-text" title="<%= r.client_name || '' %>"><%= r.client_name || '–' %></span></td>
          <td class="num"><%= castka(r.total_amount) %> <%= r.currency %></td>
          <td class="num"><span class="pole-varovani"><%= r.days_overdue %> <%= dny(r.days_overdue) %></span><% if (r.due_date) { %><br><span class="sekundarni"><%= ceskeDatum(r.due_date) %></span><% } %></td>
          <td class="sekundarni"><% if (email) { %><span class="radek-text" style="min-width:0;" title="<%= email %>"><%= email %></span><% } else { %><span style="white-space:nowrap;">chybí e-mail</span><% } %></td>
          <td class="mobil" style="text-align:right;white-space:nowrap;" data-bez-prokliku>
            <% if (r.status === 'ceka') { %>
            <form method="post" action="/ucetnictvi/upominky/<%= r.id %>/odeslat" style="display:inline;">
              <input type="hidden" name="email" value="<%= r.email %>">
              <input type="hidden" name="redirect_to" value="<%= strany.aktualni %>">
              <button type="submit" class="btn btn-primary btn-sm" <%= r.email ? '' : 'disabled' %> title="<%= r.email ? `Odeslat na ${r.email}` : 'Klient nemá e-mail, doplňte ho na faktuře' %>">Odeslat</button>
            </form>
            <form method="post" action="/ucetnictvi/upominky/<%= r.id %>/zrusit" style="display:inline;">
              <input type="hidden" name="redirect_to" value="<%= strany.aktualni %>">
              <button type="submit" class="btn btn-ghost btn-sm">Zrušit</button>
            </form>
            <% } else if (r.status === 'odeslana') { %>
            <span class="badge badge-<%= tonStavu(r.status) %>">odesláno<%= r.sent_at ? ` ${ceskeDatum(prazskeDatum(r.sent_at))}` : '' %></span>
            <% } else { %>
            <span class="badge badge-<%= tonStavu(r.status) %>">zrušena</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="7">
          <div class="prazdno">
            <% if (tab === 'ceka') { %>
              <strong>Žádné upomínky k odeslání</strong>
              Všechny faktury jsou v pořádku.
            <% } else if (tab === 'odeslana') { %>
              <strong>Zatím žádné odeslané upomínky</strong>
            <% } else if (tab === 'zrusena') { %>
              <strong>Žádné zrušené upomínky</strong>
            <% } else { %>
              <strong>Zatím žádné upomínky</strong>
              Připraví se samy, když faktura přejde do stavu Po splatnosti.
            <% } %>
          </div>
        </td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../../includes/strankovani', { strany }) %>
