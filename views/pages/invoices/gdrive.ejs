<%
  // Živá chyba a uložená chyba kontroly bývají tatáž věta, ta se ukáže jednou.
  const jinaChybaKontroly = chybaKontroly && chybaKontroly !== error ? chybaKontroly : '';
  // Adresa konzole Googlu je odkaz, všechno ostatní jde escapované jako text.
  const textChyby = (text) => String(text).split(/(https:\/\/console\.(?:developers|cloud)\.google\.com\/[^\s"'<>]*[^\s"'<>.,;:)])/).forEach((kus, i) => {
    if (i % 2) { %><a href="<%= kus %>" target="_blank" rel="noopener noreferrer"><%= kus %></a><% } else { %><%= kus %><% }
  });
  // Doklady z doby před automatikou jsou v systému z POHODY, proto nejsou předvybrané.
  const predAutomatikou = files.filter(f => f.stav === 'vychozi');
  const nesparovane = files.filter(f => f.stav === 'nesparovano');
  const pending = files.filter(f => f.stav !== 'vychozi' && f.stav !== 'nesparovano');
  const veFronte = (f) => automatikaHlida && (f.stav === 'cekajici' || !f.stav);
  const vFronte = files.filter(veFronte).length;
%>
<div class="page-header">
  <div class="page-header-left">
    <h1>Import z Google Disku</h1>
    <p>Přijaté faktury ze složky <strong>SEIL - účetnictví</strong> → rok → měsíc → Přijaté faktury</p>
  </div>
  <div class="page-header-akce">
    <a href="/ucetnictvi/prijate-faktury" class="btn btn-outline btn-sm" data-zpet>← Zpět na faktury</a>
  </div>
</div>

<% if (job) { %>
<div id="gdJob" class="hlaska hlaska-info" data-running="<%= job.running ? '1' : '0' %>">
  <div id="gdJobText"></div>
  <div style="height:6px;background:var(--border);border-radius:3px;margin-top:10px;overflow:hidden;">
    <div id="gdJobBar" style="height:100%;width:0;background:currentColor;transition:width 0.3s;"></div>
  </div>
  <ul id="gdJobErrors" style="margin:10px 0 0;padding-left:18px;font-size:13px;"></ul>
</div>
<% } %>

<% if (error || jinaChybaKontroly) { %>
<div class="hlaska hlaska-chyba" role="alert" style="overflow-wrap:anywhere;">
  <% if (error) { %><div><strong>Nelze načíst soubory:</strong> <% textChyby(error); %></div><% } %>
  <% if (jinaChybaKontroly) { %><div<%- error ? ' style="margin-top:6px;"' : '' %>><strong>Poslední kontrola selhala:</strong> <% textChyby(jinaChybaKontroly); %></div><% } %>
  <% if (radaNasdilet && serviceAccount) { %><div style="margin-top:6px;">Účet služby: <code class="kod"><%= serviceAccount %></code></div><% } %>
</div>
<% } %>

<p class="form-hint" style="margin-bottom:16px;">
  Nové doklady se načítají samy: letošní a loňskou složku kontroluje automatika každých 5 minut, faktury založí a pošle push.
  <% if (tab === 'nenahrane' && vFronte) { %>Ve frontě: <%= vFronte %>.<% } %>
  <% if (kontrola) { %>Poslední kontrola: <%= new Date(kontrola).toLocaleString('cs-CZ', { timeZone: 'Europe/Prague' }) %>.<% } else { %>Zatím neproběhla.<% } %>
</p>

<form method="get" class="filtr-lista">
  <% if (tab === 'nahrane') { %><input type="hidden" name="tab" value="nahrane"><% } %>
  <select name="year" class="form-select" aria-label="Rok">
    <% for (let y = new Date().getFullYear() + 1; y >= 2020; y--) { %>
      <option value="<%= y %>" <%= year === y ? 'selected' : '' %>><%= y %></option>
    <% } %>
  </select>
  <select name="month" class="form-select" aria-label="Měsíc">
    <option value="" <%= month === null ? 'selected' : '' %>>Celý rok</option>
    <% ['Leden','Únor','Březen','Duben','Květen','Červen','Červenec','Srpen','Září','Říjen','Listopad','Prosinec'].forEach((m, i) => { %>
      <option value="<%= i+1 %>" <%= month === i+1 ? 'selected' : '' %>><%= (i+1) + '. ' + m %></option>
    <% }) %>
  </select>
  <button type="submit" class="btn btn-outline">Načíst složku</button>
</form>

<%- include('../../includes/zalozky', { nazev: 'Doklady ve složce', zalozky, tab, adresa: adresaZalozky }) %>

<% if (files.length === 0) { %>
<div class="card">
  <div class="prazdno">
    <% if (error) { %>
      <strong>Složku se nepodařilo načíst</strong>
      Důvod je v hlášce nahoře.
    <% } else if (!slozkaPrazdna && tab === 'nenahrane') { %>
      <strong>Všechny doklady z této složky jsou nahrané</strong>
      Najdete je na záložce Nahrané.
    <% } else if (!slozkaPrazdna) { %>
      <strong>Z této složky zatím není nic nahrané</strong>
      Doklady čekají na záložce Nenahrané.
    <% } else { %>
      <strong>V této složce nejsou žádné doklady</strong>
      Zkuste jiný měsíc nebo celý rok.
    <% } %>
  </div>
</div>
<% } else if (tab === 'nahrane') { %>
<div class="table-wrapper">
  <table class="data-table">
    <thead>
      <tr>
        <th>Soubor</th><th>Faktura</th><th class="hide-mobile">Dodavatel</th><th class="num hide-mobile">Celkem</th><th class="mobil">Výsledek</th><th class="hide-mobile">Složka</th>
      </tr>
    </thead>
    <tbody>
      <% files.forEach(f => { %>
        <tr data-href="/ucetnictvi/prijate-faktury/<%= f.invoiceId %>">
          <td data-bez-prokliku>
            <span class="radek-text" title="<%= f.name %>">
              <% if (f.webViewLink) { %><a href="<%= f.webViewLink %>" target="_blank" rel="noopener" class="radek-odkaz"><%= f.name %></a><% } else { %><%= f.name %><% } %>
            </span>
          </td>
          <td class="mono"><a href="/ucetnictvi/prijate-faktury/<%= f.invoiceId %>" class="radek-odkaz"><%= f.faktura.internal_number || f.faktura.number %></a></td>
          <td class="hide-mobile"><span class="radek-text" title="<%= f.faktura.supplier %>"><%= f.faktura.supplier %></span></td>
          <td class="num hide-mobile"><%= Number(f.faktura.total_amount).toLocaleString('cs-CZ', { minimumFractionDigits: 2 }) %> <%= f.faktura.currency %></td>
          <td class="mobil">
            <% if (f.faktura.source === 'gdrive') { %>
              <span class="badge badge-ok" title="Faktura vznikla z tohoto dokladu.">Založeno</span>
            <% } else { %>
              <span class="badge badge-info" title="Doklad se připojil k faktuře, která v systému už byla.">Spárováno</span>
            <% } %>
          </td>
          <td class="sekundarni hide-mobile"><%= f.folderPath %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../../includes/strankovani', { strany }) %>
<% } else { %>
<form method="post" action="/ucetnictvi/prijate-faktury/gdrive/import" id="gdForm">
  <input type="hidden" name="year"  value="<%= year %>">
  <input type="hidden" name="month" value="<%= month === null ? '' : month %>">

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;flex-wrap:wrap;">
    <button type="submit" class="btn btn-primary" id="gdSubmit" <%= pending.length === 0 ? 'disabled' : '' %>>
      <span>↓ Načíst vybrané (<span id="gdCount"><%= pending.length %></span>)</span>
    </button>
    <% if (nesparovane.length > 0) { %>
    <button type="submit" name="zalozit_vybrane" value="1" class="btn btn-outline" id="gdZalozit" disabled onclick="return confirm('Z vybraných nespárovaných dokladů založit nové faktury?')">Založit vybrané nespárované jako nové</button>
    <% } %>
    <span class="form-hint">
      Každý doklad se stáhne a vytěží Claudem, u jednoho to trvá asi 10 sekund.
    </span>
  </div>

  <% if (predAutomatikou.length > 0) { %>
  <div class="hlaska hlaska-info">
    Doklad Před automatikou se jen připojí ke stejné faktuře v systému, podle čísla dodavatele nebo IČO, data a částky. Když ji nenajde, nic nezaloží a ukáže se Nespárováno.
  </div>
  <% } %>

  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th style="width:36px;"><input type="checkbox" id="gdAll" onchange="gdToggle(this.checked)" title="Vybrat všechny doklady" aria-label="Vybrat všechny doklady"></th>
          <th>Soubor</th><th class="hide-mobile">Složka</th><th>Změněno</th><th class="mobil">Stav</th>
        </tr>
      </thead>
      <tbody>
        <% files.forEach(f => { %>
          <tr>
            <td>
              <input type="checkbox" class="gd-cb" name="file_ids" value="<%= f.id %>" aria-label="Vybrat <%= f.name %>" <%- f.stav === 'vychozi' ? 'data-pred-automatikou' : f.stav === 'nesparovano' ? 'data-pred-automatikou data-nesparovano' : 'checked' %> onchange="gdUpdate()">
            </td>
            <td>
              <span class="radek-text" title="<%= f.name %>">
                <% if (f.webViewLink) { %>
                  <a href="<%= f.webViewLink %>" target="_blank" rel="noopener" class="radek-odkaz"><%= f.name %></a>
                <% } else { %><%= f.name %><% } %>
              </span>
            </td>
            <td class="sekundarni hide-mobile"><%= f.folderPath %></td>
            <td class="mono sekundarni">
              <%= f.modifiedTime ? ceskeDatum(prazskeDatum(f.modifiedTime)) : '–' %>
            </td>
            <td class="mobil">
              <% if (f.stav === 'vychozi') { %>
                <span class="badge badge-neutral" title="Ve složce byl už před spuštěním automatiky, sám se nenačte.">Před automatikou</span>
              <% } else if (f.stav === 'nesparovano') { %>
                <span class="badge badge-varovani" title="<%= f.chyba %>">Nespárováno</span>
                <button type="submit" name="zalozit_novou" value="<%= f.id %>" class="btn btn-ghost btn-sm" title="Faktura v systému není, založit ji z tohoto dokladu">Založit jako novou</button>
              <% } else if (f.stav === 'chyba') { %>
                <span class="badge badge-chyba" title="<%= f.chyba %>">Chyba</span>
                <% if (automatikaHlida && f.pokusy < MAX_POKUSU) { %><span class="sekundarni" style="font-size:11px;">zkusí se znovu</span><% } %>
              <% } else if (veFronte(f)) { %>
                <span class="badge badge-info" title="Načte se samo při příští kontrole, do 5 minut.">Ve frontě</span>
              <% } else { %>
                <span class="badge badge-neutral" title="Automatika hlídá jen letošní a loňskou složku, tento doklad načtete výběrem.">Nenačteno</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</form>
<% } %>

<script>
const gdRadky = () => [...document.querySelectorAll('.gd-cb')];
// Vybrat vše bere i doklady Před automatikou: ty se jen párují a fakturu nezaloží.
function gdToggle(checked) {
  gdRadky().forEach(cb => { cb.checked = checked; });
  gdUpdate();
}
function gdUpdate() {
  const vse = gdRadky();
  const n = vse.filter(cb => cb.checked).length;
  const hlavicka = document.getElementById('gdAll');
  if (!hlavicka) return; // prázdná složka, tabulka se nevykreslí
  document.getElementById('gdCount').textContent = n;
  document.getElementById('gdSubmit').disabled = n === 0;
  const zalozit = document.getElementById('gdZalozit');
  if (zalozit) zalozit.disabled = !vse.some(cb => cb.checked && cb.hasAttribute('data-nesparovano'));
  hlavicka.checked = vse.length > 0 && n === vse.length;
  hlavicka.indeterminate = n > 0 && n < vse.length;
}
// Prohlížeč po návratu tlačítkem Zpět vrátí zaškrtnutí, počet musí sedět s nimi.
window.addEventListener('pageshow', gdUpdate);
document.getElementById('gdForm')?.addEventListener('submit', () => {
  const btn = document.getElementById('gdSubmit');
  btn.disabled = true;
  btn.textContent = 'Spouštím import…';
});

// Import běží na pozadí – dotahujeme stav, dokud neskončí, pak obnovíme seznam
(function gdJobPoll() {
  const box = document.getElementById('gdJob');
  if (!box) return;
  const text = document.getElementById('gdJobText');
  const bar  = document.getElementById('gdJobBar');
  const errs = document.getElementById('gdJobErrors');
  let wasRunning = box.dataset.running === '1';

  const paint = (j) => {
    const pct = j.total ? Math.round((j.done / j.total) * 100) : 100;
    bar.style.width = pct + '%';
    text.innerHTML = j.running
      ? '⏳ Zpracovávám <strong>' + j.done + '</strong> z <strong>' + j.total + '</strong> dokladů…'
      : '✓ Hotovo – založeno <strong>' + j.imported + '</strong>, spárováno <strong>' + (j.merged || 0) + '</strong>'
        + (j.nesparovano ? ', nespárováno <strong>' + j.nesparovano + '</strong>' : '')
        + (j.skipped ? ', přeskočeno ' + j.skipped : '')
        + (j.failed  ? ', <strong>' + j.failed + '</strong> selhalo' : '') + '.';
    box.className = 'hlaska ' + (j.running ? 'hlaska-info' : j.failed ? 'hlaska-varovani' : 'hlaska-ok');
    errs.replaceChildren(...(j.errors || []).map(e => {
      const li = document.createElement('li');
      li.textContent = e;
      return li;
    }));
  };

  const tick = async () => {
    try {
      const j = await (await fetch('/ucetnictvi/prijate-faktury/gdrive/status')).json();
      paint(j);
      if (j.running) return setTimeout(tick, 2000);
      if (wasRunning) location.reload(); // seznam přepneme na „Naimportováno“
    } catch { setTimeout(tick, 5000); }
  };
  tick();
})();
</script>
