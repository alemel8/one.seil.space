<%
  const fmt = n  => Number(n||0).toLocaleString('cs-CZ', {minimumFractionDigits:2});
  const fmtD = d => d ? new Date(d).toLocaleDateString('cs-CZ') : '–';
  const isOverdue = invoice.due_date && invoice.status !== 'Zaplacena' && invoice.status !== 'Storno' && new Date(invoice.due_date) < new Date();
  // Režim úprav (src/upravy.js): jediný formulář záznamu; bez JS otevře
  // úpravy ?upravit=1. Pole leží na kartách obou sloupců a hlásí se k němu
  // přes form= – mezi kartami jsou formuláře příloh, párování a exportu.
  const formular = 'formFaktura';
  const rezim = rezimUprav ? 'upravy' : 'zobrazeni';
  const urlZpet = `/ucetnictvi/prijate-faktury/${invoice.id}`;
  const MAX_CASTKA = 9999999999.99; // sloupce DECIMAL(12,2): větší číslo by skončilo chybou databáze
%>

<div class="detail" data-rezim="<%= rezim %>">
<div class="page-header">
  <div class="page-header-left">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
      <a href="/ucetnictvi/prijate-faktury" class="btn btn-ghost btn-sm" data-zpet>← Zpět</a>
      <h1>Přijatá faktura <%= invoice.internal_number || invoice.number %></h1>
      <span class="badge badge-<%= tonStavu(invoice.status) %>" style="font-size:13px;"><%= invoice.status %></span>
    </div>
  </div>
  <div class="page-header-akce">
    <% if (invoice.attachment_path && !invoice.attachment_missing) { %>
    <a href="/doklady/soubor/<%= invoice.attachment_path %>" class="btn btn-outline"
       data-nahled
       data-nahled-nazev="<%= invoice.attachment_path %>"
       data-nahled-typ="<%= invoice.attachment_mime || '' %>"
       data-nahled-velikost="<%= invoice.attachment_size || 0 %>">📄 Zobrazit přílohu</a>
    <% } %>
    <button class="btn btn-outline" data-modal-open="modalStatus">🔄 Stav</button>
    <%- include('../../includes/upravit', { formular, urlUpravit: '?upravit=1', urlZpet }) %>
  </div>
</div>

<%# Formulář záznamu je naschvál prázdný – formulář ve formuláři nejde a jeho
    pole leží na kartách mezi formuláři příloh a akcí (form="formFaktura"). %>
<form method="post" action="/ucetnictvi/prijate-faktury/<%= invoice.id %>/upravit" id="formFaktura" class="upravitelne" autocomplete="off"></form>

<% if (saved) { %>
<div data-hlaska class="jen-zobrazeni" style="background:#dcfce7;color:#166534;border:1px solid #bbf7d0;padding:10px 16px;border-radius:8px;margin-bottom:16px;">✓ Uloženo</div>
<% } %>
<% if (locals.error) { %>
<div data-hlaska style="background:var(--danger-bg);color:var(--danger);padding:10px 16px;border-radius:8px;margin-bottom:16px;">⚠ <%= error %></div>
<% } %>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:24px;align-items:start;">

  <!-- Levý sloupec -->
  <div style="display:flex;flex-direction:column;gap:20px;">

    <!-- Dodavatel -->
    <div class="card">
      <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
        <strong>Dodavatel</strong>
        <% if (invoice.supplier_ico) { %>
        <a href="https://ares.gov.cz/ekonomicke-subjekty?ico=<%= invoice.supplier_ico %>" target="_blank" style="font-size:12px;color:var(--link);">Ověřit v ARES ↗</a>
        <% } %>
      </div>
      <div class="card-body">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          <%# Starý doklad bez interního čísla má číslo faktury v nadpisu stránky, ostatní tady. %>
          <%- include('../../includes/pole', { pole: { label: 'Číslo faktury', name: 'number', value: invoice.number, required: true, form: formular, trida: invoice.internal_number ? '' : 'jen-upravy', styl: 'grid-column:1/-1' } }) %>
          <% if (invoice.supplier_number) { %>
          <div class="form-group jen-zobrazeni" style="grid-column:1/-1;"><span class="form-label">Číslo od dodavatele</span><div class="mono"><%= invoice.supplier_number %></div></div>
          <% } %>
          <%- include('../../includes/pole', { pole: { label: 'Název dodavatele', name: 'supplier', value: invoice.supplier, required: true, form: formular, styl: 'grid-column:1/-1' } }) %>
          <%- include('../../includes/pole', { pole: { label: 'IČO', name: 'supplier_ico', value: invoice.supplier_ico, form: formular } }) %>
          <%- include('../../includes/pole', { pole: { label: 'DIČ', name: 'supplier_dic', value: invoice.supplier_dic, placeholder: 'CZ12345678', form: formular } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Ulice', name: 'supplier_address', value: invoice.supplier_address, form: formular } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Město', name: 'supplier_city', value: invoice.supplier_city, form: formular } }) %>
          <%- include('../../includes/pole', { pole: { label: 'PSČ', name: 'supplier_zip', value: invoice.supplier_zip, form: formular } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Stát', name: 'supplier_country', value: invoice.supplier_country, vychozi: 'Česká republika', form: formular } }) %>
        </div>
      </div>
    </div>

    <!-- Termíny a platba -->
    <div class="card">
      <div class="card-header"><strong>Termíny a platba</strong></div>
      <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;">
        <%- include('../../includes/pole', { pole: { label: 'Datum přijetí', name: 'issue_date', typ: 'date', value: invoice.issue_date, form: formular, required: true } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Datum splatnosti', name: 'due_date', typ: 'date', value: invoice.due_date, form: formular,
          zobraz: isOverdue ? ceskeDatum(invoice.due_date) + ' ⚠' : undefined, tridaHodnoty: isOverdue ? 'pole-varovani' : undefined } }) %>
        <% if (invoice.paid_date) { %>
        <div class="form-group pole pole-stale">
          <span class="form-label">Zaplaceno</span>
          <div class="pole-hodnota pole-uspech"><%= ceskeDatum(invoice.paid_date) %></div>
        </div>
        <% } %>
        <%- include('../../includes/pole', { pole: { label: 'Měna', name: 'currency', typ: 'select', value: invoice.currency || 'CZK', moznosti: ['CZK', 'EUR', 'USD'], form: formular } }) %>
      </div>
    </div>

    <!-- Předkontace / účtování -->
    <% if (invoice.vat_deductible === false) { %>
    <div class="jen-zobrazeni" style="background:#fef3c7;color:#92400e;border-radius:var(--radius-md);padding:10px 14px;margin-bottom:16px;font-size:13px;">
      <strong>Bez nároku na odpočet DPH.</strong>
      Do POHODY jde celá částka <%= Number(invoice.total_amount||0).toLocaleString('cs-CZ',{minimumFractionDigits:2}) %> <%= invoice.currency %>
      do nákladů, DPH se neodečítá.
    </div>
    <% } %>

    <div class="card">
      <div class="card-header"><strong>Účtování (předkontace)</strong></div>
      <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <%- include('../../includes/pole', { pole: { label: 'MD (má dáti)', name: 'account_debit', value: invoice.account_debit, placeholder: '518', tridaHodnoty: 'pole-mono', form: formular } }) %>
        <%- include('../../includes/pole', { pole: { label: 'D (dal)', name: 'account_credit', value: invoice.account_credit, placeholder: '321', tridaHodnoty: 'pole-mono', form: formular } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Odpočet DPH', name: 'vat_deductible', typ: 'checkbox', value: invoice.vat_deductible !== false, hodnotaVstupu: 'on', form: formular,
          popisek: 'Uplatnit nárok na odpočet DPH', zobraz: invoice.vat_deductible !== false ? 'Uplatněn' : 'Bez nároku', styl: 'grid-column:1/-1',
          hint: 'Vypněte u reprezentace a pohoštění (§ 72 odst. 4 ZDPH) – do POHODY pak jde celá částka včetně DPH do nákladů a členění DPH „Nezahrnovat do DPH“.' } }) %>
      </div>
    </div>

    <!-- Poznámka -->
    <div class="card">
      <div class="card-header"><strong>Poznámka / předmět plnění</strong></div>
      <div class="card-body">
        <%- include('../../includes/pole', { pole: { label: 'Poznámka', name: 'notes', typ: 'textarea', value: invoice.notes, rows: 3, skrytyPopisek: true, form: formular } }) %>
      </div>
    </div>

    <!-- Příloha -->
    <div class="card">
      <div class="card-header"><strong>Příloha (PDF / foto faktury)</strong></div>
      <div class="card-body">
        <% if (invoice.attachment_path && invoice.attachment_missing) { %>
        <div style="background:var(--danger-bg);color:var(--danger);border:1px dashed var(--danger);border-radius:var(--radius-md);padding:14px;font-size:13px;margin-bottom:12px;">
          <strong>Doklad chybí.</strong>
          Záznam odkazuje na soubor <code><%= invoice.attachment_path %></code>, který na serveru není.
          Nahrajte jej prosím znovu níže.
        </div>
        <form method="post" action="/ucetnictvi/prijate-faktury/<%= invoice.id %>/priloha" enctype="multipart/form-data">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            <label style="cursor:pointer;">
              <input type="file" name="file" accept="application/pdf,image/*" style="display:none;" onchange="prilohaSubmit(this)">
              <span class="btn btn-outline btn-sm">Nahrát PDF / foto</span>
            </label>
            <label style="cursor:pointer;">
              <input type="file" name="file" accept="image/*" capture="environment" style="display:none;" onchange="prilohaSubmit(this)">
              <span class="btn btn-outline btn-sm">Vyfotit</span>
            </label>
            <span id="prilohaInfo" style="font-size:12px;color:var(--text-muted);"></span>
          </div>
        </form>
        <% } else if (invoice.attachment_path) { %>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
          <a href="/doklady/soubor/<%= invoice.attachment_path %>"
             data-nahled
             data-nahled-nazev="<%= invoice.attachment_path %>"
             data-nahled-typ="<%= invoice.attachment_mime || '' %>"
             data-nahled-velikost="<%= invoice.attachment_size || 0 %>"
             title="Zobrazit doklad"
             style="display:flex;align-items:center;gap:12px;text-decoration:none;color:inherit;cursor:zoom-in;">
            <% if ((invoice.attachment_mime || '').startsWith('image/')) { %>
            <img src="/doklady/soubor/<%= invoice.attachment_path %>" alt="Náhled faktury" loading="lazy"
                 style="width:56px;height:56px;object-fit:cover;border-radius:var(--radius-sm);border:1px solid var(--border);">
            <% } else { %>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <% } %>
            <span>
              <span style="display:block;color:var(--link);font-weight:500;"><%= invoice.attachment_path %></span>
              <% if (invoice.attachment_size) { %>
              <span style="display:block;font-size:12px;color:var(--text-muted);"><%= Math.round(invoice.attachment_size/1024) %> kB</span>
              <% } %>
            </span>
          </a>
          <div style="display:flex;gap:8px;align-items:center;">
            <a href="/doklady/soubor/<%= invoice.attachment_path %>" class="btn btn-outline btn-sm"
               data-nahled
               data-nahled-nazev="<%= invoice.attachment_path %>"
               data-nahled-typ="<%= invoice.attachment_mime || '' %>"
               data-nahled-velikost="<%= invoice.attachment_size || 0 %>">Zobrazit</a>
            <form method="post" action="/ucetnictvi/prijate-faktury/<%= invoice.id %>/priloha" enctype="multipart/form-data" style="display:inline;">
              <label style="cursor:pointer;">
                <input type="file" name="file" accept="application/pdf,image/*" style="display:none;" onchange="prilohaSubmit(this)">
                <span class="btn btn-ghost btn-sm">Nahradit</span>
              </label>
            </form>
          </div>
        </div>
        <% } else { %>
        <form method="post" action="/ucetnictvi/prijate-faktury/<%= invoice.id %>/priloha" enctype="multipart/form-data">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            <label style="cursor:pointer;">
              <input type="file" name="file" accept="application/pdf,image/*" style="display:none;" onchange="prilohaSubmit(this)">
              <span class="btn btn-outline btn-sm">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                Nahrát PDF / foto
              </span>
            </label>
            <label style="cursor:pointer;">
              <input type="file" name="file" accept="image/*" capture="environment" style="display:none;" onchange="prilohaSubmit(this)">
              <span class="btn btn-outline btn-sm">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                Vyfotit
              </span>
            </label>
            <span id="prilohaInfo" style="font-size:12px;color:var(--text-muted);">Žádná příloha</span>
          </div>
        </form>
        <% } %>
      </div>
    </div>

    <!-- Spárovaná transakce -->
    <% if (bankTx) { %>
    <div class="card">
      <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
        <strong>Spárovaná bankovní transakce</strong>
        <form method="post" action="/ucetnictvi/banka/<%= bankTx.id %>/zrusit-parovani" onsubmit="return confirm('Zrušit párování?')">
          <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);">Zrušit párování</button>
        </form>
      </div>
      <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;">
        <div>
          <div style="color:var(--text-muted);font-size:12px;margin-bottom:3px;">Popis</div>
          <div style="font-weight:500;"><%= bankTx.description || bankTx.message || '–' %></div>
        </div>
        <div>
          <div style="color:var(--text-muted);font-size:12px;margin-bottom:3px;">Částka</div>
          <div style="color:var(--danger);font-weight:600;">−<%= fmt(bankTx.amount) %> <%= bankTx.currency %></div>
        </div>
        <div>
          <div style="color:var(--text-muted);font-size:12px;margin-bottom:3px;">Datum</div>
          <div><%= fmtD(bankTx.date || bankTx.transaction_date) %></div>
        </div>
      </div>
    </div>
    <% } %>

    <%- include('../../includes/upravit', { paticka: true, formular, urlZpet }) %>

  </div>

  <!-- Pravý sloupec -->
  <div style="display:flex;flex-direction:column;gap:16px;">

    <!-- Rekapitulace -->
    <div class="card">
      <div class="card-header"><strong>Rekapitulace</strong></div>
      <div class="card-body">
        <div class="jen-zobrazeni">
          <div style="display:flex;justify-content:space-between;padding:6px 0;color:var(--text-muted);font-size:13px;border-bottom:1px solid var(--border);">
            <span>Základ bez DPH</span>
            <span><%= fmt(invoice.amount) %> <%= invoice.currency %></span>
          </div>
          <div style="display:flex;justify-content:space-between;padding:6px 0;color:var(--text-muted);font-size:13px;border-bottom:1px solid var(--border);">
            <span>DPH</span>
            <span><%= fmt(invoice.vat_amount) %> <%= invoice.currency %></span>
          </div>
          <div style="display:flex;justify-content:space-between;padding:10px 0 4px;font-size:17px;font-weight:700;color:var(--danger);">
            <span>K úhradě</span>
            <span><%= fmt(invoice.total_amount) %> <%= invoice.currency %></span>
          </div>
        </div>
        <%# V úpravách místo rekapitulace vstupy částek (display řídí CSS, proto mřížka až uvnitř). %>
        <div class="jen-upravy">
          <div style="display:grid;gap:14px;">
            <%- include('../../includes/pole', { pole: { label: 'Základ bez DPH', name: 'amount', typ: 'number', step: '0.01', max: MAX_CASTKA, value: invoice.amount, form: formular, zobraz: fmt(invoice.amount) + ' ' + invoice.currency } }) %>
            <%- include('../../includes/pole', { pole: { label: 'DPH', name: 'vat_amount', typ: 'number', step: '0.01', max: MAX_CASTKA, value: invoice.vat_amount, form: formular, zobraz: fmt(invoice.vat_amount) + ' ' + invoice.currency } }) %>
            <%- include('../../includes/pole', { pole: { label: 'Celková částka', name: 'total_amount', typ: 'number', step: '0.01', max: MAX_CASTKA, value: invoice.total_amount, form: formular, zobraz: fmt(invoice.total_amount) + ' ' + invoice.currency } }) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Akce -->
    <div class="card">
      <div class="card-header"><strong>Akce</strong></div>
      <div class="card-body" style="display:flex;flex-direction:column;gap:8px;">
        <a href="?upravit=1" class="btn btn-outline jen-zobrazeni" data-upravit-otevrit style="width:100%;">✏️ Upravit fakturu</a>
        <button class="btn btn-ghost" data-modal-open="modalStatus" style="width:100%;">🔄 Změnit stav</button>
        <% if (!bankTx && invoice.status !== 'Zaplacena') { %>
        <a href="/ucetnictvi/banka?parovat=<%= invoice.id %>" class="btn btn-ghost" style="width:100%;text-align:center;">🔗 Spárovat s bankou</a>
        <% } %>
        <form method="post" action="/ucetnictvi/prijate-faktury/pohoda-xml" target="_blank"
              <% if (invoice.pohoda_v_evidenci || invoice.pohoda_exported_at) { %>onsubmit="return confirm('<%= invoice.pohoda_v_evidenci ? 'Faktura už v POHODĚ je.' : 'Fakturu už jste jednou exportovali (' + fmtD(invoice.pohoda_exported_at) + ').' %> Opakovaný import ji v POHODĚ založí znovu. Pokračovat?')"<% } %>>
          <input type="hidden" name="ids" value="<%= invoice.id %>">
          <button type="submit" class="btn btn-ghost" style="width:100%;">↓ POHODA XML</button>
        </form>
      </div>
    </div>

    <!-- Metadata -->
    <div style="font-size:12px;color:var(--text-muted);padding:4px 8px;line-height:1.8;">
      <% if (invoice.internal_number) { %>
      <div><span style="opacity:.7;">Interní číslo:</span> <%= invoice.internal_number %></div>
      <% } %>
      <div><span style="opacity:.7;">Zdroj:</span> <%= zdrojDokladu(invoice) %></div>
      <% if (invoice.pohoda_v_evidenci) { %>
      <div><span style="opacity:.7;">POHODA:</span> doklad v ní je</div>
      <% } %>
      <div><span style="opacity:.7;">ID:</span> <code style="font-size:11px;"><%= invoice.id %></code></div>
      <div><span style="opacity:.7;">Vytvořeno:</span> <%= fmtD(invoice.created_at) %></div>
      <div><span style="opacity:.7;">Upraveno:</span> <%= fmtD(invoice.modified_at) %></div>
      <% if (invoice.pohoda_exported_at) { %>
      <div><span style="opacity:.7;">Export do POHODY:</span> <%= fmtD(invoice.pohoda_exported_at) %></div>
      <% } %>
    </div>

  </div>
</div>
</div>

<!-- Modal: Změna stavu -->
<div id="modalStatus" class="modal-backdrop" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="modal modal-sm">
    <div class="modal-header">
      <h2 class="modal-title">Změnit stav</h2>
      <button class="modal-close" onclick="document.getElementById('modalStatus').classList.remove('open')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form method="post" action="/ucetnictvi/prijate-faktury/<%= invoice.id %>/stav">
      <input type="hidden" name="redirect_to" value="/ucetnictvi/prijate-faktury/<%= invoice.id %>">
      <div class="modal-body">
        <select name="status" class="form-select">
          <% STATUSES_RECEIVED.forEach(s => { %>
          <option value="<%= s %>" <%= invoice.status===s?'selected':'' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('modalStatus').classList.remove('open')">Zrušit</button>
        <button type="submit" class="btn btn-primary">Uložit</button>
      </div>
    </form>
  </div>
</div>

<script>
// Otevírání modalu (data-modal-open) obsluhuje app.js; tady zůstává jen příloha.
// Přílohu zmenšíme ještě v prohlížeči, ať se z mobilu nenahrává foto v plné velikosti
window.prilohaSubmit = async function (input) {
  const raw = input.files && input.files[0];
  if (!raw) return;
  const info = document.getElementById('prilohaInfo');
  if (info) info.textContent = 'Ukládám…';

  const res = await window.dokladFoto.prepare(raw);
  const fd = new FormData();
  fd.append('file', res.file, res.file.name);

  try {
    const resp = await fetch(input.form.action, { method: 'POST', body: fd });
    if (!resp.ok) {
      const data = await resp.json().catch(() => ({}));
      throw new Error(data.error || 'Chyba serveru (' + resp.status + ')');
    }
    // Příloha se ukáže až po načtení; upravy.js přes něj přenese rozepsané údaje.
    window.upravyNactiZnovu ? window.upravyNactiZnovu() : window.location.reload();
  } catch (err) {
    input.value = '';
    if (info) info.textContent = 'Nepodařilo se uložit: ' + err.message;
    else alert('Přílohu se nepodařilo uložit: ' + err.message);
  }
};
</script>
