<%
  const zalohove = typ === 'zalohove';
  const sFiltrem = Boolean(filtr.aktivni || statusFilter);
  const bezFiltru = zalohove ? '/ucetnictvi/vydane-faktury?typ=zalohove' : '/ucetnictvi/vydane-faktury';
  const tvar = (jedna, dve, pet) => total === 1 ? jedna : total >= 2 && total <= 4 ? dve : pet;
  const castka = n => Number(n).toLocaleString('cs-CZ', { minimumFractionDigits: 2 });
%>
<div class="page-header">
  <div class="page-header-left">
    <h1><%= zalohove ? 'Zálohové faktury' : 'Vydané faktury' %></h1>
    <p><%= total.toLocaleString('cs-CZ') %> <%= zalohove ? tvar('zálohová faktura', 'zálohové faktury', 'zálohových faktur') : tvar('faktura', 'faktury', 'faktur') %><%= sFiltrem ? ` ${tvar('odpovídá', 'odpovídají', 'odpovídá')} filtru` : ' celkem' %></p>
  </div>
  <%# Export i modal pracují jen s vydanými fakturami, zálohová není daňový doklad. %>
  <% if (!zalohove) { %>
  <div class="page-header-akce">
    <a href="/ucetnictvi/vydane-faktury/export.csv" class="btn btn-outline btn-sm">↓ CSV</a>
    <button class="btn btn-primary" data-modal-open="modalCreate">+ Nová faktura</button>
  </div>
  <% } %>
</div>

<%- include('../../includes/zalozky', { nazev: 'Druh faktur', zalozky, tab: typ, adresa: adresaZalozky }) %>

<% if (!zalohove) { %>
<!-- Bulk action bar -->
<div id="bulkBar" class="hromadna-lista" style="display:none;">
  <strong id="bulkCount"></strong>
  <span id="bulkSplit"></span>
  <span class="sekundarni" style="margin-right:auto;">Výběr platí jen pro tuto stránku<%= strany.pocetStran > 1 ? ` (${strany.strana} z ${strany.pocetStran})` : '' %>. Na víc dokladů najednou zvětšete počet řádků na stránku.</span>
  <form id="bulkPohodaForm" method="post" action="/ucetnictvi/vydane-faktury/pohoda-xml" style="display:inline;" target="_blank">
    <div id="bulkInputs"></div>
    <button type="submit" class="btn btn-primary btn-sm">↓ Export POHODA XML</button>
  </form>
  <button type="button" class="btn btn-ghost btn-sm" onclick="bulkClearAll()">Zrušit výběr</button>
</div>
<% } %>

<form method="get" class="filtr-lista">
  <% if (strany.vlastniVelikost) { %><input type="hidden" name="velikost" value="<%= strany.naStranku %>"><% } %>
  <% if (zalohove) { %><input type="hidden" name="typ" value="zalohove"><% } %>
  <%- include('../../includes/filtr-dokladu', { filtr, hledatPopisek: 'Hledat číslo, klienta, IČO, částku…', dodavatelPopisek: 'Klient', dodavatele: klienti }) %>
  <select name="status" class="form-select" aria-label="Stav">
    <option value="">Všechny stavy</option>
    <% STATUSES_ISSUED.forEach(s => { %><option value="<%= s %>" <%= statusFilter===s?'selected':'' %>><%= s %></option><% }) %>
  </select>
  <button type="submit" class="btn btn-outline">Filtrovat</button>
  <% if (sFiltrem) { %><a href="<%= bezFiltru %>" class="btn btn-ghost">Zrušit filtr</a><% } %>
</form>

<div class="table-wrapper">
  <table class="data-table tesna">
    <thead>
      <tr>
        <% if (!zalohove) { %><th style="width:36px;"><input type="checkbox" id="bulkSelectAll" onchange="bulkToggleAll(this.checked)" title="Vybrat všechny na této stránce" aria-label="Vybrat všechny na této stránce"></th><% } %>
        <th>Číslo</th><th>Klient</th><th class="hide-mobile">Vystavení</th><th class="hide-mobile">Splatnost</th>
        <th class="num hide-mobile">Základ</th><th class="num mobil">Celkem</th>
        <th>Doklad</th><th class="hide-mobile">Zdroj</th><th class="hide-mobile">POHODA</th><th class="mobil">Stav</th>
      </tr>
    </thead>
    <tbody>
      <% if (invoices.length > 0) { %>
        <% invoices.forEach(inv => { %>
        <tr data-href="/ucetnictvi/vydane-faktury/<%= inv.id %>">
          <% if (!zalohove) { %>
          <td data-bez-prokliku>
            <input type="checkbox" class="bulk-cb" value="<%= inv.id %>" onchange="bulkUpdate()" aria-label="Vybrat fakturu <%= inv.number %>"
                   data-exported="<%= inv.pohoda_v_evidenci || inv.pohoda_exported_at ? '1' : '' %>">
          </td>
          <% } %>
          <td class="mono">
            <a href="/ucetnictvi/vydane-faktury/<%= inv.id %>" class="radek-odkaz"><%= inv.number %></a>
          </td>
          <td><span class="radek-text" title="<%= inv.client_name || '' %>"><%= inv.client_name || '–' %></span></td>
          <td class="mono sekundarni hide-mobile"><%= ceskeDatum(inv.issue_date) %></td>
          <td class="mono sekundarni hide-mobile"><% if (inv.due_date && inv.status === 'Po splatnosti') { %><span class="pole-varovani"><%= ceskeDatum(inv.due_date) %></span><% } else { %><%= inv.due_date ? ceskeDatum(inv.due_date) : '–' %><% } %></td>
          <td class="num hide-mobile"><%= castka(inv.amount) %></td>
          <td class="num mobil"><%= castka(inv.total_amount) %> <%= inv.currency %></td>
          <td data-bez-prokliku>
            <a href="/ucetnictvi/vydane-faktury/<%= inv.id %>/pdf" class="doklad-thumb" style="width:28px;height:28px;"
               data-nahled
               data-nahled-nazev="faktura-<%= inv.number %>.pdf"
               data-nahled-typ="application/pdf"
               title="Zobrazit PDF faktury">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </a>
          </td>
          <td class="sekundarni hide-mobile"><%= zdrojDokladu(inv) %></td>
          <td class="hide-mobile"><%- include('../../includes/pohoda-stav', { doklad: inv }) %></td>
          <td class="mobil"><span class="badge badge-<%= tonStavu(inv.status) %>"><%= inv.status %></span></td>
        </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="<%= zalohove ? 10 : 11 %>">
          <div class="prazdno">
            <% if (sFiltrem) { %>
              <strong>Filtru neodpovídá žádná faktura</strong>
              <a href="<%= bezFiltru %>" class="btn btn-outline btn-sm">Zrušit filtr</a>
            <% } else if (zalohove) { %>
              <strong>Zatím žádné zálohové faktury</strong>
              Vznikají samy u objednávek s platbou převodem.
            <% } else { %>
              <strong>Zatím žádné vydané faktury</strong>
              Vznikají z objednávek, další založíte tlačítkem Nová faktura.
            <% } %>
          </div>
        </td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../../includes/strankovani', { strany }) %>

<% if (!zalohove) { %>
<script>
function bulkUpdate() {
  const cbs = document.querySelectorAll('.bulk-cb:checked');
  const bar = document.getElementById('bulkBar');
  const inp = document.getElementById('bulkInputs');
  document.getElementById('bulkCount').textContent = `${cbs.length} vybráno`;
  inp.innerHTML = [...cbs].map(c => `<input type="hidden" name="ids" value="${c.value}">`).join('');

  // Opakovaný import založí doklad v POHODĚ znovu – ať to není překvapení
  const exported = [...cbs].filter(c => c.dataset.exported).length;
  document.getElementById('bulkSplit').textContent = exported
    ? `⚠ ${exported} už v POHODĚ je nebo se exportovalo, import ho založí znovu` : '';
  bar.style.display = cbs.length > 0 ? 'flex' : 'none';
  const allCbs = document.querySelectorAll('.bulk-cb');
  document.getElementById('bulkSelectAll').checked = cbs.length === allCbs.length && allCbs.length > 0;
  document.getElementById('bulkSelectAll').indeterminate = cbs.length > 0 && cbs.length < allCbs.length;
}
function bulkToggleAll(checked) {
  document.querySelectorAll('.bulk-cb').forEach(c => c.checked = checked);
  bulkUpdate();
}
function bulkClearAll() {
  document.querySelectorAll('.bulk-cb').forEach(c => c.checked = false);
  document.getElementById('bulkSelectAll').checked = false;
  bulkUpdate();
}
// Prohlížeč po návratu tlačítkem Zpět vrátí zaškrtnutí, lišta musí sedět s nimi.
window.addEventListener('pageshow', bulkUpdate);
</script>

<!-- Modal: Nová faktura -->
<div id="modalCreate" class="modal-backdrop">
  <div class="modal">
    <div class="modal-header">
      <h2 class="modal-title">Nová vydaná faktura</h2>
      <button type="button" class="modal-close" data-modal-close="modalCreate" aria-label="Zavřít">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <% if (formError) { %>
    <div class="hlaska hlaska-chyba" style="margin:16px 24px 0;"><%= formError %></div>
    <% } %>
    <%# Bez flexu by .modal-body neroloval a patička s tlačítkem by zůstala oříznutá pod okrajem okna. %>
    <form method="post" action="/ucetnictvi/vydane-faktury/vytvorit" style="display:flex;flex-direction:column;min-height:0;">
      <div class="modal-body" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <div class="form-group" style="grid-column:1/-1;">
          <label class="form-label">Číselná řada</label>
          <select name="series_id" class="form-select">
            <option value="">– Zadat číslo ručně –</option>
            <% series.forEach(s => { %>
            <option value="<%= s.id %>"><%= s.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group" style="grid-column:1/-1;">
          <label class="form-label">Číslo faktury (pokud nezvolíte řadu)</label>
          <input type="text" name="number" class="form-control" placeholder="FV-2026-0001">
        </div>
        <div class="form-group" style="grid-column:1/-1;">
          <label class="form-label">Klient *</label>
          <input type="text" name="client_name" class="form-control" required placeholder="Název firmy nebo jméno">
        </div>
        <div class="form-group">
          <label class="form-label">IČO klienta</label>
          <input type="text" name="client_ico" class="form-control">
        </div>
        <div class="form-group">
          <label class="form-label">DIČ klienta</label>
          <input type="text" name="client_dic" class="form-control">
        </div>
        <div class="form-group" style="grid-column:1/-1;">
          <label class="form-label">Adresa klienta</label>
          <input type="text" name="client_address" class="form-control">
        </div>
        <div class="form-group" style="grid-column:1/-1;">
          <label class="form-label">E-mail klienta</label>
          <input type="email" name="client_email" class="form-control" placeholder="pro odeslání faktury">
        </div>

        <%- include('../../includes/invoice-items', { items: [] }) %>

        <div class="form-group">
          <label class="form-label">Datum vystavení</label>
          <input type="date" name="issue_date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
        </div>
        <div class="form-group">
          <label class="form-label">Datum splatnosti</label>
          <input type="date" name="due_date" class="form-control">
        </div>
        <div class="form-group" style="grid-column:1/-1;">
          <label class="form-label">Poznámka</label>
          <textarea name="notes" class="form-control" rows="2"></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Předkontace MD</label>
          <input type="text" name="account_debit" class="form-control ac-account" placeholder="např. 311" list="acList" autocomplete="off">
        </div>
        <div class="form-group">
          <label class="form-label">Předkontace D</label>
          <input type="text" name="account_credit" class="form-control ac-account" placeholder="např. 604" list="acList" autocomplete="off">
        </div>
      </div>
      <datalist id="acList"></datalist>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" data-modal-close="modalCreate">Zrušit</button>
        <button type="submit" class="btn btn-primary">Vytvořit fakturu</button>
      </div>
    </form>
  </div>
</div>

<script>
// Otevírání a zavírání modalu (data-modal-open, data-modal-close) obsluhuje app.js.
// Po odmítnutí serverem otevři formulář rovnou i s chybovou hláškou
<% if (formError) { %>
document.getElementById('modalCreate').classList.add('open');
document.body.style.overflow = 'hidden';
<% } %>
// Předkontace autocomplete
fetch('/api/accounting-chart').then(r => r.json()).then(list => {
  const dl = document.getElementById('acList');
  if (dl) dl.innerHTML = list.map(a => `<option value="${a.code}">${a.code} – ${a.name}</option>`).join('');
}).catch(() => {});
</script>
<% } %>
