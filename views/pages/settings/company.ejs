<%
  // Režim úprav (src/upravy.js): jeden formulář přes všech pět karet, tužka
  // v hlavičce je proto vždy; bez JS otevře úpravy ?upravit=1.
  const formular = 'formNastaveniFirmy';
  const rezim = rezimUprav ? 'upravy' : 'zobrazeni';
  const urlZpet = '/nastaveni/firma';
%>
<div class="detail" data-rezim="<%= rezim %>">
<div class="page-header">
  <div class="page-header-left">
    <h1>Nastavení firmy</h1>
    <p>Fakturační údaje zobrazované na vydaných fakturách</p>
  </div>
  <div class="page-header-akce">
    <%- include('../../includes/upravit', { formular, urlUpravit: `${urlZpet}?upravit=1`, urlZpet }) %>
  </div>
</div>

<% if (saved) { %>
<div data-hlaska class="alert alert-success jen-zobrazeni" style="background:#dcfce7;color:#166534;border:1px solid #bbf7d0;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
  ✓ Nastavení uloženo
</div>
<% } %>

<div style="max-width:720px;">
<form method="post" action="/nastaveni/firma" id="<%= formular %>" class="upravitelne">

  <div class="card" style="margin-bottom:20px;">
    <div class="card-header"><strong>Základní údaje</strong></div>
    <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
      <%- include('../../includes/pole', { pole: { label: 'Název firmy', name: 'name', value: company.name, required: true, styl: 'grid-column:1/-1' } }) %>
      <%- include('../../includes/pole', { pole: { label: 'IČO', name: 'ico', value: company.ico, maxlength: 20 } }) %>
      <%- include('../../includes/pole', { pole: { label: 'DIČ', name: 'dic', value: company.dic, maxlength: 20 } }) %>
      <%- include('../../includes/pole', { pole: { label: 'Ulice a číslo popisné', name: 'address', value: company.address, styl: 'grid-column:1/-1' } }) %>
      <%- include('../../includes/pole', { pole: { label: 'Město', name: 'city', value: company.city } }) %>
      <%- include('../../includes/pole', { pole: { label: 'PSČ', name: 'zip', value: company.zip } }) %>
      <%- include('../../includes/pole', { pole: { label: 'Stát', name: 'country', value: company.country, vychozi: 'Česká republika', styl: 'grid-column:1/-1' } }) %>
      <%- include('../../includes/pole', { pole: { label: 'Telefon', name: 'phone', typ: 'tel', value: company.phone } }) %>
      <%- include('../../includes/pole', { pole: { label: 'E-mail', name: 'email', typ: 'email', value: company.email } }) %>
    </div>
  </div>

  <div class="card" style="margin-bottom:20px;">
    <div class="card-header"><strong>Bankovní spojení</strong></div>
    <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
      <%- include('../../includes/pole', { pole: { label: 'Číslo účtu', name: 'bank_account', value: company.bank_account, placeholder: '2800828200/2010' } }) %>
      <%- include('../../includes/pole', { pole: { label: 'Název banky', name: 'bank_name', value: company.bank_name, placeholder: 'Fio banka' } }) %>
      <%- include('../../includes/pole', { pole: { label: 'IBAN', name: 'iban', value: company.iban, placeholder: 'CZ...' } }) %>
      <%- include('../../includes/pole', { pole: { label: 'SWIFT/BIC', name: 'swift', value: company.swift, placeholder: 'FIOBCZPPXXX' } }) %>
    </div>
  </div>

  <div class="card" style="margin-bottom:20px;">
    <div class="card-header"><strong>Fakturace</strong></div>
    <div class="card-body" style="display:grid;grid-template-columns:1fr;gap:16px;">
      <%- include('../../includes/pole', { pole: { label: 'DPH', name: 'vat_payer', typ: 'checkbox', value: company.vat_payer, hodnotaVstupu: 'on',
        popisek: 'Plátce DPH', zobraz: company.vat_payer ? 'Plátce DPH' : 'Neplátce DPH' } }) %>
      <%- include('../../includes/pole', { pole: { label: 'Poznámka na faktuře', name: 'invoice_note', typ: 'textarea', rows: 2, value: company.invoice_note, placeholder: 'Např. Nejsme plátci DPH.' } }) %>
    </div>
  </div>

  <div class="card" style="margin-bottom:20px;">
    <div class="card-header"><strong>Export do POHODY</strong></div>
    <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">

      <div class="form-group jen-upravy" style="grid-column:1/-1;">
        <p style="font-size:13px;color:var(--text-muted);margin:0;">
          Účetní jednotku určuje IČO výše – musí přesně odpovídat IČO účetní jednotky
          otevřené v POHODĚ, jinak import balíček odmítne.
        </p>
      </div>

      <%- include('../../includes/pole', { pole: { label: 'Pokladna v POHODĚ', name: 'pohoda_cash_account', value: company.pohoda_cash_account || 'Pokladna', maxlength: 20, placeholder: 'Pokladna',
        hint: 'Přesný název pokladny z agendy Pokladna, kam se účtenky naimportují.' } }) %>
      <%- include('../../includes/pole', { pole: { label: 'Předkontace účtenek v pokladně', name: 'pohoda_predkontace', value: company.pohoda_predkontace, maxlength: 20, placeholder: 'např. 3Vd',
        hint: 'Volitelné. Prázdné = POHODA nastaví „Nevím“.' } }) %>
      <%- include('../../includes/pole', { pole: { label: 'Předkontace přijatých faktur a závazků', name: 'pohoda_predkontace_prijate', value: company.pohoda_predkontace_prijate, maxlength: 20, placeholder: 'např. 1Pf',
        hint: 'Pro přijaté faktury a účtenky placené kartou nebo převodem (agenda Ostatní závazky). Předkontace z dokladu má přednost.' } }) %>
      <%- include('../../includes/pole', { pole: { label: 'Předkontace bez nároku na odpočet DPH', name: 'pohoda_predkontace_repre', value: company.pohoda_predkontace_repre, maxlength: 20, placeholder: 'např. 513Repre',
        hint: 'Doklady na reprezentaci (§ 72 odst. 4 ZDPH) jdou do exportu s členěním „Nezahrnovat do DPH“ v plné výši včetně DPH; tahle předkontace je přebije, typicky na 513.' } }) %>

      <div class="form-group" style="grid-column:1/-1;">
        <p style="font-size:13px;color:var(--text-muted);margin:0;padding:10px 12px;background:var(--bg-page);border-radius:var(--radius-sm);">
          <strong>Kam který doklad spadne:</strong> účtenka placená hotově → Pokladna ·
          účtenka placená kartou nebo převodem → Ostatní závazky ·
          přijatá faktura → Přijaté faktury · vydaná faktura → Vydané faktury.
          Evidenční čísla přijatých dokladů přiděluje POHODA z vlastních číselných řad,
          číslo od dodavatele jde do pole Doklad.
        </p>
      </div>

    </div>
  </div>

  <div class="card" style="margin-bottom:20px;">
    <div class="card-header"><strong>Google Disk – přijaté faktury</strong></div>
    <div class="card-body" style="display:grid;grid-template-columns:1fr;gap:16px;">
      <%- include('../../includes/pole', { pole: { label: 'ID složky „SEIL - účetnictví“', name: 'gdrive_root_folder_id', value: company.gdrive_root_folder_id, placeholder: '1AbCdEf…',
        hint: 'ID je v adrese složky na Google Disku: drive.google.com/drive/folders/ID. Uvnitř se očekává struktura rok → měsíc → Přijaté faktury. Složku nasdílejte service accountu (proměnná GOOGLE_SERVICE_ACCOUNT_JSON) s právem Čtenář.' } }) %>
    </div>
  </div>

  <%- include('../../includes/upravit', { paticka: true, formular, urlZpet }) %>

</form>
</div>
</div>
