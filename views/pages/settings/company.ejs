<div class="page-header">
  <div class="page-header-left">
    <h1>Nastavení firmy</h1>
    <p>Fakturační údaje zobrazované na vydaných fakturách</p>
  </div>
</div>

<% if (saved) { %>
<div class="alert alert-success" style="background:#dcfce7;color:#166534;border:1px solid #bbf7d0;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
  ✓ Nastavení uloženo
</div>
<% } %>

<div style="max-width:720px;">
<form method="post" action="/nastaveni/firma">

  <div class="card" style="margin-bottom:20px;">
    <div class="card-header"><strong>Základní údaje</strong></div>
    <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">

      <div class="form-group" style="grid-column:1/-1;">
        <label class="form-label">Název firmy *</label>
        <input type="text" name="name" value="<%= company.name || '' %>" class="form-control" required>
      </div>

      <div class="form-group">
        <label class="form-label">IČO</label>
        <input type="text" name="ico" value="<%= company.ico || '' %>" class="form-control" maxlength="20">
      </div>

      <div class="form-group">
        <label class="form-label">DIČ</label>
        <input type="text" name="dic" value="<%= company.dic || '' %>" class="form-control" maxlength="20">
      </div>

      <div class="form-group" style="grid-column:1/-1;">
        <label class="form-label">Ulice a číslo popisné</label>
        <input type="text" name="address" value="<%= company.address || '' %>" class="form-control">
      </div>

      <div class="form-group">
        <label class="form-label">Město</label>
        <input type="text" name="city" value="<%= company.city || '' %>" class="form-control">
      </div>

      <div class="form-group">
        <label class="form-label">PSČ</label>
        <input type="text" name="zip" value="<%= company.zip || '' %>" class="form-control">
      </div>

      <div class="form-group" style="grid-column:1/-1;">
        <label class="form-label">Stát</label>
        <input type="text" name="country" value="<%= company.country || 'Česká republika' %>" class="form-control">
      </div>

      <div class="form-group">
        <label class="form-label">Telefon</label>
        <input type="text" name="phone" value="<%= company.phone || '' %>" class="form-control">
      </div>

      <div class="form-group">
        <label class="form-label">E-mail</label>
        <input type="email" name="email" value="<%= company.email || '' %>" class="form-control">
      </div>

    </div>
  </div>

  <div class="card" style="margin-bottom:20px;">
    <div class="card-header"><strong>Bankovní spojení</strong></div>
    <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">

      <div class="form-group">
        <label class="form-label">Číslo účtu</label>
        <input type="text" name="bank_account" value="<%= company.bank_account || '' %>" class="form-control" placeholder="2800828200/2010">
      </div>

      <div class="form-group">
        <label class="form-label">Název banky</label>
        <input type="text" name="bank_name" value="<%= company.bank_name || '' %>" class="form-control" placeholder="Fio banka">
      </div>

      <div class="form-group">
        <label class="form-label">IBAN</label>
        <input type="text" name="iban" value="<%= company.iban || '' %>" class="form-control" placeholder="CZ...">
      </div>

      <div class="form-group">
        <label class="form-label">SWIFT/BIC</label>
        <input type="text" name="swift" value="<%= company.swift || '' %>" class="form-control" placeholder="FIOBCZPPXXX">
      </div>

    </div>
  </div>

  <div class="card" style="margin-bottom:20px;">
    <div class="card-header"><strong>Fakturace</strong></div>
    <div class="card-body" style="display:grid;grid-template-columns:1fr;gap:16px;">

      <div class="form-group">
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
          <input type="checkbox" name="vat_payer" value="on" <%= company.vat_payer ? 'checked' : '' %>>
          <span>Plátce DPH</span>
        </label>
      </div>

      <div class="form-group">
        <label class="form-label">Poznámka na faktuře</label>
        <textarea name="invoice_note" class="form-control" rows="2" placeholder="Např. Nejsme plátci DPH."><%= company.invoice_note || '' %></textarea>
      </div>

    </div>
  </div>

  <div class="card" style="margin-bottom:20px;">
    <div class="card-header"><strong>Export do POHODY</strong></div>
    <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">

      <div class="form-group" style="grid-column:1/-1;">
        <p style="font-size:13px;color:var(--text-muted);margin:0;">
          Účetní jednotku určuje IČO výše — musí přesně odpovídat IČO účetní jednotky
          otevřené v POHODĚ, jinak import balíček odmítne.
        </p>
      </div>

      <div class="form-group">
        <label class="form-label">Pokladna v POHODĚ</label>
        <input type="text" name="pohoda_cash_account" value="<%= company.pohoda_cash_account || 'Pokladna' %>" class="form-control" maxlength="20" placeholder="Pokladna">
        <small style="color:var(--text-muted);">Přesný název pokladny z agendy Pokladna, kam se účtenky naimportují.</small>
      </div>

      <div class="form-group">
        <label class="form-label">Předkontace účtenek v pokladně</label>
        <input type="text" name="pohoda_predkontace" value="<%= company.pohoda_predkontace || '' %>" class="form-control" maxlength="20" placeholder="např. 3Vd">
        <small style="color:var(--text-muted);">Volitelné. Prázdné = POHODA nastaví „Nevím“.</small>
      </div>

      <div class="form-group">
        <label class="form-label">Předkontace přijatých faktur a závazků</label>
        <input type="text" name="pohoda_predkontace_prijate" value="<%= company.pohoda_predkontace_prijate || '' %>" class="form-control" maxlength="20" placeholder="např. 1Pf">
        <small style="color:var(--text-muted);">
          Použije se u přijatých faktur a u účtenek placených kartou nebo převodem,
          které jdou do agendy Ostatní závazky. Předkontace z dokladu má přednost.
        </small>
      </div>

      <div class="form-group">
        <label class="form-label">Předkontace bez nároku na odpočet DPH</label>
        <input type="text" name="pohoda_predkontace_repre" value="<%= company.pohoda_predkontace_repre || '' %>" class="form-control" maxlength="20" placeholder="např. 513Repre">
        <small style="color:var(--text-muted);">
          Doklady na reprezentaci (§ 72 odst. 4 ZDPH) jdou do exportu s členěním DPH
          „Nezahrnovat do DPH“ a v plné výši včetně DPH. Tahle předkontace je přebije,
          typicky na 513.
        </small>
      </div>

      <div class="form-group" style="grid-column:1/-1;">
        <p style="font-size:13px;color:var(--text-muted);margin:0;padding:10px 12px;background:var(--bg-page);border-radius:var(--radius-sm);">
          <strong>Kam který doklad spadne:</strong> účtenka placená hotově → Pokladna ·
          účtenka placená kartou nebo převodem → Ostatní závazky ·
          přijatá faktura → Přijaté faktury · vydaná faktura → Vydané faktury.
          Evidenční čísla přijatých dokladů přiděluje POHODA z vlastních číselných řad,
          číslo od dodavatele jde do pole Doklad.
        </p>
      </div>

    </div>
  </div>

  <div class="card" style="margin-bottom:20px;">
    <div class="card-header"><strong>Google Disk — přijaté faktury</strong></div>
    <div class="card-body" style="display:grid;grid-template-columns:1fr;gap:16px;">

      <div class="form-group">
        <label class="form-label">ID složky „SEIL - účetnictví“</label>
        <input type="text" name="gdrive_root_folder_id" value="<%= company.gdrive_root_folder_id || '' %>" class="form-control" placeholder="1AbCdEf…">
        <small style="color:var(--text-muted);">
          ID najdete v URL složky na Google Disku: <code>drive.google.com/drive/folders/<strong>ID</strong></code>.
          Uvnitř se očekává struktura rok → měsíc → Přijaté faktury.
          Složku nasdílejte service accountu (viz proměnná <code>GOOGLE_SERVICE_ACCOUNT_JSON</code>) s právem Čtenář.
        </small>
      </div>

    </div>
  </div>

  <button type="submit" class="btn btn-primary">Uložit nastavení</button>

</form>
</div>
