<div class="page-header">
  <div class="page-header-left">
    <h1><a href="/nastaveni/eshopy" style="color:var(--text-muted);text-decoration:none;">Eshopy</a> / <%= shop.name %></h1>
    <p><%= shop.url || '—' %> · <code style="background:var(--gray-100);padding:2px 6px;border-radius:4px;font-size:12px;"><%= shop.slug %></code></p>
  </div>
  <button class="btn btn-primary" data-modal-open="modalAddCheck">+ Healthcheck</button>
</div>

<% if (saved) { %>
<div class="alert alert-success" style="background:#dcfce7;color:#166534;border:1px solid #bbf7d0;padding:12px 16px;border-radius:8px;margin-bottom:20px;">✓ Uloženo</div>
<% } %>

<% if (typeof error !== 'undefined' && error === 'firemni-adresa') { %>
<div style="background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
  Odesílatel e-shopu nesmí být na doméně <code>seil.cz</code> — zákazník by dostal e-mail od firmy, kterou nezná.
</div>
<% } %>

<% if (typeof error !== 'undefined' && error === 'sklad-email') { %>
<div style="background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
  Adresa skladu není platný e-mail.
</div>
<% } %>

<% if (typeof error !== 'undefined' && error === 'sklad-kopie') { %>
<div style="background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
  Adresa pro skrytou kopii není platný e-mail.
</div>
<% } %>

<% if (typeof error !== 'undefined' && error === 'sklad-datum') { %>
<div style="background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
  Datum „posílat objednávky přijaté od" musí být ve tvaru RRRR-MM-DD.
</div>
<% } %>

<% if (newKey) { %>
<div style="background:#fef9c3;border:1px solid #fde047;border-radius:8px;padding:16px;margin-bottom:20px;">
  <strong>Nový API klíč (zobrazí se pouze jednou!):</strong><br>
  <code style="font-family:var(--font-mono);font-size:14px;word-break:break-all;display:block;margin-top:8px;padding:8px;background:white;border-radius:4px;border:1px solid #e5e7eb;"><%= newKey %></code>
</div>
<% } %>

<% if (typeof error !== 'undefined' && error === 'webhook-secret') { %>
<div style="background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
  Tajemství pro podání balíku musí mít aspoň 32 znaků a žádnou mezeru.
</div>
<% } %>

<% if (typeof error !== 'undefined' && error === 'eshop-klic-toneracek') { %>
<div style="background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
  Toneráček má vlastní API (<code>/api/toneracek</code>, klíč v <code>TONERACEK_API_KEY</code>) — klíč pro <code>/api/eshop</code> se mu nevydává.
</div>
<% } %>

<% if (novyEshopKlic) { %>
<div style="background:#fef9c3;border:1px solid #fde047;border-radius:8px;padding:16px;margin-bottom:20px;">
  <strong>Nový klíč pro <code>/api/eshop</code><%= novyEshopKlic.label ? ' — ' + novyEshopKlic.label : '' %> (zobrazí se pouze jednou!):</strong><br>
  <code style="font-family:var(--font-mono);font-size:14px;word-break:break-all;display:block;margin-top:8px;padding:8px;background:white;border-radius:4px;border:1px solid #e5e7eb;"><%= novyEshopKlic.klic %></code>
  <small style="color:var(--text-muted);">Vložte ho do prostředí e-shopu jako <code>SEIL_API_KEY</code>. One SEIL si drží jen otisk <code><%= novyEshopKlic.otisk %></code> — klíč už znovu ukázat nejde, jen vydat nový.</small>
</div>
<% } %>

<% if (novyWebhookSecret) { %>
<div style="background:#fef9c3;border:1px solid #fde047;border-radius:8px;padding:16px;margin-bottom:20px;">
  <strong>Nové tajemství pro podání balíku (zobrazí se pouze jednou!):</strong><br>
  <code style="font-family:var(--font-mono);font-size:14px;word-break:break-all;display:block;margin-top:8px;padding:8px;background:white;border-radius:4px;border:1px solid #e5e7eb;"><%= novyWebhookSecret %></code>
  <small style="color:var(--text-muted);">Vložte ho do prostředí e-shopu jako <code>WEBHOOK_SECRET</code>. Do té doby e-shop podání balíku odmítne.</small>
</div>
<% } %>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:24px;">

  <div style="display:flex;flex-direction:column;gap:20px;">

    <!-- Identita e-mailů -->
    <div class="card">
      <div class="card-header">Identita e-mailů</div>
      <div class="card-body">
        <p style="font-size:13px;color:var(--text-muted);margin:0 0 16px;">
          Odsud se berou odesílatel, barvy a kontakty ve všech e-mailech, které
          tomuhle e-shopu chodí zákazníkům — potvrzení objednávky, faktura
          i storno. Zákazník nemá poznat, že část z nich odesílá One SEIL.
        </p>

        <% if (!shop.email_from_address || !shop.email_from_name) { %>
        <div style="background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13px;">
          <strong>Identita není vyplněná.</strong> Dokud tu nebude odesílatel,
          zákaznické e-maily tohohle e-shopu se neodešlou — raději nic než
          zpráva od cizí firmy.
        </div>
        <% } %>

        <form method="post" action="/nastaveni/eshopy/<%= shop.id %>/identita">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
            <div class="form-group">
              <label class="form-label required">Odesílatel — jméno</label>
              <input type="text" name="email_from_name" class="form-control" value="<%= shop.email_from_name %>" placeholder="Toneráček.cz" required>
            </div>
            <div class="form-group">
              <label class="form-label required">Odesílatel — adresa</label>
              <input type="email" name="email_from_address" class="form-control" value="<%= shop.email_from_address %>" placeholder="noreply@toneracek.cz" required>
            </div>
            <div class="form-group">
              <label class="form-label">Odpovědi na</label>
              <input type="email" name="email_reply_to" class="form-control" value="<%= shop.email_reply_to %>" placeholder="ahoj@toneracek.cz">
            </div>
            <div class="form-group">
              <label class="form-label">Kontaktní e-mail</label>
              <input type="email" name="support_email" class="form-control" value="<%= shop.support_email %>" placeholder="ahoj@toneracek.cz">
            </div>
            <div class="form-group">
              <label class="form-label">Telefon (zobrazený)</label>
              <input type="text" name="support_phone" class="form-control" value="<%= shop.support_phone %>" placeholder="728 749 931">
            </div>
            <div class="form-group">
              <label class="form-label">Telefon (odkaz tel:)</label>
              <input type="text" name="support_phone_link" class="form-control" value="<%= shop.support_phone_link %>" placeholder="+420728749931">
            </div>
            <div class="form-group">
              <label class="form-label">Podtitul v hlavičce</label>
              <input type="text" name="tagline" class="form-control" value="<%= shop.tagline %>" placeholder="Správná náplň pro vaši tiskárnu">
            </div>
            <div class="form-group">
              <label class="form-label">Claim v patičce</label>
              <input type="text" name="claim" class="form-control" value="<%= shop.claim %>" placeholder="Nenechte tiskárnu žíznit">
            </div>
            <div class="form-group" style="grid-column:1 / -1;">
              <label class="form-label">Logo v hlavičce (URL)</label>
              <input type="url" name="logo_mark_url" class="form-control" value="<%= shop.logo_mark_url %>">
            </div>
            <div class="form-group" style="grid-column:1 / -1;">
              <label class="form-label">Logo v patičce (URL)</label>
              <input type="url" name="logo_wordmark_url" class="form-control" value="<%= shop.logo_wordmark_url %>">
            </div>
            <div class="form-group">
              <label class="form-label">Hlavní barva</label>
              <input type="text" name="color_primary" class="form-control" value="<%= shop.color_primary %>" placeholder="#0891b2">
            </div>
            <div class="form-group">
              <label class="form-label">Přechod — tmavší</label>
              <input type="text" name="color_primary_dark" class="form-control" value="<%= shop.color_primary_dark %>" placeholder="#0e7490">
            </div>
            <div class="form-group">
              <label class="form-label">Přechod — světlejší</label>
              <input type="text" name="color_primary_light" class="form-control" value="<%= shop.color_primary_light %>" placeholder="#06b6d4">
            </div>
            <div class="form-group">
              <label class="form-label">Podtitul na barvě</label>
              <input type="text" name="color_on_primary_soft" class="form-control" value="<%= shop.color_on_primary_soft %>" placeholder="#cffafe">
            </div>
          </div>
          <div style="display:flex;gap:10px;align-items:center;margin-top:14px;">
            <button type="submit" class="btn btn-primary">Uložit identitu</button>
            <a href="/nastaveni/eshopy/<%= shop.id %>/nahled-emailu" target="_blank" class="btn">Náhled e-mailu</a>
          </div>
        </form>
      </div>
    </div>

    <!-- Napojení e-shopu: klíče pro /api/eshop a tajemství pro podání balíku -->
    <div class="card">
      <div class="card-header">Napojení e-shopu (<code>/api/eshop</code>)</div>
      <div class="card-body">
        <% if (vydavaEshopKlice) { %>
        <p style="font-size:13px;color:var(--text-muted);margin:0 0 16px;">
          E-shop volá One SEIL na <code>/api/eshop/*</code> s hlavičkou
          <code>Authorization: Bearer &lt;klíč&gt;</code>. Klíč určuje e-shop:
          objednávky, doklady i zákaznické účty vidí jen ty svoje. Vypnutý
          klíč přestane platit okamžitě.
        </p>

        <table class="data-table" style="font-size:13px;margin-bottom:14px;">
          <thead><tr><th>Popis</th><th>Otisk</th><th>Vytvořen</th><th>Naposledy použit</th><th>Stav</th><th></th></tr></thead>
          <tbody>
            <% eshopKlice.forEach(k => { %>
            <tr>
              <td><%= k.label || '—' %><% if (k.vytvoril) { %><br><span style="font-size:11px;color:var(--text-muted);"><%= k.vytvoril %></span><% } %></td>
              <td><code style="background:var(--gray-100);padding:2px 6px;border-radius:4px;font-size:12px;"><%= k.otisk %></code></td>
              <td style="color:var(--text-muted);"><%= new Date(k.created_at).toLocaleString('cs-CZ') %></td>
              <td style="color:var(--text-muted);"><%= k.last_used_at ? new Date(k.last_used_at).toLocaleString('cs-CZ') : 'nikdy' %></td>
              <td>
                <% if (k.active) { %><span class="badge" style="background:#dcfce7;color:#166534;">Aktivní</span>
                <% } else { %><span class="badge" style="background:var(--gray-100);color:var(--gray-500);" title="<%= k.revoked_at ? 'Zrušen ' + new Date(k.revoked_at).toLocaleString('cs-CZ') : '' %>">Zrušený</span><% } %>
              </td>
              <td>
                <% if (k.active) { %>
                <form method="post" action="/nastaveni/eshopy/<%= shop.id %>/eshop-klic/<%= k.id %>/zrusit" style="display:inline;"
                      onsubmit="return confirm('Zrušit klíč? E-shop, který ho používá, okamžitě přestane fungovat.')">
                  <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);">Zrušit</button>
                </form>
                <% } %>
              </td>
            </tr>
            <% }) %>
            <% if (!eshopKlice.length) { %>
            <tr><td colspan="6" style="text-align:center;padding:20px;color:var(--text-muted);">Žádný klíč — e-shop se k One SEIL zatím nepřipojí.</td></tr>
            <% } %>
          </tbody>
        </table>

        <form method="post" action="/nastaveni/eshopy/<%= shop.id %>/eshop-klic/vytvorit" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin-bottom:24px;">
          <div class="form-group" style="flex:1;min-width:220px;margin:0;">
            <label class="form-label">Popis klíče</label>
            <input type="text" name="label" class="form-control" maxlength="100" placeholder="produkce (Coolify)">
          </div>
          <button type="submit" class="btn btn-outline">Vygenerovat klíč</button>
        </form>
        <% } else { %>
        <p style="font-size:13px;color:var(--text-muted);margin:0 0 20px;">
          Toneráček jede přes <code>/api/toneracek</code> s klíčem v proměnné
          <code>TONERACEK_API_KEY</code> a jeho zákaznické účty jsou v CRM
          kontaktech. Klíč pro <code>/api/eshop</code> se mu nevydává — založil
          by mu druhou, oddělenou sadu účtů.
        </p>
        <% } %>

        <div style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;">Tajemství pro podání balíku</div>
        <p style="font-size:13px;color:var(--text-muted);margin:0 0 12px;">
          One SEIL jím podepisuje žádost o podání balíku
          (<code><%= shop.url || 'URL e-shopu' %>/api/orders/podat-balik</code>, hlavička
          <code>x-webhook-secret</code>). V e-shopu musí být stejná hodnota
          v <code>WEBHOOK_SECRET</code>.
        </p>
        <p style="font-size:13px;margin:0 0 12px;">
          <% if (otiskWebhookSecret) { %>
            Vlastní tajemství e-shopu: <strong>nastaveno</strong>, otisk
            <code style="background:var(--gray-100);padding:2px 6px;border-radius:4px;font-size:12px;"><%= otiskWebhookSecret %></code>
            <span style="color:var(--text-muted);">(prvních 8 znaků SHA-256)</span>
          <% } else if (maGlobalniWebhookSecret) { %>
            Vlastní tajemství není — platí globální <code>SHOP_WEBHOOK_SECRET</code>.
          <% } else { %>
            <span style="color:#b91c1c;">Není nastavené vlastní ani globální <code>SHOP_WEBHOOK_SECRET</code> — balík se u převodu nepodá.</span>
          <% } %>
        </p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
          <form method="post" action="/nastaveni/eshopy/<%= shop.id %>/webhook-secret"
                onsubmit="return confirm('Vygenerovat nové tajemství? Dokud ho nevložíte do e-shopu, podání balíku selže.')">
            <input type="hidden" name="akce" value="vygenerovat">
            <button type="submit" class="btn btn-outline btn-sm">Vygenerovat nové</button>
          </form>
          <form method="post" action="/nastaveni/eshopy/<%= shop.id %>/webhook-secret" style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;">
            <input type="hidden" name="akce" value="nastavit">
            <input type="password" name="webhook_secret" class="form-control" minlength="32" autocomplete="off" placeholder="vložit vlastní (min. 32 znaků)" style="width:260px;">
            <button type="submit" class="btn btn-outline btn-sm">Uložit</button>
          </form>
          <% if (otiskWebhookSecret) { %>
          <form method="post" action="/nastaveni/eshopy/<%= shop.id %>/webhook-secret"
                onsubmit="return confirm('Smazat vlastní tajemství? Pak platí globální SHOP_WEBHOOK_SECRET.')">
            <input type="hidden" name="akce" value="vymazat">
            <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);">Použít globální</button>
          </form>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Expedice do skladu -->
    <div class="card">
      <div class="card-header">Expedice do skladu</div>
      <div class="card-body">
        <p style="font-size:13px;color:var(--text-muted);margin:0 0 16px;">
          Každý všední den v 6:00 pražského času odejde na tuhle adresu jeden
          e-mail se zaplacenými objednávkami, které sklad ještě nedostal, a se
          štítky Zásilkovny v příloze. Co se zaplatí v pátek po odeslání, jde
          v pondělí. Prázdná adresa znamená, že je expedice vypnutá.
        </p>

        <% if (shop.warehouse_email && (!maPacketaHeslo || !maWebhookSecret)) { %>
        <div style="background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13px;">
          <strong>Chybí přístupové údaje.</strong>
          <% if (!maPacketaHeslo) { %>Bez <code>PACKETA_API_PASSWORD</code> se nestáhnou štítky.<% } %>
          <% if (!maWebhookSecret) { %>Bez tajemství pro podání balíku (vlastního ani <code>SHOP_WEBHOOK_SECRET</code>) se u převodu nepodá balík.<% } %>
          Objednávky se v takovém případě jen zadrží a čekají na další ráno.
        </div>
        <% } %>

        <form method="post" action="/nastaveni/eshopy/<%= shop.id %>/expedice">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
            <div class="form-group">
              <label class="form-label">E-mail skladu</label>
              <input type="email" name="warehouse_email" class="form-control" value="<%= shop.warehouse_email %>" placeholder="sklad@dodavatel.cz">
              <small style="color:var(--text-muted);">Prázdné = expedice vypnutá.</small>
            </div>
            <div class="form-group">
              <label class="form-label">Skrytá kopie</label>
              <input type="email" name="warehouse_email_bcc" class="form-control" value="<%= shop.warehouse_email_bcc %>" placeholder="kontrola@seil.cz">
              <small style="color:var(--text-muted);">Dostane tentýž e-mail i se štítky. Skrytě, ať sklad neodpovídá oběma. Prázdné = bez kopie.</small>
            </div>
            <div class="form-group">
              <label class="form-label">Posílat objednávky přijaté od</label>
              <input type="date" name="warehouse_dispatch_since" class="form-control"
                     value="<%= shop.warehouse_dispatch_since ? new Date(shop.warehouse_dispatch_since).toISOString().slice(0,10) : '' %>">
              <small style="color:var(--text-muted);">Starší objednávky vyřídil sklad ručně, automat je nikdy nepošle.</small>
            </div>
          </div>
          <div style="margin-top:14px;">
            <button type="submit" class="btn btn-primary">Uložit expedici</button>
          </div>
        </form>

        <% if (expedice && expedice.length) { %>
        <div style="margin-top:20px;">
          <div style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;">Poslední běhy</div>
          <table class="data-table" style="font-size:13px;">
            <thead><tr><th>Kdy</th><th>Spustil</th><th>Stav</th></tr></thead>
            <tbody>
              <% expedice.forEach(b => { %>
              <%
                const stavStyl = {
                  odeslano: 'background:#dcfce7;color:#166534',
                  prazdno:  'background:#f1f5f9;color:#475569',
                  chyba:    'background:#fee2e2;color:#991b1b',
                  probiha:  'background:#dbeafe;color:#1e40af',
                }[b.status];
                const stavText = {
                  odeslano: 'odesláno · ' + b.order_count + ' obj.',
                  prazdno:  'nic k odeslání',
                  chyba:    'chyba',
                  probiha:  'běží…',
                }[b.status];
              %>
              <tr>
                <td style="color:var(--text-muted);"><%= new Date(b.started_at).toLocaleString('cs-CZ') %></td>
                <td style="color:var(--text-muted);"><%= b.kind === 'auto' ? 'automat' : 'ručně' %></td>
                <td>
                  <span class="badge" style="<%= stavStyl %>" title="<%= b.error || '' %>"><%= stavText %></span>
                  <% if (b.held_count > 0) { %>
                    <a href="/ucetnictvi/objednavky?sklad=blokovano<%= shop.slug !== 'toneracek' ? '&eshop=' + encodeURIComponent(shop.slug) : '' %>" style="font-size:11px;color:var(--text-muted);">· <%= b.held_count %> zadrženo</a>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Healthchecky -->
    <div class="card">
      <div class="card-header">Healthchecky</div>
      <div class="table-wrapper" style="border:none;border-radius:0;">
        <table class="data-table">
          <thead><tr><th>Název</th><th>URL</th><th>Stav</th><th>Posl. kontrola</th><th></th></tr></thead>
          <tbody>
            <% if (checks.length > 0) { %>
              <% checks.forEach(c => { %>
              <tr>
                <td style="font-weight:600;"><%= c.name %></td>
                <td style="font-size:12px;color:var(--text-muted);font-family:var(--font-mono);"><%= c.url %></td>
                <td>
                  <% if (!c.active) { %>
                    <span class="badge" style="background:var(--gray-100);color:var(--gray-500);">Pozastaveno</span>
                  <% } else if (c.ok === true) { %>
                    <span class="badge" style="background:var(--success-bg);color:#15803D;">OK</span>
                  <% } else if (c.ok === false) { %>
                    <span class="badge" style="background:var(--danger-bg);color:#991B1B;">Výpadek</span>
                  <% } else { %>
                    <span class="badge" style="background:var(--gray-100);color:var(--gray-500);">Čeká se</span>
                  <% } %>
                </td>
                <td style="font-size:12px;color:var(--text-muted);"><%= c.checked_at ? new Date(c.checked_at).toLocaleString('cs-CZ') : '—' %></td>
                <td style="display:flex;gap:6px;">
                  <form method="post" action="/nastaveni/healthchecky/<%= c.id %>/toggle" style="display:inline;">
                    <input type="hidden" name="returnTo" value="/nastaveni/eshopy/<%= shop.id %>">
                    <button type="submit" class="btn btn-ghost btn-sm"><%= c.active ? '⏸' : '▶' %></button>
                  </form>
                  <form method="post" action="/nastaveni/healthchecky/<%= c.id %>/smazat" style="display:inline;" onsubmit="return confirm('Smazat?')">
                    <input type="hidden" name="returnTo" value="/nastaveni/eshopy/<%= shop.id %>">
                    <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);">🗑</button>
                  </form>
                </td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5" style="text-align:center;padding:32px;color:var(--text-muted);">Žádný healthcheck — přidej URL pro sledování dostupnosti.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Alert pravidla (app down) -->
    <div class="card">
      <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
        <span>Alerty při výpadku (App down)</span>
        <button class="btn btn-outline btn-sm" data-modal-open="modalAddRule">+ Přidat</button>
      </div>
      <div class="card-body" style="font-size:12px;color:var(--text-muted);padding-bottom:0;">Pravidlo je globální — platí pro výpadek libovolné sledované aplikace.</div>
      <div class="table-wrapper" style="border:none;border-radius:0;">
        <table class="data-table">
          <thead><tr><th>Kanál</th><th></th></tr></thead>
          <tbody>
            <% if (rules.length > 0) { %>
              <% rules.forEach(r => { %>
              <tr>
                <td><%= r.channel_name || '—' %></td>
                <td>
                  <form method="post" action="/nastaveni/notifikace/pravidlo/<%= r.id %>/smazat" style="display:inline;" onsubmit="return confirm('Smazat?')">
                    <input type="hidden" name="returnTo" value="/nastaveni/eshopy/<%= shop.id %>">
                    <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);">🗑</button>
                  </form>
                </td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="2" style="text-align:center;padding:24px;color:var(--text-muted);">Žádná pravidla — výpadek se nikam neodesílá.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- API klíče (starší /api/v1) -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <div>
        <h3>API klíče</h3>
        <p style="font-size:12px;color:var(--text-muted);margin:2px 0 0;">Starší <code>/api/v1</code> (hlavička <code>X-API-Key</code>). E-shop napojený jako Toneráček potřebuje klíč pro <code>/api/eshop</code> výše, ne tenhle.</p>
      </div>
      <form method="post" action="/nastaveni/eshopy/api-klic/vytvorit">
        <input type="hidden" name="shop_id" value="<%= shop.id %>">
        <button type="submit" class="btn btn-outline btn-sm">+ Nový klíč</button>
      </form>
    </div>
    <div class="table-wrapper">
      <table class="data-table">
        <thead><tr><th>Klíč (maskovaný)</th><th>Stav</th><th>Vytvořen</th><th></th></tr></thead>
        <tbody>
          <% keys.forEach(k => { %>
          <tr>
            <td><code style="background:var(--gray-100);padding:2px 6px;border-radius:4px;font-size:12px;"><%= k.key.substring(0,8) %>••••••••</code></td>
            <td>
              <% if (k.active) { %><span class="badge" style="background:#dcfce7;color:#166534;">Aktivní</span>
              <% } else { %><span class="badge" style="background:var(--gray-100);color:var(--gray-500);">Neaktivní</span><% } %>
            </td>
            <td style="color:var(--text-muted);font-size:13px;"><%= new Date(k.created_at).toLocaleDateString('cs-CZ') %></td>
            <td>
              <% if (k.active) { %>
              <form method="post" action="/nastaveni/eshopy/api-klic/<%= k.id %>/deaktivovat" style="display:inline;">
                <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);" onclick="return confirm('Deaktivovat klíč?')">Deaktivovat</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
          <% if (!keys.length) { %>
          <tr><td colspan="4" style="text-align:center;padding:24px;color:var(--text-muted);">Žádné API klíče</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>

  <!-- Pravý sloupec -->
  <div>
    <div class="card">
      <div class="card-header">Jak to funguje</div>
      <div class="card-body" style="font-size:12px;color:var(--text-secondary);line-height:1.7;">
        <p>Worker pinguje URL každých <strong>5 minut</strong>.</p>
        <p style="margin-top:8px;">Při výpadku se odešle alert podle pravidel výše — e-mail, Discord nebo <strong>push notifikace</strong> do prohlížeče přihlášených uživatelů (cooldown 1 h).</p>
        <p style="margin-top:8px;">Kanály se správují centrálně v <a href="/nastaveni/healthchecky">Nastavení → Healthchecky</a>.</p>
      </div>
    </div>
  </div>

</div>

<!-- Modal: Přidat healthcheck -->
<div id="modalAddCheck" class="modal-backdrop" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="modal modal-sm">
    <div class="modal-header">
      <h2 class="modal-title">Přidat healthcheck</h2>
      <button class="modal-close" onclick="document.getElementById('modalAddCheck').classList.remove('open')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form method="post" action="/nastaveni/healthchecky/vytvorit">
      <input type="hidden" name="shop_id" value="<%= shop.id %>">
      <input type="hidden" name="returnTo" value="/nastaveni/eshopy/<%= shop.id %>">
      <div class="modal-body" style="display:flex;flex-direction:column;gap:14px;">
        <div class="form-group">
          <label class="form-label required">Název</label>
          <input type="text" name="name" class="form-control" value="<%= shop.name %>" required>
        </div>
        <div class="form-group">
          <label class="form-label required">URL</label>
          <input type="url" name="url" class="form-control" placeholder="<%= shop.url %>/api/health" required>
        </div>
        <div class="form-group">
          <label class="form-label">Interval kontrol</label>
          <select name="interval_s" class="form-select">
            <option value="60">1 minuta</option>
            <option value="300" selected>5 minut</option>
            <option value="600">10 minut</option>
            <option value="1800">30 minut</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('modalAddCheck').classList.remove('open')">Zrušit</button>
        <button type="submit" class="btn btn-primary">Přidat</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Přidat alert pravidlo -->
<div id="modalAddRule" class="modal-backdrop" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="modal modal-sm">
    <div class="modal-header">
      <h2 class="modal-title">Přidat alert (App down)</h2>
      <button class="modal-close" onclick="document.getElementById('modalAddRule').classList.remove('open')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form method="post" action="/nastaveni/notifikace/pravidlo/vytvorit">
      <input type="hidden" name="event_type" value="app_down">
      <input type="hidden" name="returnTo" value="/nastaveni/eshopy/<%= shop.id %>">
      <div class="modal-body" style="display:flex;flex-direction:column;gap:14px;">
        <div class="form-group">
          <label class="form-label required">Notifikační kanál</label>
          <select name="channel_id" class="form-select" required>
            <% channels.forEach(ch => { %>
            <option value="<%= ch.id %>"><%= ch.name %> (<%= ch.type %>)</option>
            <% }) %>
          </select>
          <small style="color:var(--text-muted);font-size:12px;">Nový kanál (e-mail/Discord/push) se přidává v <a href="/nastaveni/healthchecky">Nastavení → Healthchecky</a>.</small>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('modalAddRule').classList.remove('open')">Zrušit</button>
        <button type="submit" class="btn btn-primary">Přidat</button>
      </div>
    </form>
  </div>
</div>

<script>
document.querySelectorAll('[data-modal-open]').forEach(b =>
  b.addEventListener('click', () => document.getElementById(b.dataset.modalOpen)?.classList.add('open'))
);
</script>
