<%
  const sb = receipt.status==='Zaúčtována' ? '#dcfce7' : receipt.status==='Storno' ? '#f3f4f6' : '#fef9c3';
  const sc = receipt.status==='Zaúčtována' ? '#166534' : receipt.status==='Storno' ? '#6b7280' : '#92400e';
  const fmt  = n => Number(n||0).toLocaleString('cs-CZ', { minimumFractionDigits: 2 });
  const isImage = (receipt.attachment_mime || '').startsWith('image/');
  const hotove  = !receipt.payment_method || receipt.payment_method === 'Hotovost';
  const agenda  = hotove ? 'Pokladna' : 'Ostatní závazky';
  const bezDph  = receipt.vat_deductible === false;
  const chybi   = receipt.attachment_path && receipt.attachment_missing;
  const fileUrl = receipt.attachment_path && !chybi ? '/doklady/soubor/' + receipt.attachment_path : null;
  // Režim úprav (src/upravy.js): jediný formulář záznamu, tužka v hlavičce
  // vždy; bez JS otevře úpravy ?upravit=1, Zrušit vede na čistou adresu.
  const rezim   = rezimUprav ? 'upravy' : 'zobrazeni';
  const urlZpet = '/ucetnictvi/uctenky/' + receipt.id;
  const MAX_CASTKA = 9999999999.99; // sloupce NUMERIC(12,2): větší číslo by skončilo chybou databáze
%>

<div class="detail" data-rezim="<%= rezim %>">
<div class="page-header">
  <div class="page-header-left">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
      <a href="/ucetnictvi/uctenky" class="btn btn-ghost btn-sm" data-zpet>← Zpět</a>
      <h1><%= receipt.vendor || 'Účtenka' %></h1>
      <span class="badge" style="background:<%= sb %>;color:<%= sc %>;font-size:13px;"><%= receipt.status %></span>
      <span class="badge" style="background:<%= hotove ? '#e0e7ff' : '#fce7f3' %>;color:<%= hotove ? '#3730a3' : '#9d174d' %>;font-size:12px;"
            title="Doklad se do POHODY exportuje do agendy <%= agenda %>">
        <%= receipt.payment_method || 'Hotovost' %> → <%= agenda %>
      </span>
      <% if (bezDph) { %>
      <span class="badge" style="background:#fef3c7;color:#92400e;font-size:12px;"
            title="Celá částka včetně DPH jde do nákladů – § 72 odst. 4 ZDPH">bez odpočtu DPH</span>
      <% } %>
    </div>
    <p><%= receipt.number ? 'Doklad ' + receipt.number + ' · ' : '' %><%= new Date(receipt.receipt_date).toLocaleDateString('cs-CZ') %> · <%= fmt(receipt.total_amount) %> <%= receipt.currency %></p>
  </div>
  <div class="page-header-akce">
    <% if (fileUrl) { %>
    <a href="<%= fileUrl %>" class="btn btn-outline"
       data-nahled
       data-nahled-nazev="<%= receipt.attachment_path %>"
       data-nahled-typ="<%= receipt.attachment_mime || '' %>"
       data-nahled-velikost="<%= receipt.attachment_size || 0 %>">📄 Zobrazit doklad</a>
    <% } %>
    <form method="post" action="/ucetnictvi/uctenky/<%= receipt.id %>/smazat"
          onsubmit="return confirm('Opravdu smazat tuto účtenku i s dokladem?')" style="display:inline;">
      <button type="submit" class="btn btn-outline" style="color:var(--danger);">Smazat</button>
    </form>
    <%- include('../../includes/upravit', { formular: 'formUctenka', urlUpravit: '?upravit=1', urlZpet }) %>
  </div>
</div>

<% if (saved) { %>
<div data-hlaska class="jen-zobrazeni" style="background:#dcfce7;color:#166534;border:1px solid #bbf7d0;padding:10px 16px;border-radius:8px;margin-bottom:16px;">✓ Uloženo</div>
<% } %>
<% if (error) { %>
<div data-hlaska style="background:var(--danger-bg);color:var(--danger);padding:10px 16px;border-radius:8px;margin-bottom:16px;">⚠ <%= error %></div>
<% } %>

<div class="rd-grid">

  <!-- Doklad -->
  <div class="card" style="align-self:start;">
    <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
      <strong>Doklad</strong>
      <span style="font-size:12px;color:var(--text-muted);">
        <%= receipt.attachment_size ? Math.round(receipt.attachment_size/1024) + ' kB' : '' %>
      </span>
    </div>
    <div class="card-body">
      <% if (fileUrl) { %>
        <a href="<%= fileUrl %>" class="rd-doklad"
           data-nahled
           data-nahled-nazev="<%= receipt.attachment_path %>"
           data-nahled-typ="<%= receipt.attachment_mime || '' %>"
           data-nahled-velikost="<%= receipt.attachment_size || 0 %>"
           title="Klikni pro zvětšení">
          <% if (isImage) { %>
            <img src="<%= fileUrl %>" alt="Doklad">
          <% } else { %>
            <div class="rd-pdf">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <span><%= receipt.attachment_path %></span>
            </div>
          <% } %>
        </a>
      <% } else if (chybi) { %>
        <div style="background:var(--danger-bg);color:var(--danger);border:1px dashed var(--danger);border-radius:var(--radius-md);padding:16px;font-size:13px;">
          <strong>Doklad chybí.</strong>
          Záznam odkazuje na soubor <code><%= receipt.attachment_path %></code>, který na serveru není.
          Nahrajte jej prosím znovu.
        </div>
      <% } else { %>
        <p style="color:var(--text-muted);font-size:13px;margin:0 0 12px;">K této účtence zatím není uložený žádný doklad.</p>
      <% } %>

      <form method="post" action="/ucetnictvi/uctenky/<%= receipt.id %>/priloha" enctype="multipart/form-data"
            style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;">
        <label style="cursor:pointer;">
          <input type="file" name="file" accept="application/pdf,image/*" style="display:none;" onchange="rdPriloha(this)">
          <span class="btn btn-outline btn-sm"><%= fileUrl ? 'Nahradit' : 'Nahrát PDF / foto' %></span>
        </label>
        <label style="cursor:pointer;">
          <input type="file" name="file" accept="image/*" capture="environment" style="display:none;" onchange="rdPriloha(this)">
          <span class="btn btn-outline btn-sm">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px;vertical-align:-2px;"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            Vyfotit
          </span>
        </label>
        <span id="rdPrilohaInfo" style="font-size:12px;color:var(--text-muted);align-self:center;"></span>
      </form>
    </div>
  </div>

  <!-- Údaje účtenky: formulář záznamu – v zobrazení hodnoty jako text, tužka ho otevře -->
  <div class="card" style="align-self:start;">
    <form method="post" action="/ucetnictvi/uctenky/<%= receipt.id %>/upravit" id="formUctenka" class="upravitelne" autocomplete="off">
      <div class="card-header"><strong>Údaje účtenky</strong></div>
      <div class="card-body" style="display:flex;flex-direction:column;gap:14px;">

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <%- include('../../includes/pole', { pole: { label: 'Číslo dokladu', name: 'number', value: receipt.number, placeholder: 'Nepovinné' } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Datum dokladu', name: 'receipt_date', typ: 'date', value: receipt.receipt_date, required: true } }) %>
        </div>

        <%- include('../../includes/pole', { pole: { label: 'Dodavatel', name: 'vendor', value: receipt.vendor, required: true } }) %>

        <%- include('../../includes/pole', { pole: { label: 'IČO dodavatele', name: 'vendor_ico', value: receipt.vendor_ico, placeholder: 'Nepovinné' } }) %>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <%- include('../../includes/pole', { pole: { label: 'Základ bez DPH', name: 'amount', typ: 'number', step: '0.01', min: 0, max: MAX_CASTKA,
            value: receipt.amount, zobraz: fmt(receipt.amount) + ' ' + receipt.currency } }) %>
          <%- include('../../includes/pole', { pole: { label: 'DPH', name: 'vat_amount', typ: 'number', step: '0.01', min: 0, max: MAX_CASTKA,
            value: receipt.vat_amount, zobraz: fmt(receipt.vat_amount) + ' ' + receipt.currency } }) %>
        </div>

        <div style="display:grid;grid-template-columns:1fr 90px;gap:12px;">
          <%- include('../../includes/pole', { pole: { label: 'Celková částka', name: 'total_amount', typ: 'number', step: '0.01', min: 0, max: MAX_CASTKA,
            value: receipt.total_amount, zobraz: fmt(receipt.total_amount) + ' ' + receipt.currency } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Měna', name: 'currency', typ: 'select', moznosti: ['CZK', 'EUR', 'USD'], value: receipt.currency } }) %>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <%- include('../../includes/pole', { pole: { label: 'Kategorie', name: 'category', id: 'rdCategory', typ: 'select', moznosti: CATEGORIES, value: receipt.category } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Stav', name: 'status', typ: 'select', moznosti: STATUSES, value: receipt.status } }) %>
        </div>

        <%# Hinty plní rdUhrada() podle kategorie a formy úhrady; include jim id dát neumí,
            proto ručně pod polem – obal drží pole i hint v jedné buňce mřížky. %>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div class="form-group">
            <%- include('../../includes/pole', { pole: { label: 'Forma úhrady', name: 'payment_method', id: 'rdPayment', typ: 'select',
              moznosti: PAYMENT_METHODS, value: receipt.payment_method || 'Hotovost' } }) %>
            <small id="rdAgendaHint" class="form-hint jen-upravy"></small>
          </div>
          <div class="form-group">
            <%- include('../../includes/pole', { pole: { label: 'Odpočet DPH', name: 'vat_deductible', id: 'rdVatDeductible', typ: 'checkbox', hodnotaVstupu: 'on',
              value: !bezDph, popisek: 'Uplatnit nárok na odpočet', zobraz: bezDph ? 'Bez odpočtu DPH' : 'Uplatněn odpočet' } }) %>
            <small id="rdVatHint" class="form-hint jen-upravy"></small>
          </div>
        </div>

        <%- include('../../includes/pole', { pole: { label: 'Poznámka / předmět nákupu', name: 'notes', typ: 'textarea', rows: 3, value: receipt.notes } }) %>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <%- include('../../includes/pole', { pole: { label: 'Předkontace MD', name: 'account_debit', value: receipt.account_debit, placeholder: 'např. 518', tridaHodnoty: 'pole-mono', list: 'rdAcList', autocomplete: 'off' } }) %>
          <%- include('../../includes/pole', { pole: { label: 'Předkontace D', name: 'account_credit', value: receipt.account_credit, placeholder: 'např. 211', tridaHodnoty: 'pole-mono', list: 'rdAcList', autocomplete: 'off' } }) %>
        </div>
        <datalist id="rdAcList"></datalist>

        <%- include('../../includes/upravit', { paticka: true, formular: 'formUctenka', urlZpet }) %>
      </div>
    </form>
  </div>

</div>
</div>

<style>
.rd-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
@media (max-width: 900px) { .rd-grid { grid-template-columns: 1fr; } }

.rd-doklad { display: block; cursor: zoom-in; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border); }
.rd-doklad img { display: block; width: 100%; max-height: 460px; object-fit: contain; background: var(--bg-page); }
.rd-pdf {
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  padding: 36px 20px; background: var(--bg-page); color: var(--text-muted); font-size: 13px;
  text-align: center; word-break: break-all;
}
</style>

<script>
// Doklad zmenšíme v prohlížeči a pošleme bez opuštění stránky
window.rdPriloha = async function (input) {
  const raw = input.files && input.files[0];
  if (!raw) return;
  const info = document.getElementById('rdPrilohaInfo');
  info.textContent = 'Ukládám…';

  const res = await window.dokladFoto.prepare(raw);
  const fd = new FormData();
  fd.append('file', res.file, res.file.name);

  try {
    const resp = await fetch(input.form.action, { method: 'POST', body: fd });
    if (!resp.ok) {
      const data = await resp.json().catch(() => ({}));
      throw new Error(data.error || 'Chyba serveru (' + resp.status + ')');
    }
    // Doklad se ukáže až po načtení; upravy.js přes něj přenese rozepsané údaje.
    window.upravyNactiZnovu ? window.upravyNactiZnovu() : window.location.reload();
  } catch (err) {
    input.value = '';
    info.textContent = 'Nepodařilo se uložit: ' + err.message;
  }
};

// Reprezentace nárok na odpočet nemá (§ 72 odst. 4 ZDPH) – checkbox zamkneme,
// ať ho nikdo omylem nezaškrtne. Server totéž hlídá i při uložení.
const RD_NO_VAT = <%- JSON.stringify(NO_VAT_CATEGORIES) %>;

window.rdUhrada = function () {
  const cat  = document.getElementById('rdCategory').value;
  const pay  = document.getElementById('rdPayment').value;
  const vat  = document.getElementById('rdVatDeductible');
  const hint = document.getElementById('rdVatHint');
  const agenda = document.getElementById('rdAgendaHint');

  agenda.textContent = pay === 'Hotovost'
    ? 'Do POHODY jde do agendy Pokladna.'
    : 'Placeno z účtu → v POHODĚ do Ostatních závazků, ne do pokladny.';

  if (RD_NO_VAT.includes(cat)) {
    if (!vat.disabled) vat.dataset.pred = vat.checked ? '1' : ''; // po změně kategorie se volba vrátí
    vat.checked = false;
    vat.disabled = true;
    hint.textContent = 'U reprezentace odpočet uplatnit nelze – celá částka jde do nákladů.';
  } else {
    if (vat.disabled && vat.dataset.pred !== undefined) vat.checked = vat.dataset.pred === '1';
    vat.disabled = false;
    hint.textContent = vat.checked ? '' : 'Celá částka včetně DPH půjde do nákladů.';
  }
};
// Pole vykresluje include pole.ejs, který inline onchange neumí – posluchače visí tady.
document.getElementById('rdCategory').addEventListener('change', window.rdUhrada);
document.getElementById('rdPayment').addEventListener('change', window.rdUhrada);
document.getElementById('rdVatDeductible').addEventListener('change', window.rdUhrada);
// Zrušit (upravy.js) volá form.reset(): ten vrátí hodnoty, ale ne disabled a
// texty hintů, které nastavuje rdUhrada() – zamčený checkbox by se neodeslal
// a další uložení by odpočet tiše vypnulo. Událost reset přichází před
// obnovením hodnot, proto přepočet až po ní. Zapamatovaná volba odpočtu po
// Zrušit neplatí, platí výchozí hodnota z formuláře.
document.getElementById('formUctenka').addEventListener('reset', () => setTimeout(() => {
  delete document.getElementById('rdVatDeductible').dataset.pred;
  window.rdUhrada();
}, 0));
window.rdUhrada();
// Prohlížeč vrací hodnoty polí po návratu Zpět až po spuštění skriptu.
window.addEventListener('pageshow', window.rdUhrada);

fetch('/api/accounting-chart').then(r => r.json()).then(list => {
  const dl = document.getElementById('rdAcList');
  if (dl) dl.innerHTML = list.map(a => `<option value="${a.code}">${a.code} – ${a.name}</option>`).join('');
}).catch(() => {});
</script>
