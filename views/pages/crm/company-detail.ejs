<%
  const fmt  = n  => Number(n||0).toLocaleString('cs-CZ', {minimumFractionDigits:2});
  const fmtD = d  => d ? new Date(d).toLocaleDateString('cs-CZ') : '—';
  const currentTab = tab || 'zakladni';
  // Režim úprav (src/upravy.js): tužka v hlavičce jen u záložky s formulářem
  // záznamu; bez JS otevře úpravy ?upravit=1. Poznámky mají vlastní routu,
  // aby formulář jen s textarea nepřepisoval zbytek řádku firmy.
  const FORMULARE = { __proto__: null, zakladni: 'formFirma', poznamky: 'formPoznamky' }; // tab z URL: bez prototypu ?tab=constructor nic nenajde
  const formular = FORMULARE[currentTab] || null;
  const rezim = formular && rezimUprav ? 'upravy' : 'zobrazeni';
  const urlZalozky = `?tab=${currentTab}`;
%>

<div class="detail" data-rezim="<%= rezim %>">
<div class="page-header">
  <div class="page-header-left">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
      <a href="/crm/firmy" class="btn btn-ghost btn-sm">← Firmy</a>
      <h1 style="margin:0;"><%= company.name %></h1>
      <span class="badge" style="background:var(--info-bg);color:var(--info);"><%= company.company_type || 'Zákazník' %></span>
      <% if (company.company_status === 'Aktivní') { %>
        <span class="badge" style="background:#dcfce7;color:#166534;">Aktivní</span>
      <% } else if (company.company_status) { %>
        <span class="badge" style="background:#f3f4f6;color:#6b7280;"><%= company.company_status %></span>
      <% } %>
    </div>
  </div>
  <% if (company.ico || formular) { %>
  <div class="page-header-akce">
    <% if (company.ico) { %>
    <form method="post" action="/crm/firmy/<%= company.id %>/ares" id="aresForm" style="display:none;"></form>
    <button type="button" class="btn btn-outline" onclick="syncAres()">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
      Sync ARES
    </button>
    <% } %>
    <% if (formular) { %>
    <%- include('../../includes/upravit', { formular, urlUpravit: `${urlZalozky}&upravit=1`, urlZpet: urlZalozky }) %>
    <% } %>
  </div>
  <% } %>
</div>

<% if (saved) { %>
<div class="jen-zobrazeni" style="background:#dcfce7;color:#166534;border:1px solid #bbf7d0;padding:10px 16px;border-radius:8px;margin-bottom:16px;">✓ Uloženo</div>
<% } %>
<% if (aresUpdated) { %>
<div style="background:var(--info-bg);color:var(--info);border:1px solid #bae6fd;padding:10px 16px;border-radius:8px;margin-bottom:16px;">✓ Data aktualizována z ARES</div>
<% } %>

<!-- Tabs -->
<nav class="tabs" aria-label="Sekce firmy">
  <% [
    ['zakladni',   'Základní informace'],
    ['kontakty',   'Kontakty (' + stats.totalContacts + ')'],
    ['objednavky', 'Objednávky (' + stats.totalOrders + ')'],
    ['faktury',    'Faktury (' + stats.totalInvoices + ')'],
    ['smlouvy',    'Smlouvy (' + contracts.length + ')'],
    ['poznamky',   'Poznámky'],
  ].forEach(function(item) {
    const key = item[0]; const label = item[1];
  %>
  <a href="?tab=<%= key %>" class="tab<%= currentTab===key ? ' active' : '' %>"<%- currentTab===key ? ' aria-current="page"' : '' %>><%= label %></a>
  <% }) %>
</nav>

<!-- ══ TAB: ZÁKLADNÍ INFORMACE ══ -->
<% if (currentTab === 'zakladni') { %>

<form method="post" action="/crm/firmy/<%= company.id %>" id="formFirma" class="upravitelne">
<div style="display:grid;grid-template-columns:2fr 1fr;gap:24px;align-items:start;">
  <div style="display:flex;flex-direction:column;gap:20px;">

    <!-- Dashboard KPI -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
      <div class="card" style="text-align:center;">
        <div class="card-body" style="padding:16px 12px;">
          <div style="font-size:26px;font-weight:700;color:var(--primary);"><%= stats.totalContacts %></div>
          <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">Kontaktů</div>
        </div>
      </div>
      <div class="card" style="text-align:center;">
        <div class="card-body" style="padding:16px 12px;">
          <div style="font-size:26px;font-weight:700;color:var(--primary);"><%= stats.totalOrders %></div>
          <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">Objednávek</div>
        </div>
      </div>
      <div class="card" style="text-align:center;">
        <div class="card-body" style="padding:16px 12px;">
          <div style="font-size:26px;font-weight:700;color:var(--primary);"><%= stats.totalInvoices %></div>
          <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">Faktur</div>
        </div>
      </div>
      <div class="card" style="grid-column:span 2;text-align:center;">
        <div class="card-body" style="padding:16px;">
          <div style="font-size:22px;font-weight:700;color:#166534;"><%= fmt(stats.totalInvoiced) %> CZK</div>
          <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">Celkem fakturováno (<%= stats.paidInvoices %> zaplaceno)</div>
        </div>
      </div>
      <div class="card" style="text-align:center;">
        <div class="card-body" style="padding:16px 12px;">
          <div style="font-size:26px;font-weight:700;color:<%= stats.openOrders > 0 ? '#b45309' : 'var(--text-muted)' %>;"><%= stats.openOrders %></div>
          <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">Otevřených obj.</div>
        </div>
      </div>
    </div>

    <!-- Identifikace -->
    <div class="card">
      <div class="card-header"><strong>Identifikace</strong></div>
      <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <%# Název, typ a stav jsou v zobrazení v hlavičce stránky — tady jen v úpravách. %>
        <%- include('../../includes/pole', { pole: { label: 'Název', name: 'name', value: company.name, required: true, trida: 'jen-upravy', styl: 'grid-column:1/-1' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Typ', name: 'company_type', typ: 'select', value: company.company_type || 'Zákazník', moznosti: ['Zákazník', 'Dodavatel', 'Partner', 'Jiný'], trida: 'jen-upravy' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Stav', name: 'company_status', value: company.company_status, trida: 'jen-upravy' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'IČO', name: 'ico', value: company.ico, tridaHodnoty: 'pole-mono' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'DIČ', name: 'dic', value: company.dic, tridaHodnoty: 'pole-mono' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Právní forma', name: 'legal_form', value: company.legal_form, styl: 'grid-column:1/-1' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Spisová značka', name: 'registration_info', value: company.registration_info, tridaHodnoty: 'pole-mono' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Datum vzniku', name: 'founded_date', typ: 'date', value: company.founded_date } }) %>
        <% if (company.ares_synced_at) { %>
        <div style="grid-column:1/-1;">
          <div style="color:var(--text-muted);font-size:11px;">ARES naposledy synchronizován: <%= fmtD(company.ares_synced_at) %></div>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Adresa a kontakt -->
    <div class="card">
      <div class="card-header"><strong>Adresa a kontakt</strong></div>
      <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <%- include('../../includes/pole', { pole: { label: 'Adresa', name: 'address', value: company.address, styl: 'grid-column:1/-1' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Město', name: 'city', value: company.city } }) %>
        <%- include('../../includes/pole', { pole: { label: 'PSČ', name: 'zip', value: company.zip } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Stát', name: 'country', value: company.country, vychozi: 'Česká republika', styl: 'grid-column:1/-1' } }) %>
        <%- include('../../includes/pole', { pole: { label: 'E-mail', name: 'email', typ: 'email', value: company.email } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Telefon', name: 'phone', typ: 'tel', value: company.phone } }) %>
        <%- include('../../includes/pole', { pole: { label: 'Web', name: 'website', typ: 'url', value: company.website, styl: 'grid-column:1/-1' } }) %>
      </div>
    </div>

    <%# Karta je vždy — jinak by se poznámka nedala poprvé vyplnit. %>
    <div class="card">
      <div class="card-header"><strong>Poznámky</strong></div>
      <div class="card-body">
        <%- include('../../includes/pole', { pole: { label: 'Interní poznámky', name: 'notes', typ: 'textarea', value: company.notes, rows: 6, skrytyPopisek: true, placeholder: 'Interní poznámky, informace o spolupráci…' } }) %>
        <%- include('../../includes/upravit', { paticka: true, formular: 'formFirma', urlZpet: urlZalozky }) %>
      </div>
    </div>
  </div>

  <!-- Pravý sloupec: metadata -->
  <div style="display:flex;flex-direction:column;gap:16px;">
    <div class="card">
      <div class="card-header"><strong>Záznam</strong></div>
      <div class="card-body" style="font-size:13px;display:flex;flex-direction:column;gap:12px;">
        <div>
          <div style="color:var(--text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Typ</div>
          <div><%= company.company_type || 'Zákazník' %></div>
        </div>
        <div>
          <div style="color:var(--text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Vytvořeno</div>
          <div><%= fmtD(company.created_at) %></div>
          <% if (creator) { %>
          <div style="font-size:12px;color:var(--text-muted);margin-top:2px;"><%= creator.first_name %> <%= creator.last_name %></div>
          <% } else if (company.source) { %>
          <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">Zdroj: <%= company.source %></div>
          <% } %>
        </div>
        <div>
          <div style="color:var(--text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Naposledy upraveno</div>
          <div><%= fmtD(company.modified_at) %></div>
          <% if (editor) { %>
          <div style="font-size:12px;color:var(--text-muted);margin-top:2px;"><%= editor.first_name %> <%= editor.last_name %></div>
          <% } %>
        </div>
        <div>
          <div style="color:var(--text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">ID</div>
          <code style="font-size:10px;word-break:break-all;"><%= company.id %></code>
        </div>
      </div>
    </div>
    <% if (company.ico) { %>
    <a href="https://ares.gov.cz/ekonomicke-subjekty?ico=<%= company.ico %>" target="_blank" class="btn btn-ghost btn-sm" style="text-align:center;">Ověřit v ARES ↗</a>
    <% } %>
  </div>
</div>
</form>

<!-- ══ TAB: KONTAKTY ══ -->
<% } else if (currentTab === 'kontakty') { %>

<div style="display:flex;justify-content:flex-end;margin-bottom:16px;">
  <button class="btn btn-primary btn-sm" data-modal-open="modalAddContact">+ Přidat kontakt</button>
</div>
<% if (contacts.length > 0) { %>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;">
  <% contacts.forEach(function(c) { %>
  <div class="card" style="cursor:pointer;" onclick="location.href='/crm/kontakty/<%= c.id %>'">
    <div class="card-body" style="display:flex;gap:12px;align-items:center;">
      <div style="width:44px;height:44px;border-radius:50%;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0;font-size:15px;">
        <%= (c.first_name||'').charAt(0) %><%= (c.last_name||'').charAt(0) %>
      </div>
      <div style="min-width:0;">
        <div style="font-weight:600;"><%= [c.title, c.first_name, c.last_name].filter(Boolean).join(' ') %></div>
        <% if (c.email) { %><div style="font-size:12px;color:var(--text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= c.email %></div><% } %>
        <% if (c.phone) { %><div style="font-size:12px;color:var(--text-muted);"><%= c.phone %></div><% } %>
      </div>
    </div>
  </div>
  <% }) %>
</div>
<% } else { %>
<div style="text-align:center;padding:48px;color:var(--text-muted);">Žádné kontakty. Přidejte první kontakt tlačítkem výše.</div>
<% } %>

<!-- ══ TAB: OBJEDNÁVKY ══ -->
<% } else if (currentTab === 'objednavky') { %>
<% if (orders.length > 0) { %>
<div class="table-wrapper">
  <table class="data-table">
    <thead><tr><th>Číslo</th><th>Zákazník</th><th>Datum</th><th style="text-align:right;">Částka</th><th>Stav</th></tr></thead>
    <tbody>
    <% orders.forEach(function(o) {
         const sc = o.status==='Vyřízena' ? '#dcfce7:#166534' : o.status==='Stornována' ? '#f3f4f6:#6b7280' : '#fef9c3:#92400e';
         const parts = sc.split(':'); %>
    <tr style="cursor:pointer;" onclick="location.href='/ucetnictvi/objednavky/<%= o.id %>'">
      <td style="font-weight:600;">#<%= o.order_number %></td>
      <td><%= [o.first_name, o.last_name].filter(Boolean).join(' ') || '—' %></td>
      <td style="color:var(--text-muted);font-size:13px;"><%= fmtD(o.created_at) %></td>
      <td style="text-align:right;font-weight:600;"><%= fmt(o.total_price) %> CZK</td>
      <td><span class="badge" style="background:<%= parts[0] %>;color:<%= parts[1] %>;"><%= o.status %></span></td>
    </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } else { %>
<div style="text-align:center;padding:48px;color:var(--text-muted);">Žádné objednávky</div>
<% } %>

<!-- ══ TAB: FAKTURY ══ -->
<% } else if (currentTab === 'faktury') { %>
<% if (invoices.length > 0) { %>
<div class="table-wrapper">
  <table class="data-table">
    <thead><tr><th>Číslo</th><th>Typ</th><th>Datum</th><th>Splatnost</th><th style="text-align:right;">Celkem</th><th>Stav</th></tr></thead>
    <tbody>
    <% invoices.forEach(function(inv) {
         const sc = inv.status==='Zaplacena' ? '#dcfce7:#166534' : inv.status==='Storno' ? '#f3f4f6:#6b7280' : inv.status==='Po splatnosti' ? '#fee2e2:#991b1b' : '#fef9c3:#92400e';
         const parts = sc.split(':'); %>
    <tr style="cursor:pointer;" onclick="location.href='/ucetnictvi/<%= inv.type==='issued' ? 'vydane' : 'prijate' %>-faktury/<%= inv.id %>'">
      <td style="font-weight:600;"><%= inv.number %></td>
      <td><span style="font-size:12px;color:var(--text-muted);"><%= inv.type==='issued' ? 'Vydaná' : 'Přijatá' %></span></td>
      <td style="color:var(--text-muted);font-size:13px;"><%= fmtD(inv.issue_date) %></td>
      <td style="color:var(--text-muted);font-size:13px;"><%= fmtD(inv.due_date) %></td>
      <td style="text-align:right;font-weight:600;"><%= fmt(inv.total_amount) %> <%= inv.currency %></td>
      <td><span class="badge" style="background:<%= parts[0] %>;color:<%= parts[1] %>;"><%= inv.status %></span></td>
    </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } else { %>
<div style="text-align:center;padding:48px;color:var(--text-muted);">Žádné faktury</div>
<% } %>

<!-- ══ TAB: SMLOUVY ══ -->
<% } else if (currentTab === 'smlouvy') { %>
<div style="display:flex;justify-content:flex-end;margin-bottom:16px;">
  <button class="btn btn-primary btn-sm" data-modal-open="modalAddContract">+ Přidat smlouvu</button>
</div>
<% if (contracts.length > 0) { %>
<div style="display:flex;flex-direction:column;gap:12px;">
  <% contracts.forEach(function(c) {
       const sc = c.status==='Aktivní' ? '#dcfce7:#166534' : c.status==='Ukončená' ? '#f3f4f6:#6b7280' : '#fef9c3:#92400e';
       const parts = sc.split(':'); %>
  <div class="card">
    <div class="card-body" style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
      <div style="flex:1;min-width:0;">
        <div style="font-weight:600;margin-bottom:4px;"><%= c.title || 'Bez názvu' %></div>
        <div style="font-size:12px;color:var(--text-muted);">
          <% if (c.type) { %><%= c.type %> · <% } %>
          Podpis: <%= fmtD(c.signed_date) %><% if (c.end_date) { %> · Platnost do: <%= fmtD(c.end_date) %><% } %><% if (c.amount) { %> · <%= fmt(c.amount) %> <%= c.currency %><% } %>
        </div>
        <% if (c.notes) { %><div style="font-size:12px;color:var(--text-muted);margin-top:4px;"><%= c.notes %></div><% } %>
      </div>
      <div style="display:flex;align-items:center;gap:10px;flex-shrink:0;">
        <span class="badge" style="background:<%= parts[0] %>;color:<%= parts[1] %>;"><%= c.status %></span>
        <form method="post" action="/crm/smlouvy/<%= c.id %>/smazat" onsubmit="return confirm('Smazat smlouvu?')">
          <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);">Smazat</button>
        </form>
      </div>
    </div>
  </div>
  <% }) %>
</div>
<% } else { %>
<div style="text-align:center;padding:48px;color:var(--text-muted);">Žádné smlouvy. Přidejte první smlouvu tlačítkem výše.</div>
<% } %>

<!-- ══ TAB: POZNÁMKY ══ -->
<% } else if (currentTab === 'poznamky') { %>
<div style="max-width:720px;">
  <div class="card">
    <div class="card-header"><strong>Poznámky k firmě</strong></div>
    <form method="post" action="/crm/firmy/<%= company.id %>/poznamky" id="formPoznamky" class="upravitelne">
      <div class="card-body">
        <%- include('../../includes/pole', { pole: { label: 'Interní poznámky', name: 'notes', typ: 'textarea', value: company.notes, rows: 10, skrytyPopisek: true, placeholder: 'Interní poznámky, informace o spolupráci…' } }) %>
      </div>
    </form>
  </div>
</div>
<% } %>

<!-- ═══ Modály ═══ -->

<!-- Přidat kontakt -->
<div id="modalAddContact" class="modal-backdrop" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="modal modal-sm">
    <div class="modal-header"><h2 class="modal-title">Přidat kontakt</h2>
      <button class="modal-close" onclick="document.getElementById('modalAddContact').classList.remove('open')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <form method="post" action="/crm/kontakty/vytvorit">
      <input type="hidden" name="company_id" value="<%= company.id %>">
      <div class="modal-body" style="display:flex;flex-direction:column;gap:12px;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <div class="form-group"><label class="form-label">Jméno</label><input type="text" name="first_name" class="form-control"></div>
          <div class="form-group"><label class="form-label required">Příjmení</label><input type="text" name="last_name" class="form-control" required></div>
        </div>
        <div class="form-group"><label class="form-label">Titul</label><input type="text" name="title" class="form-control" placeholder="Ing., Mgr., …"></div>
        <div class="form-group"><label class="form-label">E-mail</label><input type="email" name="email" class="form-control"></div>
        <div class="form-group"><label class="form-label">Telefon</label><input type="text" name="phone" class="form-control"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('modalAddContact').classList.remove('open')">Zrušit</button>
        <button type="submit" class="btn btn-primary">Přidat</button>
      </div>
    </form>
  </div>
</div>

<!-- Přidat smlouvu -->
<div id="modalAddContract" class="modal-backdrop" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="modal">
    <div class="modal-header"><h2 class="modal-title">Přidat smlouvu</h2>
      <button class="modal-close" onclick="document.getElementById('modalAddContract').classList.remove('open')"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <form method="post" action="/crm/firmy/<%= company.id %>/smlouvy/vytvorit">
      <div class="modal-body" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <div class="form-group col-span-2"><label class="form-label required">Název smlouvy</label><input type="text" name="title" class="form-control" required placeholder="Rámcová smlouva o spolupráci"></div>
        <div class="form-group"><label class="form-label">Typ</label>
          <select name="type" class="form-select">
            <option value="">— vyberte —</option>
            <option>Rámcová smlouva</option><option>Servisní smlouva</option><option>NDA</option><option>Smlouva o dílo</option><option>Nájemní smlouva</option><option>Jiná</option>
          </select>
        </div>
        <div class="form-group"><label class="form-label">Stav</label>
          <select name="status" class="form-select">
            <option>Aktivní</option><option>Návrh</option><option>Ukončená</option><option>Pozastavená</option>
          </select>
        </div>
        <div class="form-group"><label class="form-label">Datum podpisu</label><input type="date" name="signed_date" class="form-control"></div>
        <div class="form-group"><label class="form-label">Platnost do</label><input type="date" name="end_date" class="form-control"></div>
        <div class="form-group"><label class="form-label">Hodnota</label><input type="number" name="amount" class="form-control" step="0.01"></div>
        <div class="form-group"><label class="form-label">Měna</label><select name="currency" class="form-select"><option value="CZK">CZK</option><option value="EUR">EUR</option></select></div>
        <div class="form-group col-span-2"><label class="form-label">Poznámka</label><textarea name="notes" class="form-control" rows="2"></textarea></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('modalAddContract').classList.remove('open')">Zrušit</button>
        <button type="submit" class="btn btn-primary">Uložit smlouvu</button>
      </div>
    </form>
  </div>
</div>
</div>

<script>
document.querySelectorAll('[data-modal-open]').forEach(function(b) {
  b.addEventListener('click', function() {
    var el = document.getElementById(b.dataset.modalOpen);
    if (el) el.classList.add('open');
  });
});

async function syncAres() {
  var ico = '<%= company.ico %>';
  if (!ico) return;
  var btn = event.target.closest('button');
  btn.disabled = true; btn.textContent = 'Načítám…';
  try {
    var res  = await fetch('/api/ares/' + ico);
    var data = await res.json();
    if (!res.ok) { alert('ARES: ' + (data.error || 'chyba')); btn.disabled=false; btn.textContent='Sync ARES'; return; }
    var form = document.getElementById('aresForm');
    var set  = function(n, v) { var i=document.createElement('input'); i.type='hidden'; i.name=n; i.value=v||''; form.appendChild(i); };
    set('name',              data.name);
    set('ico',               data.ico);
    set('dic',               data.dic);
    set('address',           data.address);
    set('city',              data.city);
    set('zip',               data.zip);
    set('country',           data.country);
    set('legal_form',        data.legal_form);
    set('founded_date',      data.founded_date || '');
    set('registration_info', data.registration_info || '');
    set('company_status',    data.company_status || '');
    set('raw',               JSON.stringify(data.raw));
    form.submit();
  } catch(e) {
    alert('ARES nedostupný: ' + e.message);
    btn.disabled=false; btn.textContent='Sync ARES';
  }
}
</script>
