<%
  const sFiltrem = Boolean(q || typeFilter || sourceFilter);
  const SIRKA_VYBERU = 'max-width:min(100%,260px);'; // dlouhá volba by jinak roztáhla select i stránku
  const TONY_TYPU = { __proto__: null, 'Zákazník': 'ok', 'Dodavatel': 'info', 'Oboje': 'varovani' };
%>
<div class="page-header">
  <div class="page-header-left">
    <h1>Firmy</h1>
    <p><%= total.toLocaleString('cs-CZ') %> <%= total === 1 ? 'firma' : total >= 2 && total <= 4 ? 'firmy' : 'firem' %><%= !sFiltrem ? ' celkem' : total >= 2 && total <= 4 ? ' odpovídají filtru' : ' odpovídá filtru' %></p>
  </div>
  <div class="page-header-akce">
    <button class="btn btn-primary" data-modal-open="modalCreateCompany">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Přidat firmu
    </button>
  </div>
</div>

<form method="get" class="filtr-lista">
  <% if (strany.vlastniVelikost) { %><input type="hidden" name="velikost" value="<%= strany.naStranku %>"><% } %>
  <input type="text" name="q" value="<%= q %>" placeholder="Hledat název, město, IČO…" class="form-control" aria-label="Hledat název, město, zemi nebo IČO">
  <select name="type" class="form-select" style="<%= SIRKA_VYBERU %>" aria-label="Typ firmy">
    <option value="">Všechny typy</option>
    <% ['Zákazník', 'Dodavatel', 'Oboje', 'Ostatní'].forEach(t => { %><option value="<%= t %>" <%= typeFilter === t ? 'selected' : '' %>><%= t %></option><% }) %>
  </select>
  <select name="source" class="form-select" style="<%= SIRKA_VYBERU %>" aria-label="Zdroj">
    <option value="">Všechny zdroje</option>
    <% sources.forEach(s => { %><option value="<%= s.source %>" <%= sourceFilter === s.source ? 'selected' : '' %>><%= s.source %></option><% }) %>
    <option value="-" <%= sourceFilter === '-' ? 'selected' : '' %>>(bez zdroje)</option>
  </select>
  <button type="submit" class="btn btn-outline">Filtrovat</button>
  <% if (sFiltrem) { %><a href="/crm/firmy" class="btn btn-ghost">Zrušit filtr</a><% } %>
</form>

<div class="table-wrapper">
  <table class="data-table">
    <thead>
      <tr>
        <th>Název firmy</th>
        <th>Typ</th>
        <th class="hide-mobile">Zdroj</th>
        <th class="hide-mobile">Země</th>
        <th class="mobil">Město</th>
        <th class="hide-mobile">E-mail</th>
        <th class="mobil">Telefon</th>
        <th class="hide-mobile">Přidána</th>
      </tr>
    </thead>
    <tbody>
      <% if (companies.length > 0) { %>
        <% companies.forEach(company => { %>
        <tr data-href="/crm/firmy/<%= company.id %>">
          <td><a href="/crm/firmy/<%= company.id %>" class="radek-odkaz radek-text" title="<%= company.name %>"><%= company.name || '(bez názvu)' %></a></td>
          <td><span class="badge badge-<%= TONY_TYPU[company.company_type] || 'neutral' %>"><%= company.company_type || 'Ostatní' %></span></td>
          <td class="hide-mobile"><% if (company.source) { %><span class="badge badge-neutral"><%= company.source %></span><% } else { %>–<% } %></td>
          <td class="hide-mobile"><%= company.country || '–' %></td>
          <td class="mobil sekundarni"><%= company.city || '–' %></td>
          <td class="hide-mobile"><% if (company.email) { %><a href="mailto:<%= company.email %>" class="radek-text" style="color:var(--link);" title="<%= company.email %>"><%= company.email %></a><% } else { %>–<% } %></td>
          <td class="mobil mono sekundarni"><%= company.phone || '–' %></td>
          <td class="mono sekundarni hide-mobile"><%= ceskeDatum(prazskeDatum(company.created_at)) %></td>
        </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="8">
          <div class="prazdno">
            <% if (sFiltrem) { %>
              <strong>Filtru neodpovídá žádná firma</strong>
              <a href="/crm/firmy" class="btn btn-outline btn-sm">Zrušit filtr</a>
            <% } else { %>
              <strong>Zatím žádné firmy</strong>
              První přidáte tlačítkem Přidat firmu.
            <% } %>
          </div>
        </td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../../includes/strankovani', { strany }) %>

<!-- Modal: Přidat firmu -->
<div class="modal-backdrop" id="modalCreateCompany">
  <div class="modal modal-sm">
    <div class="modal-header">
      <h2 class="modal-title">Přidat firmu</h2>
      <button class="modal-close" data-modal-close="modalCreateCompany">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form method="post" action="/crm/firmy/vytvorit">
      <div class="modal-body">
        <div class="form-grid" style="grid-template-columns:1fr 1fr;gap:14px;">
          <div class="form-group col-span-2">
            <label class="form-label required">Název firmy</label>
            <input type="text" name="name" class="form-control" placeholder="např. ACME s.r.o." required>
          </div>
          <div class="form-group">
            <label class="form-label">Typ</label>
            <select name="company_type" class="form-select">
              <option value="Zákazník">Zákazník</option>
              <option value="Dodavatel">Dodavatel</option>
              <option value="Oboje">Oboje</option>
              <option value="Ostatní">Ostatní</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Země</label>
            <input type="text" name="country" class="form-control" placeholder="Česko">
          </div>
          <div class="form-group">
            <label class="form-label">Město</label>
            <input type="text" name="city" class="form-control" placeholder="Praha">
          </div>
          <div class="form-group">
            <label class="form-label">Telefon</label>
            <input type="text" name="phone" class="form-control" placeholder="+420 000 000 000">
          </div>
          <div class="form-group col-span-2">
            <label class="form-label">E-mail</label>
            <input type="email" name="email" class="form-control" placeholder="info@firma.cz">
          </div>
          <div class="form-group col-span-2">
            <label class="form-label">Web</label>
            <input type="url" name="website" class="form-control" placeholder="https://firma.cz">
          </div>
          <div class="form-group col-span-2">
            <label class="form-label">Poznámky</label>
            <textarea name="notes" class="form-control" rows="2" placeholder="Libovolné poznámky…"></textarea>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" data-modal-close="modalCreateCompany">Zrušit</button>
        <button type="submit" class="btn btn-primary">Přidat firmu</button>
      </div>
    </form>
  </div>
</div>
