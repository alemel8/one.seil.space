<%
  const sFiltrem = Boolean(q || companyFilter || sourceFilter);
  const SIRKA_VYBERU = 'max-width:min(100%,260px);'; // dlouhý název firmy by jinak roztáhl select i stránku
%>
<div class="page-header">
  <div class="page-header-left">
    <h1>Kontakty</h1>
    <p><%= total.toLocaleString('cs-CZ') %> <%= total === 1 ? 'kontakt' : total >= 2 && total <= 4 ? 'kontakty' : 'kontaktů' %><%= !sFiltrem ? ' celkem' : total >= 2 && total <= 4 ? ' odpovídají filtru' : ' odpovídá filtru' %></p>
  </div>
  <div class="page-header-akce">
    <button class="btn btn-primary" data-modal-open="modalCreateContact">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Přidat kontakt
    </button>
  </div>
</div>

<form method="get" class="filtr-lista">
  <input type="text" name="q" value="<%= q %>" placeholder="Hledat jméno, e-mail, telefon…" class="form-control" aria-label="Hledat jméno, e-mail nebo telefon">
  <select name="company" class="form-select" style="<%= SIRKA_VYBERU %>" aria-label="Firma">
    <option value="">Všechny firmy</option>
    <% companies.forEach(c => { %><option value="<%= c.id %>" <%= companyFilter === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
  </select>
  <select name="source" class="form-select" style="<%= SIRKA_VYBERU %>" aria-label="Zdroj">
    <option value="">Všechny zdroje</option>
    <% sources.forEach(s => { %><option value="<%= s.source %>" <%= sourceFilter === s.source ? 'selected' : '' %>><%= s.source %></option><% }) %>
    <option value="-" <%= sourceFilter === '-' ? 'selected' : '' %>>(bez zdroje)</option>
  </select>
  <button type="submit" class="btn btn-outline">Filtrovat</button>
  <% if (sFiltrem) { %><a href="/crm/kontakty" class="btn btn-ghost">Zrušit filtr</a><% } %>
</form>

<div class="table-wrapper">
  <table class="data-table">
    <thead>
      <tr>
        <th>Jméno</th>
        <th>Firma</th>
        <th class="hide-mobile">Zdroj</th>
        <th class="hide-mobile">Pozice</th>
        <th class="mobil">E-mail</th>
        <th class="hide-mobile">Telefon</th>
        <th class="hide-mobile">Přidán</th>
      </tr>
    </thead>
    <tbody>
      <% if (contacts.length > 0) { %>
        <% contacts.forEach(contact => { %>
        <tr data-href="/crm/kontakty/<%= contact.id %>">
          <td>
            <a href="/crm/kontakty/<%= contact.id %>" class="radek-odkaz"><%= [contact.first_name, contact.last_name].filter(Boolean).join(' ') || contact.email || '(bez jména)' %></a>
            <% if (contact.is_registered) { %><br><span class="badge badge-ok">Registrovaný</span><% } %>
          </td>
          <td>
            <% if (contact.company_id && contact.company_display_name) { %>
              <a href="/crm/firmy/<%= contact.company_id %>" class="radek-text" style="color:var(--link);" title="<%= contact.company_display_name %>"><%= contact.company_display_name %></a>
            <% } else if (contact.company_display_name) { %>
              <span class="radek-text" title="<%= contact.company_display_name %>"><%= contact.company_display_name %></span>
            <% } else { %>–<% } %>
          </td>
          <td class="hide-mobile"><% if (contact.source) { %><span class="badge badge-neutral"><%= contact.source %></span><% } else { %>–<% } %></td>
          <td class="sekundarni hide-mobile"><% if (contact.title) { %><span class="radek-text" title="<%= contact.title %>"><%= contact.title %></span><% } else { %>–<% } %></td>
          <td class="mobil"><% if (contact.email) { %><a href="mailto:<%= contact.email %>" class="radek-text" style="color:var(--link);" title="<%= contact.email %>"><%= contact.email %></a><% } else { %>–<% } %></td>
          <td class="mono sekundarni hide-mobile"><%= contact.phone || '–' %></td>
          <td class="mono sekundarni hide-mobile"><%= ceskeDatum(prazskeDatum(contact.created_at)) %></td>
        </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="7">
          <div class="prazdno">
            <% if (sFiltrem) { %>
              <strong>Filtru neodpovídá žádný kontakt</strong>
              <a href="/crm/kontakty" class="btn btn-outline btn-sm">Zrušit filtr</a>
            <% } else { %>
              <strong>Zatím žádné kontakty</strong>
              První přidáte tlačítkem Přidat kontakt.
            <% } %>
          </div>
        </td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../../includes/strankovani', { strany }) %>

<!-- Modal: Přidat kontakt -->
<div class="modal-backdrop" id="modalCreateContact">
  <div class="modal modal-sm">
    <div class="modal-header">
      <h2 class="modal-title">Přidat kontakt</h2>
      <button class="modal-close" data-modal-close="modalCreateContact">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form method="post" action="/crm/kontakty/vytvorit">
      <div class="modal-body">
        <div class="form-grid" style="grid-template-columns:1fr 1fr;gap:14px;">
          <div class="form-group">
            <label class="form-label required">Jméno</label>
            <input type="text" name="first_name" class="form-control" placeholder="Jan" required>
          </div>
          <div class="form-group">
            <label class="form-label">Příjmení</label>
            <input type="text" name="last_name" class="form-control" placeholder="Novák">
          </div>
          <div class="form-group col-span-2">
            <label class="form-label">Firma</label>
            <select name="company_id" class="form-select">
              <option value="">– Bez firmy –</option>
              <% companies.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="form-group col-span-2">
            <label class="form-label">Pozice</label>
            <input type="text" name="title" class="form-control" placeholder="Jednatel, obchodní ředitel…">
          </div>
          <div class="form-group">
            <label class="form-label">E-mail</label>
            <input type="email" name="email" class="form-control" placeholder="jan.novak@firma.cz">
          </div>
          <div class="form-group">
            <label class="form-label">Telefon</label>
            <input type="text" name="phone" class="form-control" placeholder="+420 000 000 000">
          </div>
          <div class="form-group col-span-2">
            <label class="form-label">Poznámky</label>
            <textarea name="notes" class="form-control" rows="2" placeholder="Libovolné poznámky…"></textarea>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" data-modal-close="modalCreateContact">Zrušit</button>
        <button type="submit" class="btn btn-primary">Přidat kontakt</button>
      </div>
    </form>
  </div>
</div>
