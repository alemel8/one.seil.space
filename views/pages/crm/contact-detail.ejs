<%
  const jmeno = [contact.first_name, contact.last_name].filter(Boolean).join(' ') || contact.email || '(bez jména)';
  const kc = n => `${Math.round(n).toLocaleString('cs-CZ')} Kč`;
  const SOUHRN = [
    ['Objednávek', souhrn.objednavek],
    ['Objednáno za', kc(souhrn.utraceno)],
    ['Zaplaceno na dokladech', kc(souhrn.zaplaceno)],
    ['Poslední objednávka', ceskeDatum(prazskeDatum(souhrn.posledni)) || '–'],
  ];
%>

<div class="page-header">
  <div class="page-header-left">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
      <%# width: hlavička bez akcí roztáhne na telefonu tlačítka přes celou šířku (.page-header > *:last-child .btn) %>
      <a href="/crm/kontakty" class="btn btn-ghost btn-sm" style="width:auto;" data-zpet>← Kontakty</a>
      <h1 style="margin:0;"><%= jmeno %></h1>
      <% if (contact.is_registered) { %>
        <span class="badge badge-ok">Registrovaný</span>
      <% } else { %>
        <span class="badge badge-neutral">Host</span>
      <% } %>
    </div>
    <% if (contact.company_display_name) { %>
      <p>
        <% if (contact.company_id) { %><a href="/crm/firmy/<%= contact.company_id %>" style="color:var(--link);"><%= contact.company_display_name %></a><% } else { %><%= contact.company_display_name %><% } %>
      </p>
    <% } %>
  </div>
</div>

<%- include('../../includes/zalozky', { nazev: 'Sekce kontaktu', zalozky, tab, adresa: k => `/crm/kontakty/${contact.id}?tab=${k}` }) %>

<% if (tab === 'prehled') { %>

<div class="kpi-grid" style="margin-bottom:20px;">
  <% SOUHRN.forEach(([popisek, hodnota]) => { %>
  <div class="kpi-card">
    <div class="kpi-label"><%= popisek %></div>
    <div class="kpi-value"><%= hodnota %></div>
  </div>
  <% }) %>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start;">
  <div class="card">
    <div class="card-header"><strong>Informace</strong></div>
    <div class="card-body">
      <dl style="display:grid;grid-template-columns:130px minmax(0,1fr);gap:8px 16px;font-size:13px;margin:0;">
        <% if (contact.title) { %>
        <dt style="color:var(--text-secondary);">Pozice</dt>
        <dd style="margin:0;"><%= contact.title %></dd>
        <% } %>
        <% if (contact.company_display_name) { %>
        <dt style="color:var(--text-secondary);">Firma</dt>
        <dd style="margin:0;">
          <% if (contact.company_id) { %><a href="/crm/firmy/<%= contact.company_id %>" style="color:var(--link);"><%= contact.company_display_name %></a><% } else { %><%= contact.company_display_name %><% } %>
        </dd>
        <% } %>
        <% if (contact.email) { %>
        <dt style="color:var(--text-secondary);">E-mail</dt>
        <dd style="margin:0;overflow-wrap:anywhere;"><a href="mailto:<%= contact.email %>" style="color:var(--link);"><%= contact.email %></a></dd>
        <% } %>
        <% if (contact.phone) { %>
        <dt style="color:var(--text-secondary);">Telefon</dt>
        <dd style="margin:0;"><%= contact.phone %></dd>
        <% } %>
        <dt style="color:var(--text-secondary);">Přidán</dt>
        <dd style="margin:0;"><%= ceskeDatum(prazskeDatum(contact.created_at)) %></dd>
        <dt style="color:var(--text-secondary);">Stav</dt>
        <dd style="margin:0;">
          <% if (contact.is_registered) { %>
            <span class="badge badge-ok">Registrovaný zákazník</span>
          <% } else { %>
            <span class="badge badge-neutral">Host (bez registrace)</span>
          <% } %>
        </dd>
        <dt style="color:var(--text-secondary);">Zdroj</dt>
        <dd style="margin:0;"><%= contact.source || 'ruční zadání' %></dd>
        <% if (contact.is_registered && contact.last_login) { %>
        <dt style="color:var(--text-secondary);">Naposledy přihlášen</dt>
        <dd style="margin:0;"><%= new Date(contact.last_login).toLocaleString('cs-CZ', { timeZone: 'Europe/Prague' }) %></dd>
        <% } %>
      </dl>
    </div>
  </div>

  <div style="display:flex;flex-direction:column;gap:20px;">
    <div class="card">
      <div class="card-header"><strong>Souhlasy</strong></div>
      <div class="card-body">
        <dl style="display:grid;grid-template-columns:130px minmax(0,1fr);gap:8px 16px;font-size:13px;margin:0;">
          <dt style="color:var(--text-secondary);">Zpracování údajů</dt>
          <dd style="margin:0;">
            <% if (contact.gdpr_consent_at) { %>
              <span class="badge badge-ok">Souhlasil</span>
              <span class="mono" style="color:var(--text-secondary);font-size:12px;margin-left:6px;"><%= ceskeDatum(prazskeDatum(contact.gdpr_consent_at)) %></span>
            <% } else { %>
              <%# Prázdno není „nesouhlasil" – u kontaktů z doby, kdy se souhlas %>
              <%# nikam neukládal, ho prostě neumíme doložit. %>
              <span style="color:var(--text-secondary);">bez záznamu</span>
            <% } %>
          </dd>
          <dt style="color:var(--text-secondary);">Newsletter</dt>
          <dd style="margin:0;">
            <% if (contact.marketing_consent) { %>
              <span class="badge badge-ok">Odebírá</span>
            <% } else { %>
              <span class="badge badge-neutral">Neodebírá</span>
            <% } %>
          </dd>
          <dt style="color:var(--text-secondary);">Notifikace</dt>
          <dd style="margin:0;">
            <% if (contact.notifications_consent) { %>
              <span class="badge badge-ok">Ano</span>
            <% } else { %>
              <span class="badge badge-neutral">Ne</span>
            <% } %>
          </dd>
        </dl>
      </div>
    </div>

    <% if (contact.notes) { %>
    <div class="card">
      <div class="card-header"><strong>Poznámky</strong></div>
      <div class="card-body">
        <p style="margin:0;font-size:13px;color:var(--text-primary);line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere;"><%= contact.notes %></p>
      </div>
    </div>
    <% } %>
  </div>
</div>

<% } else if (tab === 'objednavky') { %>
<%- include('_objednavky', { objednavky: orders, strany, sZakaznikem: false }) %>

<% } else if (tab === 'faktury') { %>
<%- include('_faktury', { faktury: invoices, strany }) %>
<% } %>
