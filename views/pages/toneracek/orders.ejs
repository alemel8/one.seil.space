<%
  // ── Sloupec „Sklad" ───────────────────────────────────────────
  // Tooltip je nativní title= – jiný v aplikaci není a zavádět ho kvůli jedné
  // ikoně by znamenalo vlastní CSS i JS.
  const fmtCas = (v) => new Date(v).toLocaleString('cs-CZ');
  const atr = (s) => String(s).replace(/"/g, '&quot;');

  const SKLAD_SVG = {
    odeslano:  '<circle cx="12" cy="12" r="10"/><polyline points="16 10 11 15 8 12"/>',
    ceka:      '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
    blokovano: '<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
  };
  const SKLAD_BARVA = { odeslano: 'var(--ton-ok-text)', ceka: 'var(--ton-varovani-text)', blokovano: 'var(--ton-chyba-text)' };

  function skladPopis(o) {
    if (o.sklad_stav === 'odeslano') {
      return 'Odesláno do skladu ' + fmtCas(o.warehouse_sent_at)
           + (o.warehouse_dispatch_id ? ' (ranní expedice)' : ' (ručně)');
    }
    if (o.sklad_stav === 'blokovano') {
      return 'Nešlo do skladu: ' + (duvody[o.warehouse_hold_reason] || o.warehouse_hold_reason);
    }
    if (o.sklad_stav === 'ceka') {
      return 'Zaplaceno – půjde do skladu v příští ranní expedici'
           + (o.tracking_number ? '' : ' (zásilka se podá při expedici)');
    }
    if (o.status === 'Stornována') return 'Stornováno – do skladu nejde';
    if (new Date(o.created_at) < new Date(shop.warehouse_dispatch_since)) {
      return 'Přijata před spuštěním expedice – sklad ji dostal ručně';
    }
    return 'Nezaplaceno – do skladu nejde';
  }

  function skladIkona(o) {
    const popis = atr(skladPopis(o));
    if (!SKLAD_SVG[o.sklad_stav]) {
      return '<span title="' + popis + '" style="color:var(--text-muted);">–</span>';
    }
    return '<span title="' + popis + '" aria-label="' + popis + '"'
         + ' style="display:inline-flex;color:' + SKLAD_BARVA[o.sklad_stav] + ';">'
         + '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"'
         + ' stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
         + SKLAD_SVG[o.sklad_stav] + '</svg></span>';
  }

  // Parametr e-shopu jde do každého odkazu, ať filtr nepřeskočí na jiný
  // e-shop. U výchozího (Toneráček) je prázdný a adresy zůstávají jako dřív.
  // Stránkování si ho drží samo (strany, src/routes/toneracek.js).
  const odkaz = (extra) => {
    const p = [eshopQs, extra].filter(Boolean);
    return '/ucetnictvi/objednavky' + (p.length ? '?' + p.join('&') : '');
  };

  const filtrAktivni = q || statusFilter || skladFilter;
  const nekolik = total >= 2 && total <= 4;
  // Chip je odkaz na filtr, zvolený se pozná podle rámečku.
  const chipStyl = (aktivni) => 'display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;font-size:13px;font-weight:500;text-decoration:none;'
    + 'border:1px solid ' + (aktivni ? 'currentColor' : 'transparent') + ';';
%>

<div class="page-header">
  <div class="page-header-left">
    <h1><%= nadpis %></h1>
    <p><%= total.toLocaleString('cs-CZ') %> <%= total === 1 ? 'objednávka' : nekolik ? 'objednávky' : 'objednávek' %> <%= filtrAktivni ? (nekolik ? 'odpovídají' : 'odpovídá') + ' filtru' : 'celkem' %></p>
  </div>
  <form method="post" action="/ucetnictvi/objednavky/expedice" class="page-header-akce"
        onsubmit="return confirm('Odešle skladu e-mail se všemi zaplacenými objednávkami, které ještě nedostal. Pokračovat?')">
    <% if (eshopQs) { %><input type="hidden" name="shop_id" value="<%= shop.id %>"><% } %>
    <button type="submit" class="btn btn-outline" <%= shop.warehouse_email ? '' : 'disabled' %>
            title="<%= shop.warehouse_email
              ? 'Ranní expedice jede ve všední dny v 06:00 na ' + shop.warehouse_email
              : 'E-shop nemá vyplněnou adresu skladu – doplňte ji v Nastavení → Eshopy' %>">
      Odeslat expedici teď
    </button>
  </form>
</div>

<% if (eshopy.length > 1) { %>
<!-- Přepínač e-shopů (jen když je jich víc než jeden) -->
<nav aria-label="E-shop" style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px;">
  <% eshopy.forEach(e => { %>
    <% const aktivni = e.id === shop.id; %>
    <a href="<%= e.slug === vychoziEshop ? '/ucetnictvi/objednavky' : '/ucetnictvi/objednavky?eshop=' + encodeURIComponent(e.slug) %>"
       <%- aktivni ? 'aria-current="page"' : '' %>
       style="padding:6px 14px;border-radius:999px;font-size:13px;font-weight:500;text-decoration:none;border:1px solid <%= aktivni ? 'var(--primary)' : 'var(--border)' %>;background:<%= aktivni ? 'var(--primary)' : 'transparent' %>;color:<%= aktivni ? 'var(--deep-space)' : 'var(--text-secondary)' %>;">
      <%= e.name %>
    </a>
  <% }) %>
</nav>
<% } %>

<!-- Výsledek expedice (čte se z databáze, ne z URL – přežije i pád uprostřed běhu) -->
<% if (expedice) { %>
  <% if (expedice.status === 'odeslano') { %>
    <div class="hlaska hlaska-ok">
      ✓ Expedice odeslána: <strong><%= expedice.order_count %></strong> objednávek na <%= expedice.recipient %>.
      <% if (expedice.held_count > 0) { %>
        <a href="<%= odkaz('sklad=blokovano') %>"><%= expedice.held_count %> objednávek zadrženo</a>.
      <% } %>
    </div>
  <% } else if (expedice.status === 'prazdno') { %>
    <div class="hlaska hlaska-info">
      Nic k odeslání – všechny zaplacené objednávky už sklad má.
      <% if (expedice.held_count > 0) { %>
        <a href="<%= odkaz('sklad=blokovano') %>"><%= expedice.held_count %> objednávek se nepodařilo připravit</a>.
      <% } %>
    </div>
  <% } else if (expedice.status === 'chyba') { %>
    <div class="hlaska hlaska-chyba">
      Expedici se nepodařilo odeslat: <%= expedice.error %><br>
      Nic nebylo označeno jako odeslané – zkuste to znovu, nebo počkejte na ranní běh.
    </div>
  <% } else { %>
    <div class="hlaska hlaska-info">Expedice právě běží…</div>
  <% } %>
<% } %>

<% if (error === 'expedice-bezi') { %>
<div class="hlaska hlaska-chyba">
  Expedice právě běží – spustil ji automat nebo jiný uživatel. Zkuste to za chvíli.
</div>
<% } else if (error === 'sklad-email') { %>
<div class="hlaska hlaska-chyba">
  E-shop nemá vyplněnou adresu skladu – doplňte ji v <a href="/nastaveni/eshopy/<%= shop.id %>?tab=expedice">Nastavení → Eshopy</a>.
</div>
<% } %>

<!-- Statistiky stavů -->
<div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;">
  <% (statusCounts || []).forEach(sc => { %>
    <a href="<%= odkaz('status=' + encodeURIComponent(sc.status)) %>" class="badge-<%= tonStavu(sc.status) %>"
       <%- statusFilter === sc.status ? 'aria-current="true"' : '' %>
       style="<%= chipStyl(statusFilter === sc.status) %>">
      <strong><%= sc.n.toLocaleString('cs-CZ') %></strong> <%= sc.status %>
    </a>
  <% }); %>

  <% if (skladCounts.ceka) { %>
    <a href="<%= odkaz('sklad=ceka') %>" class="badge-varovani"
       <%- skladFilter === 'ceka' ? 'aria-current="true"' : '' %>
       style="<%= chipStyl(skladFilter === 'ceka') %>">
      <strong><%= skladCounts.ceka.toLocaleString('cs-CZ') %></strong> čeká na sklad
    </a>
  <% } %>
  <% if (skladCounts.blokovano) { %>
    <a href="<%= odkaz('sklad=blokovano') %>" class="badge-chyba"
       <%- skladFilter === 'blokovano' ? 'aria-current="true"' : '' %>
       style="<%= chipStyl(skladFilter === 'blokovano') %>">
      <strong><%= skladCounts.blokovano.toLocaleString('cs-CZ') %></strong> nešlo do skladu
    </a>
  <% } %>
</div>

<!-- Filtr -->
<form method="get" class="filtr-lista">
  <% if (strany.vlastniVelikost) { %><input type="hidden" name="velikost" value="<%= strany.naStranku %>"><% } %>
  <% if (eshopQs) { %><input type="hidden" name="eshop" value="<%= shop.slug %>"><% } %>
  <input type="text" name="q" value="<%= q || '' %>" placeholder="Číslo, jméno, e-mail…" class="form-control" aria-label="Hledat číslo, jméno, e-mail, telefon nebo firmu">
  <select name="status" class="form-select" aria-label="Stav">
    <option value="">Všechny stavy</option>
    <% ORDER_STATUSES.forEach(s => { %>
      <option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= s %></option>
    <% }); %>
  </select>
  <select name="sklad" class="form-select" aria-label="Sklad">
    <% const skladVolby = [['','Sklad: vše'],['ceka','Čeká na sklad'],['blokovano','Nešlo do skladu'],['odeslano','Odesláno do skladu']]; %>
    <% skladVolby.forEach(([val, label]) => { %>
      <option value="<%= val %>" <%= skladFilter === val ? 'selected' : '' %>><%= label %></option>
    <% }); %>
  </select>
  <button type="submit" class="btn btn-outline">Filtrovat</button>
  <% if (filtrAktivni) { %>
    <a href="<%= odkaz() %>" class="btn btn-ghost">Zrušit filtr</a>
  <% } %>
</form>

<!-- Tabulka -->
<div class="table-wrapper">
  <table class="data-table">
    <thead>
      <tr>
        <th>Číslo</th>
        <th>Zákazník</th>
        <th class="hide-mobile">E-mail</th>
        <th class="num">Celkem</th>
        <th>Platba</th>
        <th class="mobil">Stav</th>
        <th>Sklad</th>
        <th>Datum</th>
      </tr>
    </thead>
    <tbody>
      <% if (orders.length > 0) { %>
        <% orders.forEach(o => { %>
        <tr data-href="/ucetnictvi/objednavky/<%= o.id %>">
          <td class="mono"><a href="/ucetnictvi/objednavky/<%= o.id %>" class="radek-odkaz">#<%= o.order_number %></a></td>
          <td><span class="radek-text" title="<%= o.first_name %> <%= o.last_name %>"><%= o.first_name %> <%= o.last_name %></span></td>
          <td class="sekundarni hide-mobile"><%= o.email %></td>
          <td class="num"><%= Number(o.total_price).toLocaleString('cs-CZ',{minimumFractionDigits:2}) %> Kč</td>
          <td class="sekundarni"><%= o.payment_method %></td>
          <td class="mobil"><span class="badge badge-<%= tonStavu(o.status) %>"><%= o.status %></span></td>
          <td><%- skladIkona(o) %></td>
          <td class="mono sekundarni"><%= ceskeDatum(prazskeDatum(o.created_at)) %></td>
        </tr>
        <% }); %>
      <% } else { %>
      <tr><td colspan="8">
        <div class="prazdno">
          <% if (filtrAktivni) { %>
            <strong>Filtru neodpovídá žádná objednávka</strong>
            <a href="<%= odkaz() %>" class="btn btn-outline btn-sm">Zrušit filtr</a>
          <% } else { %>
            <strong>Zatím žádné objednávky</strong>
            Objednávky se sem zapisují z e-shopu.
          <% } %>
        </div>
      </td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../../includes/strankovani', { strany }) %>
