<%
  // Stav napojených platforem a běhy nočního stahování (src/marketing/sync.js).
  // Okamžik v pražském čase: kontejner může běžet v UTC (src/prazsky-cas.js).
  const kdy = d => d ? new Date(d).toLocaleString('cs-CZ', { timeZone: 'Europe/Prague', day: 'numeric', month: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '–';
  const okno = b => {
    const od = jenDatum(b.from_date);
    const po = jenDatum(b.to_date);
    return od && po ? rozsahCesky(od, po) : ceskeDatum(od || po);
  };
  const stavTon = { hotovo: 'ok', chyba: 'chyba', probiha: 'info' };
  const stavText = { hotovo: 'hotovo', chyba: 'chyba', probiha: 'běží…' };
  // Krátké názvy: řádek běhu má hodně sloupců a plný popis platformy by ho zalomil na tři řádky.
  const platformaBehu = { ga4: 'GA4', google_ads: 'Google Ads', search_console: 'Search Console', merchant: 'Merchant Center', sklik: 'Sklik', heureka: 'Heureka', meta: 'Meta', eshop: 'E-shop' };
  const can = k => (user && typeof user.can === 'function') ? user.can(k) : true;
%>
<div class="page-header">
  <div class="page-header-left">
    <h1><% if (can('marketing.prehled')) { %><a href="/marketing<%- dotaz(shop) %>" style="color:var(--text-muted);text-decoration:none;">Marketing</a><% } else { %><span style="color:var(--text-muted);">Marketing</span><% } %> / Synchronizace</h1>
    <p><%= shop ? shop.name + ' · ' : '' %>noční stahování statistik platforem (po 5:00 pražského času, posledních 14–30 dní se přepisuje)</p>
  </div>
</div>

<%- include('../../includes/eshop-prepinac', { eshopy, shop, basePath: '/marketing/sync', qs: '', vychoziEshop }) %>

<% if (saved && zadnyBeh) { %><div class="hlaska hlaska-info">Nic se nestáhlo: pro tuto volbu není žádná aktivní platforma.</div>
<% } else if (saved && behSChybou) { %><div class="hlaska hlaska-varovani">Stažení se u některých platforem nepovedlo – podrobnosti jsou u běhu v tabulce.</div>
<% } else if (saved) { %><div class="hlaska hlaska-ok">✓ Stažení proběhlo – výsledek je v tabulce běhů.</div><% } %>
<% if (error === 'sync-nedostupny') { %><div class="hlaska hlaska-chyba">Stahování ještě není nasazené (chybí src/marketing/sync.js).</div><% } %>
<% if (error === 'sync-bezi') { %><div class="hlaska hlaska-varovani">Běh pro tento zdroj právě probíhá – počkejte, až skončí.</div><% } %>
<% if (error === 'sync-chyba') { %><div class="hlaska hlaska-chyba">Stažení selhalo – podrobnosti jsou u běhu v tabulce a v logu serveru.</div><% } %>

<% if (!maGoogleSa) { %><div class="hlaska hlaska-chyba"><code>GOOGLE_SERVICE_ACCOUNT_JSON</code> není nastavený – GA4, Google Ads, Search Console ani Merchant Center se nestáhnou.</div><% } %>
<% if (!maSecretsKey) { %><div class="hlaska hlaska-varovani"><code>MARKETING_SECRETS_KEY</code> není nastavený – tokeny Skliku, Heureky a Mety nejde uložit ani použít.</div><% } %>

<% if (!shop) { %>
<div class="card"><div class="prazdno"><strong>Žádný aktivní e-shop</strong><% if (can('nastaveni.eshopy')) { %>Založte ho v Nastavení → Eshopy.<% } %></div></div>
<% } else { %>

<div class="card" style="margin-bottom:24px;">
  <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
    <span>Napojené platformy</span>
    <% if (jeAdmin) { %>
    <form method="post" action="/marketing/sync/spustit" style="margin:0;" onsubmit="return confirm('Stáhnout teď statistiky všech aktivních platforem? Čerpá to kvóty API.')">
      <input type="hidden" name="eshop" value="<%= shop.slug %>"><input type="hidden" name="platform" value="vse">
      <button type="submit" class="btn btn-outline btn-sm">Stáhnout vše teď</button>
    </form>
    <% } %>
  </div>
  <div class="table-wrapper" style="border:none;border-radius:0;">
    <table class="data-table">
      <thead><tr><th>Platforma</th><th>Stav</th><th class="hide-mobile">ID</th><th class="hide-mobile">Token</th><th class="mobil">Poslední úspěch</th><th class="mobil">Poslední chyba</th><th aria-label="Akce"></th></tr></thead>
      <tbody>
        <% zdroje.forEach(z => { %>
        <tr>
          <td style="font-weight:600;"><%= z.popis %></td>
          <td><% if (!z.zdroj) { %><span class="badge badge-neutral">nenastaveno</span><% } else if (z.zdroj.active) { %><span class="badge badge-ok">aktivní</span><% } else { %><span class="badge badge-neutral">vypnuto</span><% } %></td>
          <td class="mono sekundarni hide-mobile"><%= z.zdroj?.external_id || '' %><%= z.zdroj?.parent_external_id ? ' / ' + z.zdroj.parent_external_id : '' %></td>
          <td class="sekundarni hide-mobile"><% if (!z.potrebujeTajemstvi) { %>service account<% } else if (z.maTajemstvi) { %>otisk <code class="kod"><%= z.otisk %></code><% } else { %><span class="pole-varovani">chybí</span><% } %></td>
          <td class="mono sekundarni mobil"><%= kdy(z.zdroj?.last_ok_at) %></td>
          <td class="sekundarni mobil"><% if (z.zdroj?.last_error) { %><span class="radek-text pole-varovani" title="<%= z.zdroj.last_error %>"><%= z.zdroj.last_error %></span><% } else { %>–<% } %></td>
          <td style="text-align:right;">
            <% if (jeAdmin && z.zdroj && z.zdroj.active) { %>
            <form method="post" action="/marketing/sync/spustit" style="display:inline;">
              <input type="hidden" name="eshop" value="<%= shop.slug %>"><input type="hidden" name="platform" value="<%= z.platform %>">
              <button type="submit" class="btn btn-ghost btn-sm">Spustit teď</button>
            </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="card-body form-hint">Napojení (ID, tokeny, od kdy stahovat) se nastavuje v <% if (can('nastaveni.eshopy')) { %><a href="/nastaveni/eshopy/<%= shop.id %>?tab=marketing" style="color:var(--link);">Nastavení → Eshopy → <%= shop.name %> → Marketing</a><% } else { %>Nastavení → Eshopy (správce)<% } %>.</div>
</div>

<%# overflow:clip místo hidden z .card: ořeže rohy, ale není to posuvník, takže patička zůstane přilepená k oknu %>
<div class="card" style="overflow:clip;">
  <div class="card-header">Poslední běhy</div>
  <div class="table-wrapper" style="border:none;border-radius:0;">
    <table class="data-table">
      <thead><tr><th>Kdy</th><th>Platforma</th><th class="hide-mobile">Spuštění</th><th>Stav</th><th class="hide-mobile">Okno</th><th class="num mobil">Řádků</th><th class="num hide-mobile">Pokus</th><th>Chyba</th></tr></thead>
      <tbody>
        <% if (!behy.length) { %><tr><td colspan="8"><div class="prazdno"><strong>Zatím žádný běh</strong>Statistiky se stahují každou noc z aktivních platforem.</div></td></tr><% } %>
        <% behy.forEach(b => { %>
        <tr>
          <td class="mono sekundarni"><%= kdy(b.started_at) %></td>
          <td style="white-space:nowrap;"><%= platformaBehu[b.platform] || b.platform %></td>
          <td class="sekundarni hide-mobile"><%= b.kind === 'auto' ? 'automat' : 'ručně' + (b.spustil ? ' · ' + b.spustil : '') %></td>
          <td><span class="badge badge-<%= stavTon[b.status] || 'neutral' %>"><%= stavText[b.status] || b.status %><%= b.permanent ? ' (trvalá)' : '' %></span></td>
          <td class="mono sekundarni hide-mobile"><%= okno(b) %></td>
          <td class="num mobil"><%= Number(b.rows_saved).toLocaleString('cs-CZ') %></td>
          <td class="num sekundarni hide-mobile"><%= b.attempt %></td>
          <td class="sekundarni"><% if (b.error) { %><span class="radek-text pole-varovani" title="<%= b.error %>"><%= b.error %></span><% } %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../../includes/strankovani', { strany }) %>
</div>
<% } %>
