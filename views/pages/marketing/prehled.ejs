<%
  // Marketingový přehled e-shopu: čísla skládá src/marketing/prehled.js,
  // definice KPI jsou v hlavičce src/marketing/kpi.js. Každá dlaždice nese
  // v kpi-formula svou definici, ať nikdo nehádá, co číslo znamená.
  const kc   = v => v == null ? '–' : Number(v).toLocaleString('cs-CZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Kč';
  const cele = v => v == null ? '–' : Math.round(Number(v)).toLocaleString('cs-CZ');
  const pct  = (v, d = 1) => v == null ? '–' : Number(v).toLocaleString('cs-CZ', { minimumFractionDigits: d, maximumFractionDigits: d }) + ' %';
  const des  = (v, d = 2) => v == null ? '–' : Number(v).toLocaleString('cs-CZ', { minimumFractionDigits: d, maximumFractionDigits: d });
  const stavText = p => !p ? '' : p.rozdilPct == null ? 'Seil 0' : (p.rozdilPct > 0 ? '+' : '') + des(p.rozdilPct, 1) + ' %';
  const can = k => (user && typeof user.can === 'function') ? user.can(k) : true;
  const vidiNaklady = can('marketing.naklady');
  const vidiSync = can('marketing.sync');
  const vidiNastaveni = can('nastaveni.eshopy');
  const p = prehled;
%>

<div class="page-header">
  <div class="page-header-left">
    <h1>Marketing</h1>
    <p><%= shop ? shop.name + ' · ' : '' %><%= obdobi.popis %></p>
  </div>
  <% if (shop && (vidiNaklady || vidiSync || vidiNastaveni)) { %>
  <div class="page-header-akce">
    <% if (vidiNaklady) { %><a href="/marketing/naklady<%- dotaz(shop) %>" class="btn btn-outline btn-sm">Ruční náklady</a><% } %>
    <% if (vidiSync) { %><a href="/marketing/sync<%- dotaz(shop) %>" class="btn btn-outline btn-sm">Synchronizace</a><% } %>
    <% if (vidiNastaveni) { %><a href="/nastaveni/eshopy/<%= shop.id %>?tab=marketing" class="btn btn-outline btn-sm">Nastavení napojení</a><% } %>
  </div>
  <% } %>
</div>

<%- include('../../includes/eshop-prepinac', { eshopy, shop, basePath: '/marketing', qs: dotazPrehledu(null, obdobi, tab).slice(1), vychoziEshop }) %>

<% if (!shop || !p) { %>
<div class="card"><div class="prazdno"><strong>Žádný aktivní e-shop</strong><% if (vidiNastaveni) { %>Založte ho v Nastavení → Eshopy.<% } %></div></div>
<% } else { %>

<!-- Období -->
<form method="get" action="/marketing" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin-bottom:20px;">
  <% if (shop.slug !== vychoziEshop) { %><input type="hidden" name="eshop" value="<%= shop.slug %>"><% } %>
  <% if (tab !== zalozky[0][0]) { %><input type="hidden" name="tab" value="<%= tab %>"><% } %>
  <div class="form-group" style="margin:0;">
    <label class="form-label" for="prehledObdobi">Období</label>
    <select id="prehledObdobi" name="obdobi" class="form-select" onchange="this.form.querySelector('[data-vlastni]').style.display = this.value === 'vlastni' ? 'flex' : 'none'; if (this.value !== 'vlastni') this.form.submit();">
      <option value="tento-mesic" <%= obdobi.preset === 'tento-mesic' ? 'selected' : '' %>>Tento měsíc</option>
      <option value="minuly-mesic" <%= obdobi.preset === 'minuly-mesic' ? 'selected' : '' %>>Minulý měsíc</option>
      <option value="30-dni" <%= obdobi.preset === '30-dni' ? 'selected' : '' %>>Posledních 30 dní</option>
      <option value="vlastni" <%= obdobi.preset === 'vlastni' ? 'selected' : '' %>>Vlastní rozsah</option>
    </select>
  </div>
  <div data-vlastni style="display:<%= obdobi.preset === 'vlastni' ? 'flex' : 'none' %>;gap:10px;align-items:flex-end;flex-wrap:wrap;">
    <div class="form-group" style="margin:0;"><label class="form-label" for="prehledOd">Od</label><input id="prehledOd" type="date" name="od" class="form-control" value="<%= obdobi.od %>"></div>
    <div class="form-group" style="margin:0;"><label class="form-label" for="prehledDo">Do</label><input id="prehledDo" type="date" name="do" class="form-control" value="<%= obdobi.do %>"></div>
    <button type="submit" class="btn btn-primary">Zobrazit</button>
  </div>
  <span class="form-hint" style="padding-bottom:11px;">Data z platforem jsou do včerejška; dnešní den má jen objednávky.</span>
</form>

<% if (p.varovani.length) { %>
<div class="hlaska hlaska-varovani">
  <% p.varovani.forEach(v => { %><div><%= v.text %><% if (v.typ === 'nenastaveno' && vidiNastaveni) { %> <a href="/nastaveni/eshopy/<%= shop.id %>?tab=marketing">Nastavení → Eshopy → Marketing</a>.<% } %></div><% }) %>
</div>
<% } %>

<%- include('../../includes/zalozky', { nazev: 'Sekce přehledu', zalozky, tab, adresa: k => `/marketing${dotazPrehledu(shop, obdobi, k)}` }) %>

<% if (tab === 'prehled') { %>

<!-- KPI -->
<div class="kpi-grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));margin-bottom:24px;">
  <div class="kpi-card">
    <div class="kpi-label">Tržby bez DPH</div>
    <div class="kpi-value positive" style="font-size:20px;"><%= kc(p.trzby.bezDph) %></div>
    <div class="kpi-formula">Σ objednávek / 1,21 · zaplaceno <%= kc(p.trzby.zaplacenoBezDph) %></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Objednávky</div>
    <div class="kpi-value" style="font-size:20px;"><%= cele(p.trzby.pocet) %></div>
    <div class="kpi-formula">bez storen · průměrná <%= kc(p.kpi.prumerna) %> bez DPH</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Náklady na reklamu</div>
    <div class="kpi-value negative" style="font-size:20px;"><%= kc(p.naklady.celkem) %></div>
    <div class="kpi-formula">bez DPH · z API <%= kc(p.naklady.api) %> · ručně <%= kc(p.naklady.rucni) %></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">PNO</div>
    <div class="kpi-value <%= p.kpi.pno == null ? '' : (p.pnoPrekrocen ? 'negative' : 'positive') %>" style="font-size:20px;"><%= pct(p.kpi.pno) %></div>
    <div class="kpi-formula">náklady / tržby bez DPH<%= p.prahPno > 0 ? ' · práh ' + pct(p.prahPno, 0) : '' %></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">ROAS</div>
    <div class="kpi-value" style="font-size:20px;"><%= p.kpi.roas == null ? '–' : des(p.kpi.roas) + '×' %></div>
    <div class="kpi-formula">tržby bez DPH / náklady</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Cena za objednávku</div>
    <div class="kpi-value" style="font-size:20px;"><%= kc(p.kpi.cpa) %></div>
    <div class="kpi-formula">náklady / počet objednávek</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Marže<%= p.marze.maMarzi && p.marze.podilOdhadu > 0 ? ' (odhad ' + pct(p.marze.podilOdhadu * 100, 0) + ')' : '' %></div>
    <div class="kpi-value" style="font-size:20px;"><%= p.marze.maMarzi ? kc(p.marze.marze) : '–' %></div>
    <div class="kpi-formula"><%= p.marze.maMarzi ? 'zboží bez DPH − nákupní cena' + (p.marze.odhadnute > 0 ? '; bez nákupní ceny ' + pct(p.marze.odhadPct, 0) + ' z ceny' : '') : (p.marze.odhadPct > 0 ? 'bez položek' : 'bez nákupních cen a odhadu marže') %></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Zisk po reklamě</div>
    <div class="kpi-value <%= p.kpi.zisk == null ? '' : (p.kpi.zisk >= 0 ? 'positive' : 'negative') %>" style="font-size:20px;"><%= kc(p.kpi.zisk) %></div>
    <div class="kpi-formula">marže − náklady · ROI <%= pct(p.kpi.roi, 0) %></div>
  </div>
</div>

<!-- Graf -->
<div class="card" style="margin-bottom:24px;">
  <div class="card-header">Tržby a náklady po dnech</div>
  <% if (p.graf.dny.length && (p.trzby.pocet > 0 || p.naklady.celkem > 0)) { %>
  <div class="card-body">
    <div style="position:relative;height:320px;"><canvas id="marketing-graf"></canvas></div>
    <script type="application/json" id="marketing-data"><%- JSON.stringify(p.graf).replace(/</g, '\\u003c') %></script>
  </div>
  <% } else { %>
  <div class="prazdno">Za zvolené období nejsou objednávky ani náklady.</div>
  <% } %>
</div>

<!-- Náklady po platformách -->
<div class="card" style="margin-bottom:24px;">
  <div class="card-header">Náklady po platformách</div>
  <div class="table-wrapper" style="border:none;border-radius:0;">
    <table class="data-table" style="min-width:0;">
      <thead><tr><th>Platforma</th><th class="num hide-mobile">Z API</th><th class="num hide-mobile">Ručně</th><th class="num">Celkem</th></tr></thead>
      <tbody>
        <% if (!p.naklady.radky.length) { %>
        <tr><td colspan="4"><div class="prazdno">Žádné náklady<% if (vidiNaklady) { %> – <a href="/marketing/naklady<%- dotaz(shop) %>" style="color:var(--link);">zadat ručně</a><% } %>.</div></td></tr>
        <% } %>
        <% p.naklady.radky.forEach(r => { %>
        <tr><td><%= r.popis %></td><td class="num hide-mobile"><%= r.api > 0 ? kc(r.api) : '–' %></td><td class="num hide-mobile"><%= r.rucni > 0 ? kc(r.rucni) : '–' %></td><td class="num" style="font-weight:600;"><%= kc(r.celkem) %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<% } else if (tab === 'kanaly') { %>

<!-- Kanály -->
<div class="card" style="margin-bottom:24px;">
  <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
    <span>Kanály</span>
    <span class="form-hint" style="font-weight:400;">zdroj objednávky zná <%= pct(p.kanaly.pokrytiAtribuce * 100, 0) %> objednávek · porovnání s platformou: do ±10 % sedí, do ±25 % varování</span>
  </div>
  <div class="table-wrapper" style="border:none;border-radius:0;">
    <table class="data-table">
      <thead><tr><th>Kanál</th><th class="num">Objednávky</th><th class="num">Tržby bez DPH</th><th class="num">Náklady</th><th class="num mobil">PNO</th><th class="num" style="white-space:normal;">Konverze dle platformy</th><th class="num" style="white-space:normal;">Hodnota dle platformy</th><th>Rozdíl</th></tr></thead>
      <tbody>
        <% if (!p.kanaly.radky.length) { %>
        <tr><td colspan="8"><div class="prazdno">Žádné objednávky ani náklady.</div></td></tr>
        <% } %>
        <% p.kanaly.radky.forEach(r => { %>
        <tr>
          <td style="font-weight:600;"><%= r.popis %></td>
          <td class="num"><%= cele(r.pocet) %></td>
          <td class="num"><%= kc(r.trzbyBezDph) %></td>
          <td class="num"><%= r.naklady > 0 ? kc(r.naklady) : '–' %></td>
          <td class="num mobil"><%= pct(r.pno) %></td>
          <td class="num sekundarni"><%= r.platforma ? des(r.platforma.conversions, 1) : '–' %></td>
          <td class="num sekundarni"><%= r.platforma ? kc(r.platforma.conversion_value) : '–' %></td>
          <td>
            <% if (r.porovnaniTrzeb) { %>
              <span class="badge badge-<%= r.porovnaniTrzeb.stav %>" title="hodnota dle platformy proti tržbám Seilu"><%= stavText(r.porovnaniTrzeb) %></span>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:24px;margin-bottom:24px;align-items:start;">

  <!-- Funnel GA4 -->
  <div class="card" style="min-width:0;">
    <div class="card-header">Cesta zákazníka (GA4)</div>
    <% if (!p.ga4.ma) { %>
    <div class="prazdno">Bez dat z GA4 za toto období.</div>
    <% } else { %>
    <div class="table-wrapper" style="border:none;border-radius:0;">
      <table class="data-table" style="min-width:0;">
        <thead><tr><th>Krok</th><th class="num">Počet</th><th class="num">Z předchozího</th><th class="num hide-mobile">Z návštěv</th></tr></thead>
        <tbody>
          <% p.ga4.kroky.forEach(k => { %>
          <tr><td><%= k.nazev %></td><td class="num"><%= cele(k.hodnota) %></td><td class="num sekundarni"><%= pct(k.podil) %></td><td class="num sekundarni hide-mobile"><%= pct(k.podilZNavstev) %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="card-body form-hint">
      Nákupy v GA4 proti objednávkám Seilu (<%= cele(p.trzby.pocet) %>):
      <% if (p.ga4.porovnaniNakupu) { %><span class="badge badge-<%= p.ga4.porovnaniNakupu.stav %>"><%= stavText(p.ga4.porovnaniNakupu) %></span><% } %>
      · GA4 vidí jen návštěvy se souhlasem, Seil všechny objednávky.
    </div>
    <% } %>
  </div>

  <!-- Kanály podle GA4 -->
  <% if (p.ga4.ukazatKanaly) { %>
  <div class="card" style="min-width:0;">
    <div class="card-header">Kanály podle GA4 <span class="form-hint" style="font-weight:400;">– doplněk, kde objednávky zdroj neznají</span></div>
    <div class="table-wrapper" style="border:none;border-radius:0;">
      <table class="data-table" style="min-width:0;">
        <thead><tr><th>Kanál</th><th class="num">Návštěvy</th><th class="num hide-mobile">Nákupy</th><th class="num">Tržby GA4</th></tr></thead>
        <tbody>
          <% p.ga4.kanaly.forEach(k => { %>
          <tr><td><%= k.popis %></td><td class="num"><%= cele(k.sessions) %></td><td class="num hide-mobile"><%= cele(k.purchase) %></td><td class="num"><%= kc(k.purchase_revenue) %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

</div>

<% } else if (tab === 'vyhledavani') { %>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:24px;margin-bottom:24px;align-items:start;">

  <!-- Organika -->
  <div class="card" style="min-width:0;">
    <div class="card-header">Organické vyhledávání (Search Console)</div>
    <% if (!p.organika.celkem.dni) { %>
    <div class="prazdno">Bez dat ze Search Console za toto období (data chodí se zpožděním 2–3 dny).</div>
    <% } else { %>
    <div class="card-body">
      <div class="kpi-grid" style="grid-template-columns:repeat(3,1fr);gap:12px;">
        <div><div class="kpi-label">Kliky</div><div style="font-size:20px;font-weight:700;"><%= cele(p.organika.celkem.clicks) %></div></div>
        <div><div class="kpi-label">Zobrazení</div><div style="font-size:20px;font-weight:700;"><%= cele(p.organika.celkem.impressions) %></div></div>
        <div><div class="kpi-label">Prům. pozice</div><div style="font-size:20px;font-weight:700;"><%= des(p.organika.celkem.pozice, 1) %></div></div>
      </div>
    </div>
    <% if (p.organika.dotazy.length) { %>
    <div class="table-wrapper" style="border:none;border-top:1px solid var(--border);border-radius:0;">
      <table class="data-table" style="min-width:0;">
        <caption class="sekundarni" style="padding:10px 16px;text-align:left;font-weight:600;">Top 10 dotazů podle kliků</caption>
        <thead><tr><th>Dotaz</th><th class="num">Kliky</th><th class="num hide-mobile">Zobrazení</th><th class="num">Pozice</th></tr></thead>
        <tbody>
          <% p.organika.dotazy.slice(0, 10).forEach(d => { %>
          <tr><td><span class="radek-text" title="<%= d.dotaz %>"><%= d.dotaz %></span></td><td class="num"><%= cele(d.clicks) %></td><td class="num hide-mobile"><%= cele(d.impressions) %></td><td class="num"><%= des(d.pozice, 1) %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
    <% } %>
  </div>

  <div style="display:grid;gap:24px;min-width:0;">

    <!-- Merchant -->
    <div class="card">
      <div class="card-header">Merchant Center</div>
      <% if (!p.merchant.dni) { %>
      <div class="prazdno">Bez dat z Merchant Center za toto období.</div>
      <% } else { %>
      <div class="card-body">
        <div class="kpi-grid" style="grid-template-columns:repeat(2,1fr);gap:12px;">
          <div><div class="kpi-label">Kliky</div><div style="font-size:20px;font-weight:700;"><%= cele(p.merchant.clicks) %></div></div>
          <div><div class="kpi-label">Zobrazení</div><div style="font-size:20px;font-weight:700;"><%= cele(p.merchant.impressions) %></div></div>
          <div><div class="kpi-label">Schválené položky</div><div class="pole-uspech" style="font-size:20px;font-weight:700;"><%= cele(p.merchant.approved_items) %></div></div>
          <div><div class="kpi-label">Zamítnuté položky</div><div class="<%= p.merchant.disapproved_items > 0 ? 'pole-varovani' : '' %>" style="font-size:20px;font-weight:700;"><%= cele(p.merchant.disapproved_items) %></div></div>
        </div>
        <div class="form-hint" style="margin-top:8px;">Stav položek k <%= p.merchant.den ? ceskeDatum(p.merchant.den) : '–' %>. Náklady Nákupů jsou v Google Ads.</div>
      </div>
      <% } %>
    </div>

    <!-- E-shop -->
    <div class="card">
      <div class="card-header">Z e-shopu</div>
      <% if (!p.eshop.dni) { %>
      <div class="prazdno">Bez statistik z e-shopu za toto období.</div>
      <% } else { %>
      <div class="card-body">
        <div class="kpi-grid" style="grid-template-columns:repeat(2,1fr);gap:12px;">
          <div><div class="kpi-label">Hledání bez výsledku</div><div style="font-size:20px;font-weight:700;"><%= cele(p.eshop.hledaniBezVysledku) %></div></div>
          <div><div class="kpi-label">Opuštěné košíky</div><div style="font-size:20px;font-weight:700;"><%= cele(p.eshop.kosiky) %></div></div>
          <div style="grid-column:1 / -1;"><div class="kpi-label">Hodnota košíků</div><div style="font-size:20px;font-weight:700;"><%= kc(p.eshop.kosikyHodnota) %></div></div>
        </div>
      </div>
      <% } %>
    </div>

  </div>
</div>

<% } %>
<% } %>
