<%
  // Ruční náklady na reklamu: pro platformy bez napojeného API a za období
  // před napojením. Částka bez DPH se rozpočítá rovnoměrně po dnech období.
  const kc = v => v == null ? '–' : Number(v).toLocaleString('cs-CZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Kč';
  const can = k => (user && typeof user.can === 'function') ? user.can(k) : true;
  const pocet = strany ? strany.celkem : 0;
%>
<div class="page-header">
  <div class="page-header-left">
    <h1><% if (can('marketing.prehled')) { %><a href="/marketing<%- dotaz(shop) %>" style="color:var(--text-muted);text-decoration:none;">Marketing</a><% } else { %><span style="color:var(--text-muted);">Marketing</span><% } %> / Ruční náklady</h1>
    <p><%= shop ? shop.name + ' · ' : '' %><%= pocet ? pocet.toLocaleString('cs-CZ') + ' ' + (pocet === 1 ? 'náklad' : pocet <= 4 ? 'náklady' : 'nákladů') : 'náklady' %> bez DPH za období, které nejsou v API platforem</p>
  </div>
</div>

<%- include('../../includes/eshop-prepinac', { eshopy, shop, basePath: '/marketing/naklady', qs: '', vychoziEshop }) %>

<% if (saved) { %><div class="hlaska hlaska-ok">✓ Uloženo</div><% } %>
<% if (smazano) { %><div class="hlaska hlaska-ok">✓ Náklad smazán</div><% } %>
<% if (error === 'obdobi') { %><div class="hlaska hlaska-chyba">Období musí mít datum od i do ve tvaru RRRR-MM-DD a „od“ nesmí být po „do“.</div><% } %>
<% if (error === 'castka') { %><div class="hlaska hlaska-chyba">Částka musí být číslo od 0 do 10 000 000 Kč.</div><% } %>
<% if (error === 'platforma') { %><div class="hlaska hlaska-chyba">Neznámá platforma.</div><% } %>

<% if (!shop) { %>
<div class="card"><div class="prazdno"><strong>Žádný aktivní e-shop</strong><% if (can('nastaveni.eshopy')) { %>Založte ho v Nastavení → Eshopy.<% } %></div></div>
<% } else { %>

<div class="card" style="margin-bottom:24px;">
  <div class="card-header">Přidat náklad</div>
  <div class="card-body">
    <form method="post" action="/marketing/naklady/vytvorit">
      <input type="hidden" name="eshop" value="<%= shop.slug %>">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(160px,100%),1fr));gap:14px;align-items:end;margin-bottom:14px;">
        <div class="form-group" style="margin:0;">
          <label class="form-label required" for="nakladPlatforma">Platforma</label>
          <select id="nakladPlatforma" name="platform" class="form-select" required>
            <% platformy.forEach(pl => { %><option value="<%= pl %>"><%= platformaPopis[pl] || pl %></option><% }) %>
          </select>
        </div>
        <div class="form-group" style="margin:0;"><label class="form-label required" for="nakladOd">Od</label><input id="nakladOd" type="date" name="date_from" class="form-control" required value="<%= dnes.slice(0, 7) %>-01"></div>
        <div class="form-group" style="margin:0;"><label class="form-label required" for="nakladDo">Do</label><input id="nakladDo" type="date" name="date_to" class="form-control" required value="<%= dnes %>"></div>
        <div class="form-group" style="margin:0;"><label class="form-label required" for="nakladCastka">Částka bez DPH (Kč)</label><input id="nakladCastka" type="number" name="amount" class="form-control" step="0.01" min="0" required placeholder="2000"></div>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end;">
        <div class="form-group" style="margin:0;flex:1 1 240px;min-width:0;"><label class="form-label" for="nakladPoznamka">Poznámka</label><input id="nakladPoznamka" type="text" name="note" class="form-control" maxlength="300" placeholder="kredit Heureka, faktura 2026-10-…"></div>
        <button type="submit" class="btn btn-primary">Přidat</button>
      </div>
    </form>
    <p class="form-hint" style="margin:12px 0 0;">Částka se v přehledu rozpočítá rovnoměrně na dny období. Když má platforma za tytéž dny i data z API, přehled na překryv upozorní – náklad pak smažte, ať se nepočítá dvakrát.</p>
  </div>
</div>

<%# overflow:clip místo hidden z .card: ořeže rohy, ale není to posuvník, takže patička zůstane přilepená k oknu %>
<div class="card" style="overflow:clip;">
  <div class="card-header">Zadané náklady</div>
  <div class="table-wrapper" style="border:none;border-radius:0;">
    <table class="data-table">
      <thead><tr><th>Platforma</th><th>Období</th><th class="num">Částka bez DPH</th><th class="hide-mobile">Poznámka</th><th class="hide-mobile">Zadal</th><th aria-label="Akce"></th></tr></thead>
      <tbody>
        <% if (!naklady.length) { %>
        <tr><td colspan="6"><div class="prazdno"><strong>Zatím žádný ruční náklad</strong>Přidejte první formulářem nahoře.</div></td></tr>
        <% } %>
        <% naklady.forEach(n => { %>
        <tr>
          <td style="font-weight:600;"><%= platformaPopis[n.platform] || n.platform %></td>
          <td class="mono sekundarni"><%= rozsahCesky(n.date_from, n.date_to) %></td>
          <td class="num"><%= kc(n.amount) %></td>
          <td class="sekundarni hide-mobile"><% if (n.note) { %><span class="radek-text" title="<%= n.note %>"><%= n.note %></span><% } else { %>–<% } %></td>
          <td class="sekundarni hide-mobile"><%= n.zadal || '–' %></td>
          <td style="text-align:right;">
            <form method="post" action="/marketing/naklady/<%= n.id %>/smazat" style="display:inline;" onsubmit="return confirm('Smazat náklad?')">
              <input type="hidden" name="eshop" value="<%= shop.slug %>">
              <input type="hidden" name="redirect_to" value="<%= strany.aktualni %>">
              <button type="submit" class="btn btn-ghost btn-sm pole-varovani">Smazat</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../../includes/strankovani', { strany }) %>
</div>
<% } %>
