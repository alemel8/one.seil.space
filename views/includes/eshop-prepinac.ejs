<%
  // Přepínač e-shopů stránek, které jsou vždy jednoho e-shopu (ruční
  // náklady, synchronizace marketingu): tytéž dlaždice jako nad přehledy
  // (eshop-dlazdice.ejs), jen bez celkového přehledu a bez čísel. Ukazuje
  // se jen při dvou a víc e-shopech; e-shop jde do adresy vždy (?eshop=<slug>).
  // Parametry: eshopy (prošlé sVzhledem), shop, basePath, qs (ostatní parametry dotazu).
  const dalsiParametry = typeof qs === 'string' ? qs : '';
  const domena = (url) => { try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return ''; } };
%>
<% if (eshopy && eshopy.length > 1) { %>
<%- include('eshop-dlazdice', { nazev: 'E-shop', polozky: eshopy.map(e => {
  const params = new URLSearchParams(dalsiParametry);
  params.set('eshop', e.slug);
  return {
    href: basePath + '?' + params.toString(),
    aktivni: Boolean(shop && e.id === shop.id),
    eshop: e, nazev: e.name,
    popis: domena(e.url) ? [{ text: domena(e.url) }] : [],
  };
}) }) %>
<% } %>
